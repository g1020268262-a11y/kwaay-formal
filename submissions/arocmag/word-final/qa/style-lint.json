    {
      "para_index": 1,
      "text": "K-Waay\u6279\u6b21\u51c6\u5165\u4e2d\u53c2\u4e0e\u65b9\u4e92\u5f02\u6761\u4ef6\u7684\u5f62\u5f0f\u5316\u5206\u6790",
      "style": "@\u5934\u90e8|\u6807\u9898|\u4e2d\u6587"
    },
    {
      "para_index": 5,
      "text": "\u5173\u952e\u8bcd\uff1aK-Waay\uff1b\u6279\u6b21\u51c6\u5165\uff1b\u6279\u5185\u53c2\u4e0e\u65b9\u4e92\u5f02\u6761\u4ef6\uff1bTamarin\uff1b\u5f62\u5f0f\u5316\u9a8c\u8bc1",
      "style": "@\u5934\u90e8|\u6458\u8981|\u6587\u672c"
    },
    {
      "para_index": 6,
      "text": "\u4e2d\u56fe\u5206\u7c7b\u53f7\uff1a\u5f85\u786e\u8ba4\u3000\u3000\u6587\u732e\u6807\u5fd7\u7801\uff1a\u5f85\u786e\u8ba4\u3000\u3000\u6587\u7ae0\u7f16\u53f7\uff1a\u5f85\u5b9a",
      "style": "@\u5934\u90e8|\u6458\u8981|\u6587\u672c"
    },
    {
      "para_index": 7,
      "text": "Formal Analysis of the Distinct-Party Condition in K-Waay Batch Admission",
      "style": "@\u5934\u90e8|\u6807\u9898|\u82f1\u6587"
    },
    {
      "para_index": 13,
      "text": "\u5f15\u8a00",
      "style": "@\u6b63\u6587|\u6807\u98981"
    },
    {
      "para_index": 20,
      "text": "1) \u5f62\u5f0f\u5316\u523b\u753bBatchReceive \u7684\u6279\u5185\u53c2\u4e0e\u65b9\u4e92\u5f02\u6761\u4ef6\uff0c\u660e\u786e\u533a\u5206\u53c2\u4e0e\u65b9\u3001\u53d1\u9001\u5b9e\u4f8b\u548c\u6d88\u606f\u4e09\u4e2a\u6bd4\u8f83\u7ef4\u5ea6\uff1b",
      "style": "@\u6b63\u6587|\u6bb5\u843d\u6587\u672c"
    },
    {
      "para_index": 21,
      "text": "2) \u5728\u5171\u540c\u4e24\u69fd\u751f\u547d\u5468\u671f\u4e0a\u6784\u9020\u4e09\u79cd\u53d7\u63a7\u6279\u6b21\u51c6\u5165\u6a21\u578b\uff0c\u6bd4\u8f83\u6d88\u606f\u4e92\u5f02\u7ea6\u675f\u4e0e\u53c2\u4e0e\u65b9\u4e92\u5f02\u7ea6\u675f\u7684\u4f5c\u7528\uff0c\u5e76\u4ee5\u53d1\u9001\u6765\u6e90\u5bf9\u5e94\u6027\u548c\u6279\u5185\u6765\u6e90\u5355\u5c04\u6027\u523b\u753b\u4e8b\u4ef6\u7ea7\u5dee\u5f02\uff1b",
      "style": "@\u6b63\u6587|\u6bb5\u843d\u6587\u672c"
    },
    {
      "para_index": 23,
      "text": "K-Waay\u6279\u6b21\u51c6\u5165\u4e0e\u53c2\u4e0e\u65b9\u4e92\u5f02\u95ee\u9898",
      "style": "@\u6b63\u6587|\u6807\u98981"
    },
    {
      "para_index": 24,
      "text": "BatchReceive\u673a\u5236\u4e0e\u6279\u5185\u53c2\u4e0e\u65b9\u4e92\u5f02\u6761\u4ef6",
      "style": "@\u6b63\u6587|\u6807\u98982"
    },
    {
      "para_index": 30,
      "text": "\u6bd4\u8f83\u7ef4\u5ea6\u4e0e\u95ee\u9898\u5b9e\u4f8b",
      "style": "@\u6b63\u6587|\u6807\u98982"
    },
    {
      "para_index": 35,
      "text": "\u8868 1\u3000\u6bd4\u8f83\u7ef4\u5ea6\u4e0e\u6a21\u578b\u6620\u5c04",
      "style": "@\u6b63\u6587|\u56fe\u8868|1\u5217"
    },
    {
      "para_index": 39,
      "text": "\u7814\u7a76\u95ee\u9898",
      "style": "@\u6b63\u6587|\u6807\u98982"
    },
    {
      "para_index": 41,
      "text": "RQ1\uff1a\u79fb\u9664\u6279\u5185\u53c2\u4e0e\u65b9\u4e92\u5f02\u6761\u4ef6\u540e\uff0c\u91cd\u590d\u53c2\u4e0e\u65b9\u6761\u76ee\u80fd\u5426\u8fdb\u5165\u540c\u4e00\u6279\u6b21\u5e76\u4ea7\u751f\u63a5\u53d7\u4e8b\u4ef6\uff1f",
      "style": "@\u6b63\u6587|\u6bb5\u843d\u6587\u672c"
    },
    {
      "para_index": 42,
      "text": "RQ2\uff1a\u4e00\u4e2a\u5339\u914d\u53d1\u9001\u6765\u6e90\u80fd\u5426\u5728\u540c\u4e00\u6279\u6b21\u548c\u63a5\u6536\u65b9\u4e0a\u4e0b\u6587\u4e2d\u5bf9\u5e94\u4e24\u4e2aReceiverAccept \u4e8b\u4ef6\uff1f",
      "style": "@\u6b63\u6587|\u6bb5\u843d\u6587\u672c"
    },
    {
      "para_index": 43,
      "text": "RQ3\uff1a\u6d88\u606f\u4e92\u5f02\u7ea6\u675f\u80fd\u5426\u66ff\u4ee3\u53c2\u4e0e\u65b9\u4e92\u5f02\u6761\u4ef6\uff0c\u8fd8\u662f\u540c\u4e00\u53c2\u4e0e\u65b9\u7684\u4e0d\u540c\u6d88\u606f\u4ecd\u53ef\u540c\u65f6\u83b7\u51c6\u8fdb\u5165\u6279\u6b21\uff1f",
      "style": "@\u6b63\u6587|\u6bb5\u843d\u6587\u672c"
    },
    {
      "para_index": 45,
      "text": "\u6279\u6b21\u51c6\u5165\u7684\u5f62\u5f0f\u5316\u5efa\u6a21",
      "style": "@\u6b63\u6587|\u6807\u98981"
    },
    {
      "para_index": 46,
      "text": "\u5b89\u5168\u76ee\u6807\u4e0e\u653b\u51fb\u8005\u6a21\u578b",
      "style": "@\u6b63\u6587|\u6807\u98982"
    },
    {
      "para_index": 52,
      "text": "Tamarin\u6a21\u578b\u4e0e\u5171\u540c\u751f\u547d\u5468\u671f",
      "style": "@\u6b63\u6587|\u6807\u98982"
    },
    {
