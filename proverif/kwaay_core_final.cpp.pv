(* K-Waay Figure 7 core 的 ProVerif final symbolic model。

   这是 macro-based single source model。普通 ProVerif 不直接理解
   preprocessor directives；请用 scripts/run-proverif-final.sh 调用 cpp -P -D TARGET
   生成普通 .pv 文件后再运行 ProVerif。

   这是 no-batch / single-receive abstraction，不是 full BatchReceive。
   BatchReceive state / slot / lifecycle 由 Tamarin final model 处理。

   本文件统一 baseline、split-KEM component authenticity、optional compromise
   exception 和各个 single-leak experiments。不同 target 共享同一份
   public-channel 协议主体，但 query / leak process 由宏控制。

   target 分为两类：
   - theorem / main targets: BASELINE, COMPONENT, EXCEPTION_CHOICE
   - experiment targets: RECEIVER_EXCEPTION_CLASSIFICATION, LEAK_*

   2026-06-06 修正：receiver-side prekey ownership。
   原文 Figure 7 的 BatchReceive 从本地 sti 展开 (esski, ekski, preki)，
   因此 receiver 接收时使用本地 preki，而不是从网络接受任意 receiver prekey。
   本模型现在区分：
   - receiverPrekeyForSend：sender 侧从 public-channel / server 获取的 B prekey；
   - receiverPrekeyB：receiver B 本地 state 中已有的 prekey。

   不要把 leak / compromise 无条件全部启用。BASELINE 和 COMPONENT 不启用
   leak process。LEAK_* 是 compromise experiments，不是 baseline security
   theorem。

   本文件不证明 computational KIND / UNF-1KMA / IND-1BatchCCA / deniability。

   主干来源优先采用：
   - proverif/kwaay-core-public-channel-exception-choice.pv
   - proverif/kwaay-core-public-channel-splitkem-component.pv
   - proverif/kwaay-core-public-channel-leak-*.pv
   - proverif/kwaay-core-no-batch.pv
*)

type agent.
type sig_sk.
type sig_pk.
type kem_sk.
type kem_pk.
type pk_tuple.
type skem_sender_sk.
type skem_sender_pk.
type skem_receiver_sk.
type skem_receiver_pk.
type ekem_sk.
type ekem_pk.
type kem_ct.
type ekem_ct.
type skem_ct.
type shared_secret.
type sid_t.
type session_key.
type signature.
type prekey_payload.
type sender_prekey_bundle.
type receiver_prekey_bundle.
type message_tuple.
type randomness.
type leak_cmd.

free A: agent.
free B: agent.
free c: channel.

(* EXCEPTION_CHOICE 使用公开命令，让 attacker 可选择触发 0/1/2/3 个
   receiver-side decapsulation secret compromise。 *)
free leakKemSkB: leak_cmd.
free leakEkemSkB: leak_cmd.
free leakReceiverSkB: leak_cmd.

fun spk(sig_sk): sig_pk.
fun payload_sender(skem_sender_pk): prekey_payload.
fun payload_receiver(skem_receiver_pk, ekem_pk): prekey_payload.
fun sign(sig_sk, prekey_payload): signature.

reduc forall ssk: sig_sk, p: prekey_payload;
  verify(spk(ssk), p, sign(ssk, p)) = true.

fun kpk(kem_sk): kem_pk.
fun lkem_enc(kem_pk, randomness): kem_ct.
fun lkem_ss(kem_pk, randomness): shared_secret.

reduc forall ksk: kem_sk, r: randomness;
  lkem_dec(ksk, lkem_enc(kpk(ksk), r)) = lkem_ss(kpk(ksk), r).

fun ekpk(ekem_sk): ekem_pk.
fun ekem_enc(ekem_pk, randomness): ekem_ct.
fun ekem_ss(ekem_pk, randomness): shared_secret.

reduc forall eksk: ekem_sk, r: randomness;
  ekem_dec(eksk, ekem_enc(ekpk(eksk), r)) = ekem_ss(ekpk(eksk), r).

fun pk_skem_sender(skem_sender_sk): skem_sender_pk.
fun pk_skem_receiver(skem_receiver_sk): skem_receiver_pk.
fun skem_enc(skem_sender_sk, skem_receiver_pk, randomness): skem_ct.
fun skem_ss(skem_sender_sk, skem_receiver_pk, randomness): shared_secret.

reduc forall sender_sk: skem_sender_sk,
              receiver_sk: skem_receiver_sk,
              r: randomness;
  skem_dec(receiver_sk,
           pk_skem_sender(sender_sk),
           skem_enc(sender_sk, pk_skem_receiver(receiver_sk), r))
  = skem_ss(sender_sk, pk_skem_receiver(receiver_sk), r).

fun sender_prekey(skem_sender_pk, signature): sender_prekey_bundle.
fun receiver_prekey(skem_receiver_pk, ekem_pk, signature): receiver_prekey_bundle.

reduc forall spk_s: skem_sender_pk, sig: signature;
  get_sender_prekey_pk(sender_prekey(spk_s, sig)) = spk_s.

reduc forall spk_s: skem_sender_pk, sig: signature;
  get_sender_prekey_sig(sender_prekey(spk_s, sig)) = sig.

reduc forall rpk: skem_receiver_pk, epk: ekem_pk, sig: signature;
  get_receiver_prekey_pk(receiver_prekey(rpk, epk, sig)) = rpk.

reduc forall rpk: skem_receiver_pk, epk: ekem_pk, sig: signature;
  get_receiver_prekey_ekpk(receiver_prekey(rpk, epk, sig)) = epk.

reduc forall rpk: skem_receiver_pk, epk: ekem_pk, sig: signature;
  get_receiver_prekey_sig(receiver_prekey(rpk, epk, sig)) = sig.

fun msg(kem_ct, ekem_ct, skem_ct): message_tuple.

reduc forall ctL: kem_ct, ctE: ekem_ct, ctS: skem_ct;
  get_lkem_ct(msg(ctL, ctE, ctS)) = ctL.

reduc forall ctL: kem_ct, ctE: ekem_ct, ctS: skem_ct;
  get_ekem_ct(msg(ctL, ctE, ctS)) = ctE.

reduc forall ctL: kem_ct, ctE: ekem_ct, ctS: skem_ct;
  get_skem_ct(msg(ctL, ctE, ctS)) = ctS.

fun pk(sig_pk, kem_pk): pk_tuple.
fun sid_of(agent, agent, pk_tuple, pk_tuple, sender_prekey_bundle,
           receiver_prekey_bundle, message_tuple): sid_t.

fun kdf(shared_secret, shared_secret, shared_secret, sid_t): session_key.

event InitSender(agent).
event InitReceiver(agent).
event SenderKey(agent, agent, sid_t, session_key).
event ReceiverKey(agent, agent, sid_t, session_key).
event SendDone(agent, agent, sid_t, session_key).
event RecvComputed(agent, agent, sid_t, session_key).
event RecvDone(agent, agent, sid_t, session_key).
event SenderPrekeyVerified(agent, agent, sender_prekey_bundle).
event ReceiverPrekeyVerified(agent, agent, receiver_prekey_bundle).
event ReceiverLocalPrekeyUsed(agent, agent, receiver_prekey_bundle).
event SenderSplitKemComponent(agent, agent, skem_ct, shared_secret).
event SplitKemAccepted(agent, agent, skem_ct, shared_secret).
event CompromiseSigSk(agent).
event CompromiseKemSk(agent).
event CompromiseSenderSkemState(agent).
event CompromiseReceiverSkemState(agent).
event CompromiseReceiverEkemState(agent).
event HonestRun(session_key).

#if defined(BASELINE) || defined(EXCEPTION_CHOICE) || defined(LEAK_SIGSK) || defined(LEAK_SIGSK_A) || defined(LEAK_SIGSK_B) || defined(LEAK_SIGSK_AB) || defined(LEAK_KEMSK) || defined(LEAK_EKEMSK) || defined(LEAK_RSKEMSK) || defined(LEAK_SSKEMSK) || defined(LEAK_KEMSK_EKEMSK) || defined(LEAK_ALL_RECEIVER_SECRETS)
(* executability sanity query，照搬现有 public-channel / leak 实验。 *)
query k: session_key; event(HonestRun(k)).

(* RecvDone ==> SendDone 是 diagnostic query。它用于观察 public-channel
   core 中 full-message exact agreement 的缺口，不是最终认证定理。 *)
query A: agent, B: agent, s: sid_t, k: session_key;
  event(RecvDone(B,A,s,k)) ==> event(SendDone(A,B,s,k)).

(* prekey sanity queries，参数类型沿用旧模型。 *)
query A: agent, B: agent, sp: sender_prekey_bundle, s: sid_t, k: session_key;
  event(RecvDone(B,A,s,k)) ==> event(SenderPrekeyVerified(B,A,sp)).

query A: agent, B: agent, rp: receiver_prekey_bundle, s: sid_t, k: session_key;
  event(RecvDone(B,A,s,k)) ==> event(ReceiverLocalPrekeyUsed(B,A,rp)).

(* sender-side / receiver-side secrecy。LEAK_* target 中保留这些原始 query
   是为了复现实验结果，不表示 baseline theorem。 *)
query A: agent, B: agent, s: sid_t, k: session_key;
  attacker(k) && event(SenderKey(A,B,s,k)) ==> false.

query A: agent, B: agent, s: sid_t, k: session_key;
  attacker(k) && event(ReceiverKey(B,A,s,k)) ==> false.
#endif

#ifdef RECEIVER_EXCEPTION_CLASSIFICATION
(* RECEIVER_EXCEPTION_CLASSIFICATION:
   该 target 用于确认 receiver-side attacker-known key 属于 expected receiver-side bad case。
   这里同时允许 sender_skem_sk 和 receiver_skem_sk compromise。
   预期结果是 SenderKey secrecy 仍成立，ReceiverKey secrecy 失败。
   这不是 key-recovery break，而是 receiver-side unpartnered session / bad-case 分类。 *)
query A: agent, B: agent, s: sid_t, k: session_key;
  attacker(k) && event(SenderKey(A,B,s,k)) ==> false.

query A: agent, B: agent, s: sid_t, k: session_key;
  attacker(k) && event(ReceiverKey(B,A,s,k)) ==> false.
#endif

#ifdef COMPONENT
(* Split-KEM component-level authenticity query，来自 splitkem-component 文件。 *)
query A: agent, B: agent, cts: skem_ct, Ks: shared_secret;
  event(SplitKemAccepted(B,A,cts,Ks))
  ==> event(SenderSplitKemComponent(A,B,cts,Ks)).
#endif

#ifdef EXCEPTION_CHOICE
(* optional compromise classification。它不是 baseline secrecy theorem；
   它用于 bad-case / exception classification。

   注意：这里采用无时间顺序的 compromise explanation。原因是 ProVerif 中
   attacker(k) 表示最终攻击者知识；如果允许泄露进程并发运行，post-session
   compromise 也会让 attacker 最终知道 k。因此这里先分类“哪些 secret 泄露
   足以解释 attacker-known key”，不把它解释成 freshness theorem。
   freshness / before-accept ordering 由 Tamarin 模型处理。 *)

(* Sender-side exception theorem:
   在 optional receiver-side decapsulation compromise model 中，
   如果 attacker 知道 honest sender-side session key，
   则 B 侧三个 decapsulation secrets 必须全部 compromise。
   这个 query 不用于解释 receiver-side unpartnered bad case。 *)
query A: agent, B: agent, s: sid_t, k: session_key;
  attacker(k) && event(SenderKey(A,B,s,k))
  ==> event(CompromiseKemSk(B))
   && event(CompromiseReceiverEkemState(B))
   && event(CompromiseReceiverSkemState(B)).

(* 不加入 receiver-side 三重泄露 exception query。
   receiver-side secrecy false 可能由 sender_skem_sk 或 receiver_skem_sk 单独泄露导致，
   属于 expected receiver-side unpartnered bad case。
   该分类由 RECEIVER_EXCEPTION_CLASSIFICATION、LEAK_RSKEMSK / LEAK_SSKEMSK target 和文档说明。 *)
#endif

(* 协议主体：
   - sender 侧可以从 public-channel / prekey server 获取 claimed receiver prekey；
   - receiver 侧按照 K-Waay BatchReceive 语义使用本地 sti 中的 receiverPrekeyB；
   - receiver 不再从网络接受任意 receiver prekey 作为自己的 preki。 *)
let ProtocolRun(
    sskA: sig_sk, kskA: kem_sk,
    sskB: sig_sk, kskB: kem_sk,
    senderSkA: skem_sender_sk,
    receiverSkB: skem_receiver_sk,
    ekskB: ekem_sk
  ) =
  let spkA = spk(sskA) in
  let kpkA = kpk(kskA) in
  let pkA = pk(spkA, kpkA) in

  let spkB = spk(sskB) in
  let kpkB = kpk(kskB) in
  let pkB = pk(spkB, kpkB) in

  out(c, spkA);
  out(c, kpkA);
  out(c, pkA);
  out(c, spkB);
  out(c, kpkB);
  out(c, pkB);

  let senderPkA = pk_skem_sender(senderSkA) in
  let senderPayloadA = payload_sender(senderPkA) in
  let senderSigA = sign(sskA, senderPayloadA) in
  let senderPrekeyA = sender_prekey(senderPkA, senderSigA) in
  out(c, senderPrekeyA);

  let receiverPkB = pk_skem_receiver(receiverSkB) in
  let ekpkB = ekpk(ekskB) in
  let receiverPayloadB = payload_receiver(receiverPkB, ekpkB) in
  let receiverSigB = sign(sskB, receiverPayloadB) in
  let receiverPrekeyB = receiver_prekey(receiverPkB, ekpkB, receiverSigB) in
  out(c, receiverPrekeyB);

  (* Send: A obtains B's claimed receiver prekey from the server / public channel. *)
  in(c, receiverPrekeyForSend: receiver_prekey_bundle);
  let receiverPkForSend = get_receiver_prekey_pk(receiverPrekeyForSend) in
  let ekpkForSend = get_receiver_prekey_ekpk(receiverPrekeyForSend) in
  let receiverSigForSend = get_receiver_prekey_sig(receiverPrekeyForSend) in
  let receiverPayloadForSend = payload_receiver(receiverPkForSend, ekpkForSend) in
  let (=true) = verify(spkB, receiverPayloadForSend, receiverSigForSend) in
  event ReceiverPrekeyVerified(A, B, receiverPrekeyForSend);

  (* BatchReceive input contains the claimed sender prekey, not receiver's own prekey. *)
  in(c, senderPrekeyFromNet: sender_prekey_bundle);
  let senderPkFromNet = get_sender_prekey_pk(senderPrekeyFromNet) in
  let senderSigFromNet = get_sender_prekey_sig(senderPrekeyFromNet) in
  let senderPayloadFromNet = payload_sender(senderPkFromNet) in
  let (=true) = verify(spkA, senderPayloadFromNet, senderSigFromNet) in
  event SenderPrekeyVerified(B, A, senderPrekeyFromNet);

  new rL: randomness;
  new rE: randomness;
  new rS: randomness;

  let ctL = lkem_enc(kpkB, rL) in
  let KL = lkem_ss(kpkB, rL) in

  let ctE = ekem_enc(ekpkForSend, rE) in
  let KE = ekem_ss(ekpkForSend, rE) in

  let ctS = skem_enc(senderSkA, receiverPkForSend, rS) in
  let KS = skem_ss(senderSkA, receiverPkForSend, rS) in
  event SenderSplitKemComponent(A, B, ctS, KS);

  let m = msg(ctL, ctE, ctS) in
  out(c, m);
  let sidAB = sid_of(A, B, pkA, pkB, senderPrekeyA, receiverPrekeyForSend, m) in

  let kSend = kdf(KL, KE, KS, sidAB) in
  event SenderKey(A, B, sidAB, kSend);
  event SendDone(A, B, sidAB, kSend);

  in(c, mFromNet: message_tuple);
  let ctLFromNet = get_lkem_ct(mFromNet) in
  let ctEFromNet = get_ekem_ct(mFromNet) in
  let ctSFromNet = get_skem_ct(mFromNet) in

  (* Receive: B uses local receiver state/prekey from sti. *)
  event ReceiverLocalPrekeyUsed(B, A, receiverPrekeyB);
  let KL2 = lkem_dec(kskB, ctLFromNet) in
  let KE2 = ekem_dec(ekskB, ctEFromNet) in
  let KS2 = skem_dec(receiverSkB, senderPkFromNet, ctSFromNet) in
  event SplitKemAccepted(B, A, ctSFromNet, KS2);

  let sidBA = sid_of(A, B, pkA, pkB, senderPrekeyFromNet, receiverPrekeyB, mFromNet) in
  let kRecv = kdf(KL2, KE2, KS2, sidBA) in
  event RecvComputed(B, A, sidBA, kRecv);
  event ReceiverKey(B, A, sidBA, kRecv);
  event RecvDone(B, A, sidBA, kRecv);

  event HonestRun(kRecv);
  0.

let LeakSigSkA(sskA: sig_sk) =
  event CompromiseSigSk(A);
  out(c, sskA);
  0.

let LeakSigSkB(sskB: sig_sk) =
  event CompromiseSigSk(B);
  out(c, sskB);
  0.

let LeakSigSkAB(sskA: sig_sk, sskB: sig_sk) =
  (
    event CompromiseSigSk(A);
    out(c, sskA)
  )
  |
  (
    event CompromiseSigSk(B);
    out(c, sskB)
  ).

let LeakKemSk(kskB: kem_sk) =
  event CompromiseKemSk(B);
  out(c, kskB);
  0.

let LeakReceiverEkemState(ekskB: ekem_sk) =
  event CompromiseReceiverEkemState(B);
  out(c, ekskB);
  0.

let LeakReceiverSkemState(receiverSkB: skem_receiver_sk) =
  event CompromiseReceiverSkemState(B);
  out(c, receiverSkB);
  0.

let LeakSenderSkemState(senderSkA: skem_sender_sk) =
  event CompromiseSenderSkemState(A);
  out(c, senderSkA);
  0.

let LeakKemSkAndEkemState(kskB: kem_sk, ekskB: ekem_sk) =
  (
    event CompromiseKemSk(B);
    out(c, kskB)
  )
  |
  (
    event CompromiseReceiverEkemState(B);
    out(c, ekskB)
  ).

let LeakAllReceiverSecrets(
    kskB: kem_sk,
    ekskB: ekem_sk,
    receiverSkB: skem_receiver_sk
  ) =
  (
    event CompromiseKemSk(B);
    out(c, kskB)
  )
  |
  (
    event CompromiseReceiverEkemState(B);
    out(c, ekskB)
  )
  |
  (
    event CompromiseReceiverSkemState(B);
    out(c, receiverSkB)
  ).

let ExceptionChoiceLeaks(
    kskB: kem_sk,
    ekskB: ekem_sk,
    receiverSkB: skem_receiver_sk
  ) =
  (
    in(c, (=leakKemSkB));
    event CompromiseKemSk(B);
    out(c, kskB)
  )
  |
  (
    in(c, (=leakEkemSkB));
    event CompromiseReceiverEkemState(B);
    out(c, ekskB)
  )
  |
  (
    in(c, (=leakReceiverSkB));
    event CompromiseReceiverSkemState(B);
    out(c, receiverSkB)
  ).

process
  new sskA: sig_sk;
  new kskA: kem_sk;
  new sskB: sig_sk;
  new kskB: kem_sk;

  new senderSkA: skem_sender_sk;
  new receiverSkB: skem_receiver_sk;
  new ekskB: ekem_sk;

  (
    ! ProtocolRun(sskA, kskA, sskB, kskB, senderSkA, receiverSkB, ekskB)
  )
#ifdef EXCEPTION_CHOICE
  | ExceptionChoiceLeaks(kskB, ekskB, receiverSkB)
#endif
#ifdef RECEIVER_EXCEPTION_CLASSIFICATION
  | LeakReceiverSkemState(receiverSkB)
  | LeakSenderSkemState(senderSkA)
#endif
#ifdef LEAK_SIGSK
  (* Backward-compatible alias: leaks both A and B signature keys. Prefer LEAK_SIGSK_A / LEAK_SIGSK_B / LEAK_SIGSK_AB in new experiments. *)
  | LeakSigSkAB(sskA, sskB)
#endif
#ifdef LEAK_SIGSK_A
  | LeakSigSkA(sskA)
#endif
#ifdef LEAK_SIGSK_B
  | LeakSigSkB(sskB)
#endif
#ifdef LEAK_SIGSK_AB
  | LeakSigSkAB(sskA, sskB)
#endif
#ifdef LEAK_KEMSK
  | LeakKemSk(kskB)
#endif
#ifdef LEAK_EKEMSK
  | LeakReceiverEkemState(ekskB)
#endif
#ifdef LEAK_RSKEMSK
  | LeakReceiverSkemState(receiverSkB)
#endif
#ifdef LEAK_SSKEMSK
  | LeakSenderSkemState(senderSkA)
#endif
#ifdef LEAK_KEMSK_EKEMSK
  | LeakKemSkAndEkemState(kskB, ekskB)
#endif
#ifdef LEAK_ALL_RECEIVER_SECRETS
  | LeakAllReceiverSecrets(kskB, ekskB, receiverSkB)
#endif
