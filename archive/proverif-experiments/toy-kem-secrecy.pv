(* 实验模型，不是 baseline model。
   玩具 KEM secrecy 模型，用于最小化检查 attacker(ss0)。
   不是 K-Waay Figure 7 core。 *)

type skey.
type pkey.
type sskey.
type ciphertext.

free c: channel.
free ss0: sskey [private].

fun pk(skey): pkey.
fun encap(pkey, sskey): ciphertext.

reduc forall sk: skey, ss: sskey;
  decap(sk, encap(pk(sk), ss)) = ss.

query attacker(ss0).

process
  new skB: skey;
  let pkB = pk(skB) in
  let ct = encap(pkB, ss0) in
  out(c, ct);
  0
