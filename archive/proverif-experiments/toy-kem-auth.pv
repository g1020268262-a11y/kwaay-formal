(* 实验模型，不是 baseline model。
   玩具 KEM authenticity 模型，用于最小化检查 RecvDone ==> SendDone。
   不是 K-Waay Figure 7 core。 *)

type skey.
type pkey.
type sskey.
type ciphertext.

free c: channel.

fun pk(skey): pkey.
fun encap(pkey, sskey): ciphertext.


reduc forall sk: skey, ss: sskey;
  decap(sk, encap(pk(sk), ss)) = ss.

event SendDone(sskey).
event RecvDone(sskey).

query ss: sskey; event(RecvDone(ss)) ==> event(SendDone(ss)).

process
  new skB: skey;
  new ss: sskey;
  let pkB = pk(skB) in
  let ct = encap(pkB, ss) in
  event SendDone(ss);
  out(c, ct);
  in(c, ct2: ciphertext);
  let ss2 = decap(skB, ct2) in
  event RecvDone(ss2);
  0
