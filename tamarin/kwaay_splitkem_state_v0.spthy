theory Kwaay_SplitKem_State_V0
begin

/*
  K-Waay Tamarin V0 skeleton.

  目标：
  1. 建模 split-KEM component 的发送与接收；
  2. 建模 receiver state 的一次性使用；
  3. 建模 receiver/sender state compromise；
  4. 检查 receiver accept 的 component origin；
  5. 为后续 partnered / unpartnered、BatchReceive、receiver-side exception 打基础。

  当前不建模：
  - 完整 KEM；
  - 完整 KDF；
  - 完整签名；
  - 完整 BatchReceive；
  - computational KIND；
  - UNF-1KMA / IND-1BatchCCA computational proof。

  建模原则：
  - cts 被当作 opaque split-KEM component；
  - receiver 不能从 cts 中直接拆出 sender state 或 randomness；
  - ComponentKey 是抽象 decapsulation relation；
  - ReceiverState 是 linear fact，用于表达 state consumption；
  - forged accept 规则只是 compromise 后的抽象 bad-case，不是完整攻击推导。
*/

functions:
  cts/4 [private],
  ks/4 [private]

/*
  生成 receiver state。

  ReceiverState(B,rst) 是 linear fact：
  - receiver accept 会消耗它；
  - 这用于表达 receiver state one-time use。

  !ReceiverPublicState(B,rst) 是 persistent fact：
  - 表示该 receiver state 对应的 public prekey / public component 已经发布；
  - sender 可以用它生成针对该 receiver state 的 split-KEM component。
*/
rule InitReceiverState:
  [ Fr(~rst) ]
  --[ ReceiverStateCreated($B, ~rst) ]->
  [
    ReceiverState($B, ~rst),
    !ReceiverPublicState($B, ~rst)
  ]

/*
  生成 sender state。

  V0 中先把 SenderState 建成 persistent fact。
  后续如果要研究 sender state consumption，可以再把它改成 linear fact。
*/
rule InitSenderState:
  [ Fr(~sst) ]
  --[ SenderStateCreated($A, ~sst) ]->
  [ !SenderState($A, ~sst) ]

/*
  honest sender 生成 split-KEM component。

  cts($A,$B,sst,~r) 是 opaque ciphertext/component；
  ks($A,$B,sst,~r) 是对应 split-KEM shared secret。

  注意：
  - cts 是 private function 生成的 opaque term；
  - receiver 不通过模式匹配拆 cts；
  - receiver 后续通过 !ComponentKey(...) 这个抽象 relation 得到 Ks。
*/
rule SenderCreatesComponent:
  [
    !SenderState($A, sst),
    !ReceiverPublicState($B, rst),
    Fr(~r)
  ]
  --[
    SenderComponent($A, $B, rst, cts($A,$B,sst,~r), ks($A,$B,sst,~r))
  ]->
  [
    Out(<$A, $B, cts($A,$B,sst,~r)>),
    !ComponentKey($A, $B, rst, cts($A,$B,sst,~r), ks($A,$B,sst,~r))
  ]

/*
  honest receiver 接收并接受 split-KEM component。

  receiver 从网络收到 opaque cts_in；
  它不能拆开 cts_in；
  它必须同时拥有 ReceiverState(B,rst)
  并且存在 !ComponentKey(A,B,rst,cts_in,Ks)
  才能接受并得到 Ks。

  ReceiverState(B,rst) 被消费。
*/
rule ReceiverAcceptsComponent:
  [
    In(<$A, $B, cts_in>),
    ReceiverState($B, rst),
    !ComponentKey($A, $B, rst, cts_in, Ks)
  ]
  --[
    UseReceiverState($B, rst),
    ConsumeReceiverState($B, rst),
    ReceiverAcceptsComponent($B, $A, rst, cts_in, Ks)
  ]->
  [
    UsedReceiverState($B, rst)
  ]

/*
  receiver state compromise。

  这里 compromise 不消费 ReceiverState，而是把 ReceiverState 放回去。
  含义：
  - 泄露发生后，协议仍可能继续使用这个 state；
  - compromise action fact 记录泄露时间；
  - !CompromisedReceiverState 用于后续 forged accept bad-case rule。
*/
rule CompromiseReceiverState:
  [ ReceiverState($B, rst) ]
  --[ CompromiseReceiverState($B, rst) ]->
  [
    ReceiverState($B, rst),
    !CompromisedReceiverState($B, rst),
    Out(rst)
  ]

/*
  sender state compromise。

  V0 中 sender state 是 persistent fact。
  泄露后记录 !CompromisedSenderState。
*/
rule CompromiseSenderState:
  [ !SenderState($A, sst) ]
  --[ CompromiseSenderState($A, sst) ]->
  [
    !CompromisedSenderState($A, sst),
    Out(sst)
  ]

/*
  abstract bad-case:
  如果 receiver state 已经泄露，攻击者可以诱导 receiver 接受一个 forged component。

  注意：
  这是抽象规则，用来表达 ProVerif 中 receiver_skem_sk compromise
  导致 receiver-side false 的 bad-case 直觉。

  它不是完整 Dolev-Yao 推导。
*/
rule ForgedAcceptAfterReceiverStateCompromise:
  [
    !CompromisedReceiverState($B, rst),
    ReceiverState($B, rst),
    Fr(~fake_cts),
    Fr(~fake_Ks)
  ]
  --[
    UseReceiverState($B, rst),
    ConsumeReceiverState($B, rst),
    ForgedReceiverAccept($B, $A, rst, ~fake_cts, ~fake_Ks),
    ReceiverAcceptsComponent($B, $A, rst, ~fake_cts, ~fake_Ks)
  ]->
  [
    UsedReceiverState($B, rst)
  ]

/*
  abstract bad-case:
  如果 sender state 已经泄露，攻击者也可以诱导 receiver 接受一个 forged component。

  这对应 ProVerif 中 sender_skem_sk compromise 下：
  sender-side secrecy true
  receiver-side secrecy false

  同样，这只是抽象 bad-case rule，不是完整 Dolev-Yao 推导。
*/
rule ForgedAcceptAfterSenderStateCompromise:
  [
    !CompromisedSenderState($A, sst),
    ReceiverState($B, rst),
    Fr(~r)
  ]
  --[
    UseReceiverState($B, rst),
    ConsumeReceiverState($B, rst),
    ForgedReceiverAccept($B, $A, rst, cts($A,$B,sst,~r), ks($A,$B,sst,~r)),
    ReceiverAcceptsComponent($B, $A, rst, cts($A,$B,sst,~r), ks($A,$B,sst,~r))
  ]->
  [
    UsedReceiverState($B, rst)
  ]

/*
  Lemma 1:
  honest accept trace exists.
*/
lemma executable_honest_accept:
  exists-trace
  "Ex A B rst cts_in Ks #i.
      ReceiverAcceptsComponent(B,A,rst,cts_in,Ks) @ #i"

/*
  Lemma 2:
  同一个 receiver state 不能被消费两次。

  这是 state consumption 的最小检查。
*/
lemma receiver_state_single_use:
  "All B rst #i #j.
      ConsumeReceiverState(B,rst) @ #i
    & ConsumeReceiverState(B,rst) @ #j
    ==> #i = #j"

/*
  Lemma 3:
  如果 receiver 接受了某个 component，
  并且 accept 前没有 receiver state compromise，
  并且 accept 前没有 sender state compromise，
  那么这个 component 必须来自 honest sender component。

  这是 ProVerif 中：
  SplitKemAccepted ==> SenderSplitKemComponent
  的 Tamarin 时间顺序增强版。
*/
lemma component_origin_without_early_compromise:
  "All B A rst cts_in Ks #i.
      ReceiverAcceptsComponent(B,A,rst,cts_in,Ks) @ #i
    & not (Ex #j. CompromiseReceiverState(B,rst) @ #j & #j < #i)
    & not (Ex sst #j. CompromiseSenderState(A,sst) @ #j & #j < #i)
    ==> (Ex #j. SenderComponent(A,B,rst,cts_in,Ks) @ #j & #j < #i)"

/*
  Lemma 4:
  forged receiver accept 只能发生在某种 state compromise 之后。
*/
lemma forged_accept_requires_early_compromise:
  "All B A rst cts_in Ks #i.
      ForgedReceiverAccept(B,A,rst,cts_in,Ks) @ #i
    ==> (
          (Ex #j. CompromiseReceiverState(B,rst) @ #j & #j < #i)
        | (Ex sst #j. CompromiseSenderState(A,sst) @ #j & #j < #i)
        )"

/*
  Lemma 5:
  receiver-state compromise bad-case trace exists.
  用来确认模型中确实能出现 receiver state 泄露后的 forged accept。
*/
lemma executable_receiver_compromise_bad_case:
  exists-trace
  "Ex B A rst cts_in Ks #i.
      ForgedReceiverAccept(B,A,rst,cts_in,Ks) @ #i
    & (Ex #j. CompromiseReceiverState(B,rst) @ #j & #j < #i)"

/*
  Lemma 6:
  sender-state compromise bad-case trace exists.
  用来确认模型中确实能出现 sender state 泄露后的 forged accept。
*/
lemma executable_sender_compromise_bad_case:
  exists-trace
  "Ex B A rst cts_in Ks #i.
      ForgedReceiverAccept(B,A,rst,cts_in,Ks) @ #i
    & (Ex sst #j. CompromiseSenderState(A,sst) @ #j & #j < #i)"

end