theory Kwaay_Replay_Original
begin

functions:
  sender_pk/2 [private],
  receiver_pk/2 [private],
  sender_prekey/2 [private],
  receiver_prekey/2 [private],
  ct_l/4 [private],
  ct_k/4 [private],
  ct_s/5 [private],
  secret_l/4 [private],
  secret_k/4 [private],
  secret_s/5 [private],
  session_id/7 [private],
  session_key/4 [private]

/*
  Dedicated model of duplicate input in the original K-Waay BatchReceive.

  This file keeps a fixed two-slot prefix of the linear-stage lifecycle of V7.
  Two slots are the smallest bounded batch that can expose duplicate input. Its
  deliberate extension is that a sender session now creates the complete
  Figure 7 message m = <ct_l,ct_k,ct_s>, the transcript-bound session id, and
  the final key.  The network may replay that public message into more than
  one slot of the same open batch.  There is intentionally no replay cache,
  duplicate rejection, confirmation MAC, or upper-layer session state.

  ReceiverAccept includes rst in addition to the requested protocol/session
  coordinates.  This makes it possible to state directly that the duplicate
  accepts use one receiver state, rather than inferring that fact only through
  the batch identifier.
*/

/* ---------- principal and prekey state ---------- */

rule InitReceiverState:
  [ Fr(~rst) ]
  --[ ReceiverStateCreated($B, ~rst) ]->
  [
    ReceiverState($B, ~rst),
    !ReceiverPublicState($B, ~rst),
    ReceiverCompromiseToken($B, ~rst)
  ]

rule InitSenderState:
  [ Fr(~sst) ]
  --[ SenderStateCreated($A, ~sst) ]->
  [
    !SenderState($A, ~sst),
    SenderCompromiseToken($A, ~sst)
  ]

/*
  Complete Figure 7 send abstraction.

    m   = <ct_l,ct_k,ct_s>
    sid = session_id(A,B,pkA,pkB,prekeyA,prekeyB,m)
    k   = session_key(K_l,K_k,K_s,sid)

  The three fresh coins make the complete ciphertext tuple unique to this
  sender execution.  HonestSession is persistent because an unchanged public
  message may be delivered repeatedly by the Dolev-Yao network.
*/
rule SenderCreatesMessage:
  let pkA   = sender_pk($A,sst)
      pkB   = receiver_pk($B,rst)
      prekA = sender_prekey($A,sst)
      prekB = receiver_prekey($B,rst)
      ctl    = ct_l($A,$B,rst,~rl)
      ctk    = ct_k($A,$B,rst,~rk)
      cts    = ct_s($A,$B,sst,rst,~rs)
      Kl     = secret_l($A,$B,rst,~rl)
      Kk     = secret_k($A,$B,rst,~rk)
      Ks     = secret_s($A,$B,sst,rst,~rs)
      m      = <ctl,ctk,cts>
      sid    = session_id($A,$B,pkA,pkB,prekA,prekB,m)
      k      = session_key(Kl,Kk,Ks,sid)
  in
  [
    !SenderState($A, sst),
    !ReceiverPublicState($B, rst),
    Fr(~rl),
    Fr(~rk),
    Fr(~rs)
  ]
  --[ SenderSession($A,$B,m,sid,k) ]->
  [
    Out(<$A,$B,m>),
    !HonestSession($A,$B,rst,m,sid,k)
  ]

/* ---------- fixed two-slot BatchReceive lifecycle ---------- */

rule CreateBatch:
  [
    ReceiverState($B, rst),
    Fr(~bid)
  ]
  --[ BatchCreated($B, ~bid, rst) ]->
  [
    OpenStage0($B, ~bid, rst),
    BatchEndToken($B, ~bid, rst),
    BatchCompromiseToken($B, ~bid, rst)
  ]

rule AddSlot1:
  [
    OpenStage0($B,bid,rst),
    In(<$A,$B,m>),
    Fr(~idx)
  ]
  --[
    SlotAdded($B,bid,~idx,$A,m),
    Slot1Added($B,bid,rst,~idx,$A,m)
  ]->
  [
    OpenStage1($B,bid,rst),
    AddedSlot1($B,bid,rst,~idx,$A,m)
  ]

rule AddSlot2:
  [
    OpenStage1($B,bid,rst),
    In(<$A,$B,m>),
    Fr(~idx)
  ]
  --[
    SlotAdded($B,bid,~idx,$A,m),
    Slot2Added($B,bid,rst,~idx,$A,m)
  ]->
  [
    OpenStage2($B,bid,rst),
    AddedSlot2($B,bid,rst,~idx,$A,m)
  ]

rule SealBatch:
  [ OpenStage2($B,bid,rst) ]
  --[ SealBatchEvent($B,bid,rst) ]->
  [ SealedStage0($B,bid,rst) ]

rule ProcessSlot1:
  [
    SealedStage0($B,bid,rst),
    AddedSlot1($B,bid,rst,idx,$A,m),
    !HonestSession($A,$B,rst,m,sid,k)
  ]
  --[
    BatchSlot($B,bid,idx,$A,m),
    ReceiverAccept($B,$A,bid,idx,rst,m,sid,k),
    SlotProcessed($B,bid,idx,$A,m),
    Slot1Done($B,bid,rst)
  ]->
  [
    SealedStage1($B,bid,rst),
    Slot1DoneFact($B,bid,rst)
  ]

rule ProcessSlot2:
  [
    SealedStage1($B,bid,rst),
    AddedSlot2($B,bid,rst,idx,$A,m),
    !HonestSession($A,$B,rst,m,sid,k)
  ]
  --[
    BatchSlot($B,bid,idx,$A,m),
    ReceiverAccept($B,$A,bid,idx,rst,m,sid,k),
    SlotProcessed($B,bid,idx,$A,m),
    Slot2Done($B,bid,rst)
  ]->
  [
    SealedStage2($B,bid,rst),
    Slot2DoneFact($B,bid,rst)
  ]

rule CompleteBatch:
  [
    SealedStage2($B,bid,rst),
    BatchEndToken($B,bid,rst),
    Slot1DoneFact($B,bid,rst),
    Slot2DoneFact($B,bid,rst)
  ]
  --[
    UseBatchEndToken($B,bid,rst),
    BatchComplete($B,bid,rst),
    BatchClosed($B,bid,rst),
    ConsumeReceiverState($B,rst)
  ]->
  [
    ClosedBatch($B,bid,rst),
    UsedReceiverState($B,rst)
  ]

/* V7-style abstract failure paths.  They are not used by replay witnesses. */
rule FailSlot1:
  [
    SealedStage0($B,bid,rst),
    BatchEndToken($B,bid,rst),
    AddedSlot1($B,bid,rst,idx,$A,m)
  ]
  --[
    UseBatchEndToken($B,bid,rst),
    BatchSlotFail($B,bid,idx,$A,rst,m),
    BatchFail($B,bid,rst),
    BatchClosed($B,bid,rst),
    ConsumeReceiverState($B,rst)
  ]->
  [
    ClosedBatch($B,bid,rst),
    UsedReceiverState($B,rst)
  ]

rule FailSlot2:
  [
    SealedStage1($B,bid,rst),
    BatchEndToken($B,bid,rst),
    AddedSlot2($B,bid,rst,idx,$A,m)
  ]
  --[
    UseBatchEndToken($B,bid,rst),
    BatchSlotFail($B,bid,idx,$A,rst,m),
    BatchFail($B,bid,rst),
    BatchClosed($B,bid,rst),
    ConsumeReceiverState($B,rst)
  ]->
  [
    ClosedBatch($B,bid,rst),
    UsedReceiverState($B,rst)
  ]

/* ---------- compromise model retained from V7 ---------- */

rule CompromiseReceiverState:
  [
    ReceiverState($B, rst),
    ReceiverCompromiseToken($B, rst)
  ]
  --[ CompromiseReceiverState($B, rst) ]->
  [
    ReceiverState($B, rst),
    !CompromisedReceiverState($B, rst),
    Out(rst)
  ]

rule CompromiseActiveReceiverState:
  [ BatchCompromiseToken($B, bid, rst) ]
  --[ CompromiseReceiverState($B, rst) ]->
  [
    !CompromisedReceiverState($B, rst),
    Out(rst)
  ]

rule CompromiseSenderState:
  [
    !SenderState($A, sst),
    SenderCompromiseToken($A, sst)
  ]
  --[ CompromiseSenderState($A, sst) ]->
  [
    !CompromisedSenderState($A, sst),
    Out(sst)
  ]

/* ---------- executability and replay lemmas ---------- */

lemma normal_single_accept:
  exists-trace
  "Ex A B m sid k bid idx rst #s #r.
       SenderSession(A,B,m,sid,k) @ #s
     & ReceiverAccept(B,A,bid,idx,rst,m,sid,k) @ #r
     & #s < #r"

lemma normal_batch_complete:
  exists-trace
  "Ex A B m sid k bid idx rst #s #r #c.
       SenderSession(A,B,m,sid,k) @ #s
     & ReceiverAccept(B,A,bid,idx,rst,m,sid,k) @ #r
     & BatchComplete(B,bid,rst) @ #c
     & #s < #r
     & #r < #c"

lemma one_send_two_accepts_exists:
  exists-trace
  "Ex A B m sid k bid idx1 idx2 rst #s #r1 #r2 #c.
       SenderSession(A,B,m,sid,k) @ #s
     & ReceiverAccept(B,A,bid,idx1,rst,m,sid,k) @ #r1
     & ReceiverAccept(B,A,bid,idx2,rst,m,sid,k) @ #r2
     & BatchComplete(B,bid,rst) @ #c
     & not(idx1 = idx2)
     & #s < #r1
     & #s < #r2
     & #r1 < #c
     & #r2 < #c
     & (All #s2. SenderSession(A,B,m,sid,k) @ #s2 ==> #s2 = #s)
     & not (Ex X st #cr. CompromiseReceiverState(X,st) @ #cr)
     & not (Ex X st #cs. CompromiseSenderState(X,st) @ #cs)"

lemma same_message_accepted_at_most_once:
  "All A B m sid k bid idx1 idx2 rst #r1 #r2.
       ReceiverAccept(B,A,bid,idx1,rst,m,sid,k) @ #r1
     & ReceiverAccept(B,A,bid,idx2,rst,m,sid,k) @ #r2
     ==> idx1 = idx2"

lemma full_message_unique_send:
  "All A B m sid k #s1 #s2.
       SenderSession(A,B,m,sid,k) @ #s1
     & SenderSession(A,B,m,sid,k) @ #s2
     ==> #s1 = #s2"

lemma receiver_accept_has_sender:
  "All A B m sid k bid idx rst #r.
       ReceiverAccept(B,A,bid,idx,rst,m,sid,k) @ #r
     ==> Ex #s.
         SenderSession(A,B,m,sid,k) @ #s
       & #s < #r"

/* Direct injective one-send/one-accept correspondence; expected to fail. */
lemma injective_receiver_accept:
  "All A B m sid k bid idx1 idx2 rst #s #r1 #r2.
       SenderSession(A,B,m,sid,k) @ #s
     & ReceiverAccept(B,A,bid,idx1,rst,m,sid,k) @ #r1
     & ReceiverAccept(B,A,bid,idx2,rst,m,sid,k) @ #r2
     ==> #r1 = #r2"

/* ---------- lifecycle and state audit lemmas ---------- */

lemma slot_indices_distinct:
  "All B bid rst idx1 idx2 A1 A2 m1 m2 #i #j.
       Slot1Added(B,bid,rst,idx1,A1,m1) @ #i
     & Slot2Added(B,bid,rst,idx2,A2,m2) @ #j
     ==> not(idx1 = idx2)"

lemma process_requires_slot_added:
  "All B A bid idx rst m sid k #i.
       ReceiverAccept(B,A,bid,idx,rst,m,sid,k) @ #i
     ==> Ex #j. SlotAdded(B,bid,idx,A,m) @ #j & #j < #i"

lemma process_requires_seal:
  "All B A bid idx rst m sid k #i.
       ReceiverAccept(B,A,bid,idx,rst,m,sid,k) @ #i
     ==> Ex #j. SealBatchEvent(B,bid,rst) @ #j & #j < #i"

lemma complete_requires_all_slots_processed:
  "All B bid rst idx A m #i #j.
       BatchComplete(B,bid,rst) @ #i
     & SlotAdded(B,bid,idx,A,m) @ #j
     ==> Ex #p.
         SlotProcessed(B,bid,idx,A,m) @ #p
       & #j < #p
       & #p < #i"

lemma no_add_after_seal:
  "All B bid rst idx A m #i #j.
       SealBatchEvent(B,bid,rst) @ #i
     & SlotAdded(B,bid,idx,A,m) @ #j
     ==> #j < #i"

lemma no_accept_after_close:
  "All B A bid idx rst m sid k #i #j.
       BatchClosed(B,bid,rst) @ #i
     & ReceiverAccept(B,A,bid,idx,rst,m,sid,k) @ #j
     ==> #j < #i"

lemma batch_complete_consumes_state:
  "All B bid rst #i.
       BatchComplete(B,bid,rst) @ #i
     ==> ConsumeReceiverState(B,rst) @ #i"

lemma batch_fail_consumes_state:
  "All B bid rst #i.
       BatchFail(B,bid,rst) @ #i
     ==> ConsumeReceiverState(B,rst) @ #i"

lemma batch_end_token_single_use:
  "All B bid rst #i #j.
       UseBatchEndToken(B,bid,rst) @ #i
     & UseBatchEndToken(B,bid,rst) @ #j
     ==> #i = #j"

lemma receiver_state_single_batch:
  "All B bid1 bid2 rst #i #j.
       BatchCreated(B,bid1,rst) @ #i
     & BatchCreated(B,bid2,rst) @ #j
     ==> #i = #j & bid1 = bid2"

lemma receiver_state_single_batch_end:
  "All B rst #i #j.
       ConsumeReceiverState(B,rst) @ #i
     & ConsumeReceiverState(B,rst) @ #j
     ==> #i = #j"

end
