theory Kwaay_Deniability_Negative_Sender_Secret_Diff
begin

functions:
  pk/2,
  spk/1,
  kpk/1,
  skem_spk/1,
  skem_rpk/1,
  ekpk/1,
  sign/2,
  sender_payload/1,
  receiver_payload/2,
  sender_prekey/2,
  receiver_prekey/3,
  lkem_ct/2,
  ekem_ct/2,
  skem_component/3,
  sender_tag_marker/0,
  simulated_tag_marker/0,
  sid_of/7

/*
  Negative sanity check.

  This is intentionally not K-Waay Figure 7 core. It models a broken extension
  where the public transcript contains a tag bound to sender-only secret
  material. The observational equivalence proof should fail; otherwise the
  deniability framework would be too weak to be meaningful.
*/

rule NegativeSenderSecretTranscript_Diff:
  let
    sigPkA = spk(~sigSkA)
    kemPkA = kpk(~kemSkA)
    pkA = pk(sigPkA, kemPkA)

    sigPkB = spk(~sigSkB)
    kemPkB = kpk(~kemSkB)
    pkB = pk(sigPkB, kemPkB)

    senderPkA = skem_spk(~senderSkA)
    senderPrekeyA = sender_prekey(senderPkA, sign(~sigSkA, sender_payload(senderPkA)))

    receiverPkB = skem_rpk(~receiverSkB)
    receiverEpkB = ekpk(~receiverEskB)
    receiverPrekeyB = receiver_prekey(
      receiverPkB,
      receiverEpkB,
      sign(~sigSkB, receiver_payload(receiverPkB, receiverEpkB))
    )

    realCtL = lkem_ct(kemPkB, ~rhoL)
    realCtK = ekem_ct(receiverEpkB, ~rhoK)
    realCtS = skem_component(senderPkA, receiverPkB, ~rhoS)
    realTag = sender_tag_marker
    realMsg = <realCtL, realCtK, realCtS, realTag>
    realSid = sid_of($A, $B, pkA, pkB, senderPrekeyA, receiverPrekeyB, realMsg)
    realTranscript = <$A, $B, pkA, pkB, senderPrekeyA, receiverPrekeyB, realMsg, realSid>

    fakeCtL = lkem_ct(kemPkB, ~rhoL)
    fakeCtK = ekem_ct(receiverEpkB, ~rhoK)
    fakeCtS = skem_component(senderPkA, receiverPkB, ~rhoS)
    fakeTag = simulated_tag_marker
    fakeMsg = <fakeCtL, fakeCtK, fakeCtS, fakeTag>
    fakeSid = sid_of($A, $B, pkA, pkB, senderPrekeyA, receiverPrekeyB, fakeMsg)
    fakeTranscript = <$A, $B, pkA, pkB, senderPrekeyA, receiverPrekeyB, fakeMsg, fakeSid>
  in
  [
    Fr(~sigSkA),
    Fr(~kemSkA),
    Fr(~senderSkA),
    Fr(~sigSkB),
    Fr(~kemSkB),
    Fr(~receiverSkB),
    Fr(~receiverEskB),
    Fr(~rhoL),
    Fr(~rhoK),
    Fr(~rhoS)
  ]
  --[
    NegativeRealTranscript($A,$B,realTranscript,realSid),
    NegativeSimulatedTranscript($A,$B,fakeTranscript,fakeSid)
  ]->
  [
    Out(pkA),
    Out(pkB),
    Out(senderPrekeyA),
    Out(receiverPrekeyB),
    Out(diff(realTranscript, fakeTranscript)),
    Out(diff(realSid, fakeSid)),
    Out(diff(realTag, fakeTag))
  ]

lemma executable_negative_real_transcript:
  exists-trace
  "Ex A B tr sidv #i.
      NegativeRealTranscript(A,B,tr,sidv) @ #i"

lemma executable_negative_simulated_transcript:
  exists-trace
  "Ex A B tr sidv #i.
      NegativeSimulatedTranscript(A,B,tr,sidv) @ #i"

end
