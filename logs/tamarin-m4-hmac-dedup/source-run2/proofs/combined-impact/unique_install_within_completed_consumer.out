lemma duplicate_batch_has_no_accept_output:
  all-traces
  "∀ B bid rst idx1 A1 idx2 A2 m #d.
    (DuplicateDetected( B, bid, rst, idx1, A1, idx2, A2, m ) @ #d) ⇒
    (¬(∃ aid A idx m2 sid k #r.
        AcceptOutputCreated( aid, B, A, bid, idx, rst, m2, sid, k ) @ #r))"
/*
guarded formula characterizing all counter-examples:
"∃ B bid rst idx1 A1 idx2 A2 m #d.
  (DuplicateDetected( B, bid, rst, idx1, A1, idx2, A2, m ) @ #d)
 ∧
  ∃ aid A idx m2 sid k #r.
   (AcceptOutputCreated( aid, B, A, bid, idx, rst, m2, sid, k ) @ #r)"
*/
by sorry

lemma duplicate_batch_has_no_install:
  all-traces
  "∀ B bid rst idx1 A1 idx2 A2 m #d.
    (DuplicateDetected( B, bid, rst, idx1, A1, idx2, A2, m ) @ #d) ⇒
    (¬(∃ aid h A idx m2 sid k #i.
        (InstallFromAccept( aid, B, h, A, bid, idx, rst, m2, sid, k ) @ #i) ∧
        (InstallSession( B, h, A, sid, k ) @ #i)))"
/*
guarded formula characterizing all counter-examples:
"∃ B bid rst idx1 A1 idx2 A2 m #d.
  (DuplicateDetected( B, bid, rst, idx1, A1, idx2, A2, m ) @ #d)
 ∧
  ∃ aid h A idx m2 sid k #i.
   (InstallFromAccept( aid, B, h, A, bid, idx, rst, m2, sid, k ) @ #i) ∧
   (InstallSession( B, h, A, sid, k ) @ #i)"
*/
by sorry

lemma normal_two_distinct_valid_confirmed_outputs_consumer_complete:
  exists-trace
  "∃ A1 A2 B m1 m2 sid1 sid2 k1 k2 tag1 tag2 bid idx1 idx2 rst aid1 aid2 h1
     h2 #s1 #s2 #p #r1 #r2 #c #i1 #i2 #cc.
    ((((((((((((((((((((((((((((((((ConfirmedSend( A1, B, m1, sid1, k1, tag1
                                    ) @ #s1) ∧
                                   (ConfirmedSend( A2, B, m2, sid2, k2, tag2 ) @ #s2)) ∧
                                  (Neq( m1, m2 ) @ #p)) ∧
                                 (DedupPassed( B, bid, rst, idx1, A1, m1, idx2, A2, m2 ) @ #p)) ∧
                                (HmacValidated( B, A1, bid, idx1, rst, m1, sid1, k1, tag1 ) @ #r1)) ∧
                               (ConfirmedReceiverAccept( B, A1, bid, idx1, rst, m1, sid1, k1, tag1
                                ) @ #r1)) ∧
                              (AcceptOutputCreated( aid1, B, A1, bid, idx1, rst, m1, sid1, k1
                               ) @ #r1)) ∧
                             (HmacValidated( B, A2, bid, idx2, rst, m2, sid2, k2, tag2 ) @ #r2)) ∧
                            (ConfirmedReceiverAccept( B, A2, bid, idx2, rst, m2, sid2, k2, tag2
                             ) @ #r2)) ∧
                           (AcceptOutputCreated( aid2, B, A2, bid, idx2, rst, m2, sid2, k2
                            ) @ #r2)) ∧
                          (BatchComplete( B, bid, rst ) @ #c)) ∧
                         (ConsumerStarted( B, bid, rst ) @ #c)) ∧
                        (InstallFromAccept( aid1, B, h1, A1, bid, idx1, rst, m1, sid1, k1
                         ) @ #i1)) ∧
                       (InstallSession( B, h1, A1, sid1, k1 ) @ #i1)) ∧
                      (InstallFromAccept( aid2, B, h2, A2, bid, idx2, rst, m2, sid2, k2
                       ) @ #i2)) ∧
                     (InstallSession( B, h2, A2, sid2, k2 ) @ #i2)) ∧
                    (ConsumerComplete( B, bid, rst ) @ #cc)) ∧
                   (¬(m1 = m2))) ∧
                  (¬(idx1 = idx2))) ∧
                 (¬(#s1 = #s2))) ∧
                (¬(aid1 = aid2))) ∧
               (¬(h1 = h2))) ∧
              (¬(#i1 = #i2))) ∧
             (#s1 < #p)) ∧
            (#s2 < #p)) ∧
           (#p < #r1)) ∧
          (#r1 < #r2)) ∧
         (#r2 < #c)) ∧
        (#c < #i1)) ∧
       (#i1 < #i2)) ∧
      (#i2 < #cc)) ∧
     (¬(∃ X st #cr. CompromiseReceiverState( X, st ) @ #cr))) ∧
    (¬(∃ X st #cs. CompromiseSenderState( X, st ) @ #cs))"
/*
guarded formula characterizing all satisfying traces:
"∃ A1 A2 B m1 m2 sid1 sid2 k1 k2 tag1 tag2 bid idx1 idx2 rst aid1 aid2 h1
   h2 #s1 #s2 #p #r1 #r2 #c #i1 #i2 #cc.
  (ConfirmedSend( A1, B, m1, sid1, k1, tag1 ) @ #s1) ∧
  (ConfirmedSend( A2, B, m2, sid2, k2, tag2 ) @ #s2) ∧
  (Neq( m1, m2 ) @ #p) ∧
  (DedupPassed( B, bid, rst, idx1, A1, m1, idx2, A2, m2 ) @ #p) ∧
  (HmacValidated( B, A1, bid, idx1, rst, m1, sid1, k1, tag1 ) @ #r1) ∧
  (ConfirmedReceiverAccept( B, A1, bid, idx1, rst, m1, sid1, k1, tag1
   ) @ #r1) ∧
  (AcceptOutputCreated( aid1, B, A1, bid, idx1, rst, m1, sid1, k1
   ) @ #r1) ∧
  (HmacValidated( B, A2, bid, idx2, rst, m2, sid2, k2, tag2 ) @ #r2) ∧
  (ConfirmedReceiverAccept( B, A2, bid, idx2, rst, m2, sid2, k2, tag2
   ) @ #r2) ∧
  (AcceptOutputCreated( aid2, B, A2, bid, idx2, rst, m2, sid2, k2
   ) @ #r2) ∧
  (BatchComplete( B, bid, rst ) @ #c) ∧
  (ConsumerStarted( B, bid, rst ) @ #c) ∧
  (InstallFromAccept( aid1, B, h1, A1, bid, idx1, rst, m1, sid1, k1
   ) @ #i1) ∧
  (InstallSession( B, h1, A1, sid1, k1 ) @ #i1) ∧
  (InstallFromAccept( aid2, B, h2, A2, bid, idx2, rst, m2, sid2, k2
   ) @ #i2) ∧
  (InstallSession( B, h2, A2, sid2, k2 ) @ #i2) ∧
  (ConsumerComplete( B, bid, rst ) @ #cc)
 ∧
  (¬(m1 = m2)) ∧
  (¬(idx1 = idx2)) ∧
  (¬(#s1 = #s2)) ∧
  (¬(aid1 = aid2)) ∧
  (¬(h1 = h2)) ∧
  (¬(#i1 = #i2)) ∧
  (#s1 < #p) ∧
  (#s2 < #p) ∧
  (#p < #r1) ∧
  (#r1 < #r2) ∧
  (#r2 < #c) ∧
  (#c < #i1) ∧
  (#i1 < #i2) ∧
  (#i2 < #cc) ∧
  (∀ X st #cr. (CompromiseReceiverState( X, st ) @ #cr) ⇒ ⊥) ∧
  (∀ X st #cs. (CompromiseSenderState( X, st ) @ #cs) ⇒ ⊥)"
*/
by sorry

lemma no_consumer_after_failed_batch:
  all-traces
  "∀ B bid rst #f #cs.
    ((BatchFail( B, bid, rst ) @ #f) ∧
     (ConsumerStarted( B, bid, rst ) @ #cs)) ⇒
    (⊥)"
/*
guarded formula characterizing all counter-examples:
"∃ B bid rst #f #cs.
  (BatchFail( B, bid, rst ) @ #f) ∧ (ConsumerStarted( B, bid, rst ) @ #cs)"
*/
by sorry

lemma hmac_failure_slot2_after_prior_accept_exists:
  exists-trace
  "∃ A1 A2 B m1 m2 sid1 sid2 k1 k2 tag1 tag2 bad2 bid idx1 idx2 rst aid1
     #s1 #s2 #p #r1 #hf #bf.
    (((((((((((((((((((ConfirmedSend( A1, B, m1, sid1, k1, tag1 ) @ #s1) ∧
                      (ConfirmedSend( A2, B, m2, sid2, k2, tag2 ) @ #s2)) ∧
                     (DedupPassed( B, bid, rst, idx1, A1, m1, idx2, A2, m2 ) @ #p)) ∧
                    (HmacValidated( B, A1, bid, idx1, rst, m1, sid1, k1, tag1 ) @ #r1)) ∧
                   (ConfirmedReceiverAccept( B, A1, bid, idx1, rst, m1, sid1, k1, tag1
                    ) @ #r1)) ∧
                  (AcceptOutputCreated( aid1, B, A1, bid, idx1, rst, m1, sid1, k1
                   ) @ #r1)) ∧
                 (TagMismatch( bad2, tag2 ) @ #hf)) ∧
                (HmacValidationFailed( B, A2, bid, idx2, rst, m2, sid2, k2, bad2, tag2
                 ) @ #hf)) ∧
               (BatchFail( B, bid, rst ) @ #bf)) ∧
              (¬(m1 = m2))) ∧
             (#s1 < #p)) ∧
            (#s2 < #p)) ∧
           (#p < #r1)) ∧
          (#r1 < #hf)) ∧
         (#hf < #bf)) ∧
        (¬(∃ A3 m3 sid3 k3 tag3 #r2.
            ConfirmedReceiverAccept( B, A3, bid, idx2, rst, m3, sid3, k3, tag3
            ) @ #r2))) ∧
       (¬(∃ #c. BatchComplete( B, bid, rst ) @ #c))) ∧
      (¬(∃ #cs. ConsumerStarted( B, bid, rst ) @ #cs))) ∧
     (¬(∃ #cc. ConsumerComplete( B, bid, rst ) @ #cc))) ∧
    (¬(∃ aid h A3 idx3 m3 sid3 k3 #i.
        InstallFromAccept( aid, B, h, A3, bid, idx3, rst, m3, sid3, k3 ) @ #i))"
/*
guarded formula characterizing all satisfying traces:
"∃ A1 A2 B m1 m2 sid1 sid2 k1 k2 tag1 tag2 bad2 bid idx1 idx2 rst aid1
   #s1 #s2 #p #r1 #hf #bf.
