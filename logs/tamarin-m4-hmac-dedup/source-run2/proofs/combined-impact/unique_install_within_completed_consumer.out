  (#s < #r1) ∧
  (#s < #r2) ∧
  (#r1 < #c) ∧
  (#r2 < #c) ∧
  (#c < #i1) ∧
  (#c < #i2) ∧
  (#i1 < #cc) ∧
  (#i2 < #cc)"
*/
by sorry

lemma one_confirmed_send_two_accepts_two_installs_exists:
  exists-trace
  "∃ A B m sid k tag bid idx1 idx2 rst aid1 aid2 h1 h2 #s #r1 #r2 #c #i1
     #i2 #cc.
    (((((((((((((((((((((((((((ConfirmedSend( A, B, m, sid, k, tag ) @ #s) ∧
                              (HmacValidated( B, A, bid, idx1, rst, m, sid, k, tag ) @ #r1)) ∧
                             (ConfirmedReceiverAccept( B, A, bid, idx1, rst, m, sid, k, tag
                              ) @ #r1)) ∧
                            (AcceptOutputCreated( aid1, B, A, bid, idx1, rst, m, sid, k ) @ #r1)) ∧
                           (HmacValidated( B, A, bid, idx2, rst, m, sid, k, tag ) @ #r2)) ∧
                          (ConfirmedReceiverAccept( B, A, bid, idx2, rst, m, sid, k, tag
                           ) @ #r2)) ∧
                         (AcceptOutputCreated( aid2, B, A, bid, idx2, rst, m, sid, k ) @ #r2)) ∧
                        (BatchComplete( B, bid, rst ) @ #c)) ∧
                       (ConsumerStarted( B, bid, rst ) @ #c)) ∧
                      (InstallFromAccept( aid1, B, h1, A, bid, idx1, rst, m, sid, k ) @ #i1)) ∧
                     (InstallSession( B, h1, A, sid, k ) @ #i1)) ∧
                    (InstallFromAccept( aid2, B, h2, A, bid, idx2, rst, m, sid, k ) @ #i2)) ∧
                   (InstallSession( B, h2, A, sid, k ) @ #i2)) ∧
                  (ConsumerComplete( B, bid, rst ) @ #cc)) ∧
                 (¬(idx1 = idx2))) ∧
                (¬(#r1 = #r2))) ∧
               (¬(aid1 = aid2))) ∧
              (¬(h1 = h2))) ∧
             (¬(#i1 = #i2))) ∧
            (#s < #r1)) ∧
           (#r1 < #r2)) ∧
          (#r2 < #c)) ∧
         (#c < #i1)) ∧
        (#i1 < #i2)) ∧
       (#i2 < #cc)) ∧
      (∀ #s2. (ConfirmedSend( A, B, m, sid, k, tag ) @ #s2) ⇒ (#s2 = #s))) ∧
     (¬(∃ X st #cr. CompromiseReceiverState( X, st ) @ #cr))) ∧
    (¬(∃ X st #cs. CompromiseSenderState( X, st ) @ #cs))"
/*
guarded formula characterizing all satisfying traces:
"∃ A B m sid k tag bid idx1 idx2 rst aid1 aid2 h1 h2 #s #r1 #r2 #c #i1
   #i2 #cc.
  (ConfirmedSend( A, B, m, sid, k, tag ) @ #s) ∧
  (HmacValidated( B, A, bid, idx1, rst, m, sid, k, tag ) @ #r1) ∧
  (ConfirmedReceiverAccept( B, A, bid, idx1, rst, m, sid, k, tag ) @ #r1) ∧
  (AcceptOutputCreated( aid1, B, A, bid, idx1, rst, m, sid, k ) @ #r1) ∧
  (HmacValidated( B, A, bid, idx2, rst, m, sid, k, tag ) @ #r2) ∧
  (ConfirmedReceiverAccept( B, A, bid, idx2, rst, m, sid, k, tag ) @ #r2) ∧
  (AcceptOutputCreated( aid2, B, A, bid, idx2, rst, m, sid, k ) @ #r2) ∧
  (BatchComplete( B, bid, rst ) @ #c) ∧
  (ConsumerStarted( B, bid, rst ) @ #c) ∧
  (InstallFromAccept( aid1, B, h1, A, bid, idx1, rst, m, sid, k ) @ #i1) ∧
  (InstallSession( B, h1, A, sid, k ) @ #i1) ∧
  (InstallFromAccept( aid2, B, h2, A, bid, idx2, rst, m, sid, k ) @ #i2) ∧
  (InstallSession( B, h2, A, sid, k ) @ #i2) ∧
  (ConsumerComplete( B, bid, rst ) @ #cc)
 ∧
  (¬(idx1 = idx2)) ∧
  (¬(#r1 = #r2)) ∧
  (¬(aid1 = aid2)) ∧
  (¬(h1 = h2)) ∧
  (¬(#i1 = #i2)) ∧
  (#s < #r1) ∧
  (#r1 < #r2) ∧
  (#r2 < #c) ∧
  (#c < #i1) ∧
  (#i1 < #i2) ∧
  (#i2 < #cc) ∧
  (∀ #s2. (ConfirmedSend( A, B, m, sid, k, tag ) @ #s2) ⇒ #s2 = #s) ∧
  (∀ X st #cr. (CompromiseReceiverState( X, st ) @ #cr) ⇒ ⊥) ∧
  (∀ X st #cs. (CompromiseSenderState( X, st ) @ #cs) ⇒ ⊥)"
*/
by sorry

lemma unique_install_within_completed_consumer:
  all-traces
  "∀ A B m sid k tag bid idx1 idx2 rst aid1 aid2 h1 h2 #s #r1 #r2 #c #i1
     #i2 #cc.
    ((((((((((((((((((((((((ConfirmedSend( A, B, m, sid, k, tag ) @ #s) ∧
                           (HmacValidated( B, A, bid, idx1, rst, m, sid, k, tag ) @ #r1)) ∧
                          (ConfirmedReceiverAccept( B, A, bid, idx1, rst, m, sid, k, tag
                           ) @ #r1)) ∧
                         (AcceptOutputCreated( aid1, B, A, bid, idx1, rst, m, sid, k ) @ #r1)) ∧
                        (HmacValidated( B, A, bid, idx2, rst, m, sid, k, tag ) @ #r2)) ∧
                       (ConfirmedReceiverAccept( B, A, bid, idx2, rst, m, sid, k, tag
                        ) @ #r2)) ∧
                      (AcceptOutputCreated( aid2, B, A, bid, idx2, rst, m, sid, k ) @ #r2)) ∧
                     (BatchComplete( B, bid, rst ) @ #c)) ∧
                    (InstallFromAccept( aid1, B, h1, A, bid, idx1, rst, m, sid, k ) @ #i1)) ∧
                   (InstallSession( B, h1, A, sid, k ) @ #i1)) ∧
                  (InstallFromAccept( aid2, B, h2, A, bid, idx2, rst, m, sid, k ) @ #i2)) ∧
                 (InstallSession( B, h2, A, sid, k ) @ #i2)) ∧
                (ConsumerComplete( B, bid, rst ) @ #cc)) ∧
               (#s < #r1)) ∧
              (#s < #r2)) ∧
             (#r1 < #c)) ∧
            (#r2 < #c)) ∧
           (#c < #i1)) ∧
          (#c < #i2)) ∧
         (#i1 < #cc)) ∧
        (#i2 < #cc)) ∧
       (∀ #s2. (ConfirmedSend( A, B, m, sid, k, tag ) @ #s2) ⇒ (#s2 = #s))) ∧
      (¬(∃ X st #cr. CompromiseReceiverState( X, st ) @ #cr))) ∧
     (¬(∃ X st #cs. CompromiseSenderState( X, st ) @ #cs))) ⇒
    (((#i1 = #i2) ∧ (h1 = h2)) ∧ (aid1 = aid2))"
/*
guarded formula characterizing all counter-examples:
"∃ A B m sid k tag bid idx1 idx2 rst aid1 aid2 h1 h2 #s #r1 #r2 #c #i1
   #i2 #cc.
  (ConfirmedSend( A, B, m, sid, k, tag ) @ #s) ∧
  (HmacValidated( B, A, bid, idx1, rst, m, sid, k, tag ) @ #r1) ∧
  (ConfirmedReceiverAccept( B, A, bid, idx1, rst, m, sid, k, tag ) @ #r1) ∧
  (AcceptOutputCreated( aid1, B, A, bid, idx1, rst, m, sid, k ) @ #r1) ∧
  (HmacValidated( B, A, bid, idx2, rst, m, sid, k, tag ) @ #r2) ∧
  (ConfirmedReceiverAccept( B, A, bid, idx2, rst, m, sid, k, tag ) @ #r2) ∧
  (AcceptOutputCreated( aid2, B, A, bid, idx2, rst, m, sid, k ) @ #r2) ∧
  (BatchComplete( B, bid, rst ) @ #c) ∧
  (InstallFromAccept( aid1, B, h1, A, bid, idx1, rst, m, sid, k ) @ #i1) ∧
  (InstallSession( B, h1, A, sid, k ) @ #i1) ∧
  (InstallFromAccept( aid2, B, h2, A, bid, idx2, rst, m, sid, k ) @ #i2) ∧
  (InstallSession( B, h2, A, sid, k ) @ #i2) ∧
  (ConsumerComplete( B, bid, rst ) @ #cc)
 ∧
  (#s < #r1) ∧
  (#s < #r2) ∧
  (#r1 < #c) ∧
  (#r2 < #c) ∧
  (#c < #i1) ∧
  (#c < #i2) ∧
  (#i1 < #cc) ∧
  (#i2 < #cc) ∧
  (∀ #s2. (ConfirmedSend( A, B, m, sid, k, tag ) @ #s2) ⇒ #s2 = #s) ∧
  (∀ X st #cr. (CompromiseReceiverState( X, st ) @ #cr) ⇒ ⊥) ∧
  (∀ X st #cs. (CompromiseSenderState( X, st ) @ #cs) ⇒ ⊥) ∧
  (((¬(#i1 = #i2)) ∨ (¬(h1 = h2)) ∨ (¬(aid1 = aid2))))"
*/
simplify
solve( (¬(#i1 = #i2))  ∥ (¬(h1.1 = h2.1))  ∥ (¬(aid1.1 = aid2.1)) )
  case case_1
  solve( (#i1 < #i2)  ∥ (#i2 < #i1) )
    case case_1
    solve( !SenderState( $A, sst ) ▶₀ #s )
      case InitSenderState
      solve( !ReceiverPublicState( $B, rst.1 ) ▶₁ #s )
        case InitReceiverState
        solve( SealedStage2( $B, bid, rst ) ▶₀ #c )
          case ProcessSlot2_case_1
          solve( BatchEndToken( $B, ~bid, ~rst ) ▶₁ #c )
            case CreateBatch
            solve( Slot1DoneFact( $B, ~bid, ~rst ) ▶₂ #c )
              case ProcessSlot1
              solve( Slot2DoneFact( $B, ~bid, ~rst ) ▶₃ #c )
                case ProcessSlot2
                solve( ConsumerStage2( $B, ~bid, ~rst, aid1, h1, aid2, h2 ) ▶₀ #cc )
                  case InstallAcceptedOutputSecond_case_1
                  solve( InstalledOutput( ~aid, $B, ~h, $A1, ~bid, idx1, ~rst, m1, sid1, k1
                         ) ▶₁ #cc )
                    case InstallAcceptedOutputFirst
                    solve( InstalledOutput( ~aid.1, $B, ~h2, $A2, ~bid, idx2, ~rst, m2, sid2,
                                            k2
                           ) ▶₂ #cc )
                      case InstallAcceptedOutputSecond
                      solve( HmacValidated( $B, $A, ~bid, idx1, ~rst,
                                            <ct_l($A, $B, ~rst.1, ~rl.2), ct_k($A, $B, ~rst.1, ~rk.2), 
                                             ct_s($A, $B, ~sst.2, ~rst.1, ~rs.2)>,
                                            session_id($A, $B, sender_pk($A, ~sst.2), receiver_pk($B, ~rst.1),
                                                       sender_prekey($A, ~sst.2), receiver_prekey($B, ~rst.1),
                                                       <ct_l($A, $B, ~rst.1, ~rl.2), 
                                                        ct_k($A, $B, ~rst.1, ~rk.2), 
                                                        ct_s($A, $B, ~sst.2, ~rst.1, ~rs.2)>),
                                            session_key(secret_l($A, $B, ~rst.1, ~rl.2),
                                                        secret_k($A, $B, ~rst.1, ~rk.2),
                                                        secret_s($A, $B, ~sst.2, ~rst.1, ~rs.2),
                                                        session_id($A, $B, sender_pk($A, ~sst.2),
                                                                   receiver_pk($B, ~rst.1),
                                                                   sender_prekey($A, ~sst.2),
                                                                   receiver_prekey($B, ~rst.1),
                                                                   <ct_l($A, $B, ~rst.1, ~rl.2), 
                                                                    ct_k($A, $B, ~rst.1, ~rk.2), 
                                                                    ct_s($A, $B, ~sst.2, ~rst.1, ~rs.2)>)),
                                            hmac(confirm_key(session_key(secret_l($A, $B, ~rst.1, ~rl.2),
                                                                         secret_k($A, $B, ~rst.1, ~rk.2),
                                                                         secret_s($A, $B, ~sst.2, ~rst.1,
                                                                                  ~rs.2),
                                                                         session_id($A, $B,
                                                                                    sender_pk($A, ~sst.2),
                                                                                    receiver_pk($B, ~rst.1),
                                                                                    sender_prekey($A, ~sst.2),
                                                                                    receiver_prekey($B,
                                                                                                    ~rst.1),
                                                                                    <
                                                                                     ct_l($A, $B, ~rst.1,
                                                                                          ~rl.2), 
                                                                                     ct_k($A, $B, ~rst.1,
                                                                                          ~rk.2), 
                                                                                     ct_s($A, $B, ~sst.2,
                                                                                          ~rst.1, ~rs.2)
                                                                                    >))),
                                                 session_id($A, $B, sender_pk($A, ~sst.2),
                                                            receiver_pk($B, ~rst.1),
                                                            sender_prekey($A, ~sst.2),
                                                            receiver_prekey($B, ~rst.1),
                                                            <ct_l($A, $B, ~rst.1, ~rl.2), 
                                                             ct_k($A, $B, ~rst.1, ~rk.2), 
                                                             ct_s($A, $B, ~sst.2, ~rst.1, ~rs.2)>))
                             ) @ #r1 )
                        case ProcessSlot1
                        solve( SealedStage0( $B, ~bid, ~rst ) ▶₀ #r1 )
                          case PassDistinctBatch
                          solve( ConfirmedReceiverAccept( $B, $A, ~bid, ~idx.1, ~rst,
                                                          <ct_l($A, $B, ~rst, ~rl.1), 
                                                           ct_k($A, $B, ~rst, ~rk.1), 
                                                           ct_s($A, $B, ~sst.1, ~rst, ~rs.1)>,
                                                          session_id($A, $B, sender_pk($A, ~sst.1),
                                                                     receiver_pk($B, ~rst),
                                                                     sender_prekey($A, ~sst.1),
                                                                     receiver_prekey($B, ~rst),
                                                                     <ct_l($A, $B, ~rst, ~rl.1), 
                                                                      ct_k($A, $B, ~rst, ~rk.1), 
                                                                      ct_s($A, $B, ~sst.1, ~rst, ~rs.1)>),
                                                          session_key(secret_l($A, $B, ~rst, ~rl.1),
                                                                      secret_k($A, $B, ~rst, ~rk.1),
                                                                      secret_s($A, $B, ~sst.1, ~rst, ~rs.1),
                                                                      session_id($A, $B,
                                                                                 sender_pk($A, ~sst.1),
                                                                                 receiver_pk($B, ~rst),
                                                                                 sender_prekey($A, ~sst.1),
                                                                                 receiver_prekey($B, ~rst),
                                                                                 <ct_l($A, $B, ~rst, ~rl.1), 
                                                                                  ct_k($A, $B, ~rst, ~rk.1), 
                                                                                  ct_s($A, $B, ~sst.1, ~rst,
                                                                                       ~rs.1)
                                                                                 >)),
                                                          hmac(confirm_key(session_key(secret_l($A, $B, ~rst,
                                                                                                ~rl.1),
                                                                                       secret_k($A, $B, ~rst,
                                                                                                ~rk.1),
                                                                                       secret_s($A, $B,
                                                                                                ~sst.1, ~rst,
                                                                                                ~rs.1),
                                                                                       session_id($A, $B,
                                                                                                  sender_pk($A,
                                                                                                            ~sst.1),
                                                                                                  receiver_pk($B,
                                                                                                              ~rst),
                                                                                                  sender_prekey($A,
                                                                                                                ~sst.1),
                                                                                                  receiver_prekey($B,
                                                                                                                  ~rst),
                                                                                                  <
                                                                                                   ct_l($A,
                                                                                                        $B,
                                                                                                        ~rst,
                                                                                                        ~rl.1), 
                                                                                                   ct_k($A,
                                                                                                        $B,
                                                                                                        ~rst,
                                                                                                        ~rk.1), 
                                                                                                   ct_s($A,
                                                                                                        $B,
                                                                                                        ~sst.1,
                                                                                                        ~rst,
                                                                                                        ~rs.1)
                                                                                                  >))),
                                                               session_id($A, $B, sender_pk($A, ~sst.1),
                                                                          receiver_pk($B, ~rst),
                                                                          sender_prekey($A, ~sst.1),
                                                                          receiver_prekey($B, ~rst),
                                                                          <ct_l($A, $B, ~rst, ~rl.1), 
                                                                           ct_k($A, $B, ~rst, ~rk.1), 
                                                                           ct_s($A, $B, ~sst.1, ~rst, ~rs.1)
                                                                          >))
                                 ) @ #r1 )
                            case ProcessSlot1
                            solve( AcceptOutputCreated( aid1, $B, $A, ~bid, ~idx.1, ~rst,
                                                        <ct_l($A, $B, ~rst, ~rl.1), 
                                                         ct_k($A, $B, ~rst, ~rk.1), 
                                                         ct_s($A, $B, ~sst.1, ~rst, ~rs.1)>,
                                                        session_id($A, $B, sender_pk($A, ~sst.1),
                                                                   receiver_pk($B, ~rst),
                                                                   sender_prekey($A, ~sst.1),
                                                                   receiver_prekey($B, ~rst),
                                                                   <ct_l($A, $B, ~rst, ~rl.1), 
                                                                    ct_k($A, $B, ~rst, ~rk.1), 
                                                                    ct_s($A, $B, ~sst.1, ~rst, ~rs.1)>),
                                                        session_key(secret_l($A, $B, ~rst, ~rl.1),
                                                                    secret_k($A, $B, ~rst, ~rk.1),
                                                                    secret_s($A, $B, ~sst.1, ~rst, ~rs.1),
                                                                    session_id($A, $B, sender_pk($A, ~sst.1),
                                                                               receiver_pk($B, ~rst),
                                                                               sender_prekey($A, ~sst.1),
                                                                               receiver_prekey($B, ~rst),
                                                                               <ct_l($A, $B, ~rst, ~rl.1), 
                                                                                ct_k($A, $B, ~rst, ~rk.1), 
                                                                                ct_s($A, $B, ~sst.1, ~rst,
                                                                                     ~rs.1)
                                                                               >))
                                   ) @ #r1 )
                              case ProcessSlot1
                              solve( HmacValidated( $B, $A, ~bid, idx2, ~rst,
                                                    <ct_l($A, $B, ~rst, ~rl.1), ct_k($A, $B, ~rst, ~rk.1), 
                                                     ct_s($A, $B, ~sst.1, ~rst, ~rs.1)>,
                                                    session_id($A, $B, sender_pk($A, ~sst.1),
                                                               receiver_pk($B, ~rst),
                                                               sender_prekey($A, ~sst.1),
                                                               receiver_prekey($B, ~rst),
                                                               <ct_l($A, $B, ~rst, ~rl.1), 
                                                                ct_k($A, $B, ~rst, ~rk.1), 
                                                                ct_s($A, $B, ~sst.1, ~rst, ~rs.1)>),
                                                    session_key(secret_l($A, $B, ~rst, ~rl.1),
                                                                secret_k($A, $B, ~rst, ~rk.1),
                                                                secret_s($A, $B, ~sst.1, ~rst, ~rs.1),
                                                                session_id($A, $B, sender_pk($A, ~sst.1),
                                                                           receiver_pk($B, ~rst),
                                                                           sender_prekey($A, ~sst.1),
