   (AcceptOutputCreated( aid, B, A, bid, idx, rst, m, sid, k ) @ #r) ∧
   (ConfirmedReceiverAccept( B, A, bid, idx, rst, m, sid, k, tag ) @ #r) ∧
   (HmacValidated( B, A, bid, idx, rst, m, sid, k, tag ) @ #r)
  ⇒
   ¬(#r < #i)"
*/
by sorry

lemma normal_one_confirmed_accept_one_install:
  exists-trace
  "∃ A B bid idx rst m sid k tag aid h #s #r #c #i #cc.
    ((((((((((ConfirmedSend( A, B, m, sid, k, tag ) @ #s) ∧
             (ConfirmedReceiverAccept( B, A, bid, idx, rst, m, sid, k, tag ) @ #r)) ∧
            (HmacValidated( B, A, bid, idx, rst, m, sid, k, tag ) @ #r)) ∧
           (AcceptOutputCreated( aid, B, A, bid, idx, rst, m, sid, k ) @ #r)) ∧
          (BatchComplete( B, bid, rst ) @ #c)) ∧
         (InstallFromAccept( aid, B, h, A, bid, idx, rst, m, sid, k ) @ #i)) ∧
        (ConsumerComplete( B, bid, rst ) @ #cc)) ∧
       (#s < #r)) ∧
      (#r < #c)) ∧
     (#c < #i)) ∧
    (#i < #cc)"
/*
guarded formula characterizing all satisfying traces:
"∃ A B bid idx rst m sid k tag aid h #s #r #c #i #cc.
  (ConfirmedSend( A, B, m, sid, k, tag ) @ #s) ∧
  (ConfirmedReceiverAccept( B, A, bid, idx, rst, m, sid, k, tag ) @ #r) ∧
  (HmacValidated( B, A, bid, idx, rst, m, sid, k, tag ) @ #r) ∧
  (AcceptOutputCreated( aid, B, A, bid, idx, rst, m, sid, k ) @ #r) ∧
  (BatchComplete( B, bid, rst ) @ #c) ∧
  (InstallFromAccept( aid, B, h, A, bid, idx, rst, m, sid, k ) @ #i) ∧
  (ConsumerComplete( B, bid, rst ) @ #cc)
 ∧
  (#s < #r) ∧ (#r < #c) ∧ (#c < #i) ∧ (#i < #cc)"
*/
by sorry

lemma legacy_same_confirmed_message_consumer_complete_exists:
  exists-trace
  "∃ A B bid idx1 idx2 rst m sid k tag aid1 aid2 h1 h2 #s #r1 #r2 #c #i1
     #i2 #cc.
    (((((((((((((((((((ConfirmedSend( A, B, m, sid, k, tag ) @ #s) ∧
                      (ConfirmedReceiverAccept( B, A, bid, idx1, rst, m, sid, k, tag
                       ) @ #r1)) ∧
                     (AcceptOutputCreated( aid1, B, A, bid, idx1, rst, m, sid, k ) @ #r1)) ∧
                    (ConfirmedReceiverAccept( B, A, bid, idx2, rst, m, sid, k, tag
                     ) @ #r2)) ∧
                   (AcceptOutputCreated( aid2, B, A, bid, idx2, rst, m, sid, k ) @ #r2)) ∧
                  (BatchComplete( B, bid, rst ) @ #c)) ∧
                 (InstallFromAccept( aid1, B, h1, A, bid, idx1, rst, m, sid, k ) @ #i1)) ∧
                (InstallFromAccept( aid2, B, h2, A, bid, idx2, rst, m, sid, k ) @ #i2)) ∧
               (ConsumerComplete( B, bid, rst ) @ #cc)) ∧
              (¬(aid1 = aid2))) ∧
             (¬(h1 = h2))) ∧
            (¬(#i1 = #i2))) ∧
           (#s < #r1)) ∧
          (#s < #r2)) ∧
         (#r1 < #c)) ∧
        (#r2 < #c)) ∧
       (#c < #i1)) ∧
      (#c < #i2)) ∧
     (#i1 < #cc)) ∧
    (#i2 < #cc)"
/*
guarded formula characterizing all satisfying traces:
"∃ A B bid idx1 idx2 rst m sid k tag aid1 aid2 h1 h2 #s #r1 #r2 #c #i1
   #i2 #cc.
  (ConfirmedSend( A, B, m, sid, k, tag ) @ #s) ∧
  (ConfirmedReceiverAccept( B, A, bid, idx1, rst, m, sid, k, tag ) @ #r1) ∧
  (AcceptOutputCreated( aid1, B, A, bid, idx1, rst, m, sid, k ) @ #r1) ∧
  (ConfirmedReceiverAccept( B, A, bid, idx2, rst, m, sid, k, tag ) @ #r2) ∧
  (AcceptOutputCreated( aid2, B, A, bid, idx2, rst, m, sid, k ) @ #r2) ∧
