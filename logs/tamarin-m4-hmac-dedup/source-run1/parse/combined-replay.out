            ) @ #r2)) ∧
          (BatchComplete( B, bid, rst ) @ #c)) ∧
         (¬(m1 = m2))) ∧
        (#s1 < #p)) ∧
       (#s2 < #p)) ∧
      (#p < #r1)) ∧
     (#r1 < #r2)) ∧
    (#r2 < #c)"
