lemma hmac_failure_slot1_exists:
  exists-trace
  "∃ A1 A2 B m1 m2 sid1 sid2 k1 k2 tag1 tag2 bad1 bid idx1 idx2 rst #s1 #s2
     #a1 #a2 #seal #p #hf #bf.
    (((((((((((((ConfirmedSend( A1, B, m1, sid1, k1, tag1 ) @ #s1) ∧
                (ConfirmedSend( A2, B, m2, sid2, k2, tag2 ) @ #s2)) ∧
               (Slot1Added( B, bid, rst, idx1, A1, <m1, bad1> ) @ #a1)) ∧
              (Slot2Added( B, bid, rst, idx2, A2, <m2, tag2> ) @ #a2)) ∧
             (SealBatchEvent( B, bid, rst ) @ #seal)) ∧
            (DedupPassed( B, bid, rst, idx1, A1, m1, idx2, A2, m2 ) @ #p)) ∧
           (TagMismatch( bad1, tag1 ) @ #hf)) ∧
          (HmacValidationFailed( B, A1, bid, idx1, rst, m1, sid1, k1, bad1, tag1
           ) @ #hf)) ∧
         (BatchFail( B, bid, rst ) @ #bf)) ∧
        (¬(m1 = m2))) ∧
       (#seal < #p)) ∧
      (#p < #hf)) ∧
     (#hf < #bf)) ∧
    (¬(∃ A3 m3 sid3 k3 tag3 #r.
        ConfirmedReceiverAccept( B, A3, bid, idx1, rst, m3, sid3, k3, tag3
        ) @ #r))"
/*
guarded formula characterizing all satisfying traces:
"∃ A1 A2 B m1 m2 sid1 sid2 k1 k2 tag1 tag2 bad1 bid idx1 idx2 rst #s1 #s2
   #a1 #a2 #seal #p #hf #bf.
  (ConfirmedSend( A1, B, m1, sid1, k1, tag1 ) @ #s1) ∧
  (ConfirmedSend( A2, B, m2, sid2, k2, tag2 ) @ #s2) ∧
  (Slot1Added( B, bid, rst, idx1, A1, <m1, bad1> ) @ #a1) ∧
  (Slot2Added( B, bid, rst, idx2, A2, <m2, tag2> ) @ #a2) ∧
  (SealBatchEvent( B, bid, rst ) @ #seal) ∧
  (DedupPassed( B, bid, rst, idx1, A1, m1, idx2, A2, m2 ) @ #p) ∧
  (TagMismatch( bad1, tag1 ) @ #hf) ∧
  (HmacValidationFailed( B, A1, bid, idx1, rst, m1, sid1, k1, bad1, tag1
   ) @ #hf) ∧
  (BatchFail( B, bid, rst ) @ #bf)
 ∧
  (¬(m1 = m2)) ∧
  (#seal < #p) ∧
  (#p < #hf) ∧
  (#hf < #bf) ∧
  (∀ A3 m3 sid3 k3 tag3 #r.
    (ConfirmedReceiverAccept( B, A3, bid, idx1, rst, m3, sid3, k3, tag3
     ) @ #r)
   ⇒
    ⊥)"
*/
by sorry

lemma hmac_failure_slot2_after_prior_accept_replay_exists:
  exists-trace
  "∃ A1 A2 B m1 m2 sid1 sid2 k1 k2 tag1 tag2 bad2 bid idx1 idx2 rst #s1 #s2
     #p #r1 #hf #bf.
    ((((((((((((((ConfirmedSend( A1, B, m1, sid1, k1, tag1 ) @ #s1) ∧
                 (ConfirmedSend( A2, B, m2, sid2, k2, tag2 ) @ #s2)) ∧
                (DedupPassed( B, bid, rst, idx1, A1, m1, idx2, A2, m2 ) @ #p)) ∧
               (HmacValidated( B, A1, bid, idx1, rst, m1, sid1, k1, tag1 ) @ #r1)) ∧
              (ConfirmedReceiverAccept( B, A1, bid, idx1, rst, m1, sid1, k1, tag1
               ) @ #r1)) ∧
             (TagMismatch( bad2, tag2 ) @ #hf)) ∧
            (HmacValidationFailed( B, A2, bid, idx2, rst, m2, sid2, k2, bad2, tag2
             ) @ #hf)) ∧
           (BatchFail( B, bid, rst ) @ #bf)) ∧
          (¬(m1 = m2))) ∧
         (#s1 < #p)) ∧
        (#s2 < #p)) ∧
       (#p < #r1)) ∧
      (#r1 < #hf)) ∧
     (#hf < #bf)) ∧
    (¬(∃ #c. BatchComplete( B, bid, rst ) @ #c))"
/*
guarded formula characterizing all satisfying traces:
"∃ A1 A2 B m1 m2 sid1 sid2 k1 k2 tag1 tag2 bad2 bid idx1 idx2 rst #s1 #s2
   #p #r1 #hf #bf.
  (ConfirmedSend( A1, B, m1, sid1, k1, tag1 ) @ #s1) ∧
  (ConfirmedSend( A2, B, m2, sid2, k2, tag2 ) @ #s2) ∧
  (DedupPassed( B, bid, rst, idx1, A1, m1, idx2, A2, m2 ) @ #p) ∧
  (HmacValidated( B, A1, bid, idx1, rst, m1, sid1, k1, tag1 ) @ #r1) ∧
  (ConfirmedReceiverAccept( B, A1, bid, idx1, rst, m1, sid1, k1, tag1
   ) @ #r1) ∧
  (TagMismatch( bad2, tag2 ) @ #hf) ∧
  (HmacValidationFailed( B, A2, bid, idx2, rst, m2, sid2, k2, bad2, tag2
   ) @ #hf) ∧
  (BatchFail( B, bid, rst ) @ #bf)
 ∧
  (¬(m1 = m2)) ∧
  (#s1 < #p) ∧
  (#s2 < #p) ∧
  (#p < #r1) ∧
  (#r1 < #hf) ∧
  (#hf < #bf) ∧
  (∀ #c. (BatchComplete( B, bid, rst ) @ #c) ⇒ ⊥)"
*/
by sorry

lemma hmac_failed_slot_has_no_accept:
  all-traces
  "∀ A1 A2 B bid idx rst m1 m2 sid1 sid2 k1 k2 tag expected tag2 #hf #r.
    ((HmacValidationFailed( B, A1, bid, idx, rst, m1, sid1, k1, tag, expected
      ) @ #hf) ∧
     (ConfirmedReceiverAccept( B, A2, bid, idx, rst, m2, sid2, k2, tag2
      ) @ #r)) ⇒
    (⊥)"
/*
guarded formula characterizing all counter-examples:
"∃ A1 A2 B bid idx rst m1 m2 sid1 sid2 k1 k2 tag expected tag2 #hf #r.
  (HmacValidationFailed( B, A1, bid, idx, rst, m1, sid1, k1, tag, expected
   ) @ #hf) ∧
  (ConfirmedReceiverAccept( B, A2, bid, idx, rst, m2, sid2, k2, tag2
   ) @ #r)"
*/
by sorry

lemma normal_two_distinct_valid_confirmed_accepts_complete:
  exists-trace
  "∃ A1 A2 B m1 m2 sid1 sid2 k1 k2 tag1 tag2 bid idx1 idx2 rst #s1 #s2 #p
     #r1 #r2 #c.
    (((((((((((((((((((ConfirmedSend( A1, B, m1, sid1, k1, tag1 ) @ #s1) ∧
                      (ConfirmedSend( A2, B, m2, sid2, k2, tag2 ) @ #s2)) ∧
                     (Neq( m1, m2 ) @ #p)) ∧
                    (DedupPassed( B, bid, rst, idx1, A1, m1, idx2, A2, m2 ) @ #p)) ∧
                   (HmacValidated( B, A1, bid, idx1, rst, m1, sid1, k1, tag1 ) @ #r1)) ∧
                  (ConfirmedReceiverAccept( B, A1, bid, idx1, rst, m1, sid1, k1, tag1
                   ) @ #r1)) ∧
                 (HmacValidated( B, A2, bid, idx2, rst, m2, sid2, k2, tag2 ) @ #r2)) ∧
                (ConfirmedReceiverAccept( B, A2, bid, idx2, rst, m2, sid2, k2, tag2
                 ) @ #r2)) ∧
               (BatchComplete( B, bid, rst ) @ #c)) ∧
              (¬(m1 = m2))) ∧
             (¬(idx1 = idx2))) ∧
            (¬(#s1 = #s2))) ∧
           (¬(#r1 = #r2))) ∧
          (#s1 < #p)) ∧
         (#s2 < #p)) ∧
        (#p < #r1)) ∧
       (#r1 < #r2)) ∧
      (#r2 < #c)) ∧
     (¬(∃ X st #cr. CompromiseReceiverState( X, st ) @ #cr))) ∧
    (¬(∃ X st #cs. CompromiseSenderState( X, st ) @ #cs))"
/*
guarded formula characterizing all satisfying traces:
"∃ A1 A2 B m1 m2 sid1 sid2 k1 k2 tag1 tag2 bid idx1 idx2 rst #s1 #s2 #p
   #r1 #r2 #c.
  (ConfirmedSend( A1, B, m1, sid1, k1, tag1 ) @ #s1) ∧
  (ConfirmedSend( A2, B, m2, sid2, k2, tag2 ) @ #s2) ∧
  (Neq( m1, m2 ) @ #p) ∧
  (DedupPassed( B, bid, rst, idx1, A1, m1, idx2, A2, m2 ) @ #p) ∧
  (HmacValidated( B, A1, bid, idx1, rst, m1, sid1, k1, tag1 ) @ #r1) ∧
  (ConfirmedReceiverAccept( B, A1, bid, idx1, rst, m1, sid1, k1, tag1
   ) @ #r1) ∧
  (HmacValidated( B, A2, bid, idx2, rst, m2, sid2, k2, tag2 ) @ #r2) ∧
  (ConfirmedReceiverAccept( B, A2, bid, idx2, rst, m2, sid2, k2, tag2
   ) @ #r2) ∧
  (BatchComplete( B, bid, rst ) @ #c)
 ∧
  (¬(m1 = m2)) ∧
  (¬(idx1 = idx2)) ∧
  (¬(#s1 = #s2)) ∧
  (¬(#r1 = #r2)) ∧
  (#s1 < #p) ∧
  (#s2 < #p) ∧
  (#p < #r1) ∧
  (#r1 < #r2) ∧
  (#r2 < #c) ∧
  (∀ X st #cr. (CompromiseReceiverState( X, st ) @ #cr) ⇒ ⊥) ∧
  (∀ X st #cs. (CompromiseSenderState( X, st ) @ #cs) ⇒ ⊥)"
*/
by sorry

end
