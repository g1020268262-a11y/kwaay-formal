lemma process_requires_dedup_pass:
  all-traces
  "∀ B A bid idx rst m sid k tag #r.
    (ConfirmedReceiverAccept( B, A, bid, idx, rst, m, sid, k, tag ) @ #r) ⇒
    (∃ idx1 A1 m1 idx2 A2 m2 #p.
      ((DedupPassed( B, bid, rst, idx1, A1, m1, idx2, A2, m2 ) @ #p) ∧
       (#p < #r)) ∧
      ((((idx = idx1) ∧ (A = A1)) ∧ (m = m1)) ∨
       (((idx = idx2) ∧ (A = A2)) ∧ (m = m2))))"
/*
guarded formula characterizing all counter-examples:
"∃ B A bid idx rst m sid k tag #r.
  (ConfirmedReceiverAccept( B, A, bid, idx, rst, m, sid, k, tag ) @ #r)
 ∧
  ∀ idx1 A1 m1 idx2 A2 m2 #p.
   (DedupPassed( B, bid, rst, idx1, A1, m1, idx2, A2, m2 ) @ #p)
  ⇒
   ((¬(#p < #r)) ∨
    ((((¬(idx = idx1)) ∨ (¬(A = A1)) ∨ (¬(m = m1)))) ∧
     (((¬(idx = idx2)) ∨ (¬(A = A2)) ∨ (¬(m = m2))))))"
*/
by sorry

