  "∃ A1 A2 B m1 m2 tag1 bid idx1 idx2 rst #p #f.
    ((((DedupPassed( B, bid, rst, idx1, A1, m1, idx2, A2, m2 ) @ #p) ∧
       (BatchSlotFail( B, bid, idx1, A1, rst, <m1, tag1> ) @ #f)) ∧
      (BatchFail( B, bid, rst ) @ #f)) ∧
     (¬(m1 = m2))) ∧
    (#p < #f)"
/*
guarded formula characterizing all satisfying traces:
"∃ A1 A2 B m1 m2 tag1 bid idx1 idx2 rst #p #f.
  (DedupPassed( B, bid, rst, idx1, A1, m1, idx2, A2, m2 ) @ #p) ∧
  (BatchSlotFail( B, bid, idx1, A1, rst, <m1, tag1> ) @ #f) ∧
  (BatchFail( B, bid, rst ) @ #f)
 ∧
  (¬(m1 = m2)) ∧ (#p < #f)"
*/
by sorry

lemma normal_distinct_fail_slot2_exists:
  exists-trace
  "∃ A1 A2 B m1 m2 sid1 k1 tag1 tag2 bid idx1 idx2 rst #p #r #f.
    ((((((DedupPassed( B, bid, rst, idx1, A1, m1, idx2, A2, m2 ) @ #p) ∧
         (ConfirmedReceiverAccept( B, A1, bid, idx1, rst, m1, sid1, k1, tag1
          ) @ #r)) ∧
        (BatchSlotFail( B, bid, idx2, A2, rst, <m2, tag2> ) @ #f)) ∧
       (BatchFail( B, bid, rst ) @ #f)) ∧
      (¬(m1 = m2))) ∧
     (#p < #r)) ∧
    (#r < #f)"
/*
guarded formula characterizing all satisfying traces:
