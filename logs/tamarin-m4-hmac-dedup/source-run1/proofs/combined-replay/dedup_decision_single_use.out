lemma dedup_decision_single_use:
  all-traces
  "∀ B bid rst #d1 #d2.
    ((UseDedupDecisionToken( B, bid, rst ) @ #d1) ∧
     (UseDedupDecisionToken( B, bid, rst ) @ #d2)) ⇒
    (#d1 = #d2)"
/*
guarded formula characterizing all counter-examples:
"∃ B bid rst #d1 #d2.
  (UseDedupDecisionToken( B, bid, rst ) @ #d1) ∧
  (UseDedupDecisionToken( B, bid, rst ) @ #d2)
 ∧
  ¬(#d1 = #d2)"
*/
simplify
solve( (#d1 < #d2)  ∥ (#d2 < #d1) )
  case case_1
  solve( UseDedupDecisionToken( B, bid, rst ) @ #d1 )
    case PassDistinctBatch
    solve( DedupPending( $B, bid, rst, idx1, $A1, m1, tag1, idx2, $A2, m2,
                         tag2
           ) ▶₀ #d1 )
      case SealBatch_case_1
      solve( DedupDecisionToken( $B, ~bid, ~rst ) ▶₁ #d1 )
        case SealBatch
        solve( UseDedupDecisionToken( $B, ~bid, ~rst ) @ #d2 )
          case PassDistinctBatch
          solve( DedupPending( $B, ~bid, ~rst, idx1, $A1.1, m1.1, tag1.1, idx2,
                               $A2.1, m2.1, tag2.1
                 ) ▶₀ #d2 )
            case SealBatch
            by contradiction /* cyclic */
          qed
        next
          case RejectDuplicateBatch
          by solve( DedupPending( $B, ~bid, ~rst, idx1, $A1.1, m, tag1.1, idx2,
                                  $A2.1, m, tag2.1
                    ) ▶₀ #d2 )
        qed
      qed
    next
      case SealBatch_case_2
      solve( DedupDecisionToken( $B, ~bid, ~rst ) ▶₁ #d1 )
        case SealBatch
        solve( UseDedupDecisionToken( $B, ~bid, ~rst ) @ #d2 )
          case PassDistinctBatch
          solve( DedupPending( $B, ~bid, ~rst, idx1, $A1.1, m1.1, tag1.1, idx2,
                               $A2.1, m2.1, tag2.1
                 ) ▶₀ #d2 )
            case SealBatch
            by contradiction /* cyclic */
          qed
        next
          case RejectDuplicateBatch
          by solve( DedupPending( $B, ~bid, ~rst, idx1, $A1.1, m, tag1.1, idx2,
                                  $A2.1, m, tag2.1
                    ) ▶₀ #d2 )
        qed
      qed
    qed
  next
    case RejectDuplicateBatch
    solve( DedupPending( $B, bid, rst, idx1, $A1, m, tag1, idx2, $A2, m, tag2
           ) ▶₀ #d1 )
      case SealBatch_case_1
      solve( DedupDecisionToken( $B, ~bid, ~rst ) ▶₁ #d1 )
        case SealBatch
        solve( BatchEndToken( $B, ~bid, ~rst ) ▶₂ #d1 )
          case CreateBatch
          solve( UseDedupDecisionToken( $B, ~bid, ~rst ) @ #d2 )
            case PassDistinctBatch
            by solve( DedupPending( $B, ~bid, ~rst, idx1, $A1.1, m1, tag1.1, idx2,
                                    $A2.1, m2, tag2.1
                      ) ▶₀ #d2 )
          next
            case RejectDuplicateBatch
            solve( DedupPending( $B, ~bid, ~rst, idx1, $A1.1, m.1, tag1.1, idx2,
                                 $A2.1, m.1, tag2.1
                   ) ▶₀ #d2 )
              case SealBatch
              by contradiction /* cyclic */
            qed
          qed
        qed
      qed
    next
      case SealBatch_case_2
      solve( DedupDecisionToken( $B, ~bid, ~rst ) ▶₁ #d1 )
        case SealBatch
        solve( BatchEndToken( $B, ~bid, ~rst ) ▶₂ #d1 )
          case CreateBatch
          solve( UseDedupDecisionToken( $B, ~bid, ~rst ) @ #d2 )
            case PassDistinctBatch
            by solve( DedupPending( $B, ~bid, ~rst, idx1, $A1.1, m1, tag1.1, idx2,
                                    $A2.1, m2, tag2.1
                      ) ▶₀ #d2 )
          next
            case RejectDuplicateBatch
            solve( DedupPending( $B, ~bid, ~rst, idx1, $A1.1, m.1, tag1.1, idx2,
                                 $A2.1, m.1, tag2.1
                   ) ▶₀ #d2 )
              case SealBatch
              by contradiction /* cyclic */
            qed
          qed
        qed
      qed
    qed
  qed
next
  case case_2
  solve( UseDedupDecisionToken( B, bid, rst ) @ #d1 )
    case PassDistinctBatch
    solve( DedupPending( $B, bid, rst, idx1, $A1, m1, tag1, idx2, $A2, m2,
                         tag2
           ) ▶₀ #d1 )
      case SealBatch_case_1
      solve( DedupDecisionToken( $B, ~bid, ~rst ) ▶₁ #d1 )
        case SealBatch
        solve( UseDedupDecisionToken( $B, ~bid, ~rst ) @ #d2 )
          case PassDistinctBatch
          solve( DedupPending( $B, ~bid, ~rst, idx1, $A1.1, m1.1, tag1.1, idx2,
                               $A2.1, m2.1, tag2.1
                 ) ▶₀ #d2 )
            case SealBatch
            by contradiction /* cyclic */
          qed
        next
          case RejectDuplicateBatch
          by solve( DedupPending( $B, ~bid, ~rst, idx1, $A1.1, m, tag1.1, idx2,
                                  $A2.1, m, tag2.1
                    ) ▶₀ #d2 )
        qed
      qed
    next
      case SealBatch_case_2
      solve( DedupDecisionToken( $B, ~bid, ~rst ) ▶₁ #d1 )
        case SealBatch
        solve( UseDedupDecisionToken( $B, ~bid, ~rst ) @ #d2 )
          case PassDistinctBatch
          solve( DedupPending( $B, ~bid, ~rst, idx1, $A1.1, m1.1, tag1.1, idx2,
                               $A2.1, m2.1, tag2.1
                 ) ▶₀ #d2 )
            case SealBatch
            by contradiction /* cyclic */
          qed
        next
          case RejectDuplicateBatch
          by solve( DedupPending( $B, ~bid, ~rst, idx1, $A1.1, m, tag1.1, idx2,
                                  $A2.1, m, tag2.1
                    ) ▶₀ #d2 )
        qed
      qed
    qed
  next
    case RejectDuplicateBatch
    solve( DedupPending( $B, bid, rst, idx1, $A1, m, tag1, idx2, $A2, m, tag2
           ) ▶₀ #d1 )
      case SealBatch_case_1
      solve( DedupDecisionToken( $B, ~bid, ~rst ) ▶₁ #d1 )
        case SealBatch
        solve( BatchEndToken( $B, ~bid, ~rst ) ▶₂ #d1 )
          case CreateBatch
          solve( UseDedupDecisionToken( $B, ~bid, ~rst ) @ #d2 )
            case PassDistinctBatch
            by solve( DedupPending( $B, ~bid, ~rst, idx1, $A1.1, m1, tag1.1, idx2,
                                    $A2.1, m2, tag2.1
                      ) ▶₀ #d2 )
          next
            case RejectDuplicateBatch
            solve( DedupPending( $B, ~bid, ~rst, idx1, $A1.1, m.1, tag1.1, idx2,
                                 $A2.1, m.1, tag2.1
                   ) ▶₀ #d2 )
              case SealBatch
              by contradiction /* cyclic */
            qed
          qed
        qed
      qed
    next
      case SealBatch_case_2
      solve( DedupDecisionToken( $B, ~bid, ~rst ) ▶₁ #d1 )
        case SealBatch
        solve( BatchEndToken( $B, ~bid, ~rst ) ▶₂ #d1 )
          case CreateBatch
          solve( UseDedupDecisionToken( $B, ~bid, ~rst ) @ #d2 )
            case PassDistinctBatch
            by solve( DedupPending( $B, ~bid, ~rst, idx1, $A1.1, m1, tag1.1, idx2,
                                    $A2.1, m2, tag2.1
                      ) ▶₀ #d2 )
          next
            case RejectDuplicateBatch
            solve( DedupPending( $B, ~bid, ~rst, idx1, $A1.1, m.1, tag1.1, idx2,
                                 $A2.1, m.1, tag2.1
                   ) ▶₀ #d2 )
              case SealBatch
              by contradiction /* cyclic */
            qed
          qed
        qed
      qed
    qed
  qed
qed

lemma dedup_outcomes_exclusive:
  all-traces
  "∀ B bid rst idx1 A1 idx2 A2 m pidx1 PA1 pm1 pidx2 PA2 pm2 #d #p.
    ((DuplicateDetected( B, bid, rst, idx1, A1, idx2, A2, m ) @ #d) ∧
     (DedupPassed( B, bid, rst, pidx1, PA1, pm1, pidx2, PA2, pm2 ) @ #p)) ⇒
    (⊥)"
/*
guarded formula characterizing all counter-examples:
"∃ B bid rst idx1 A1 idx2 A2 m pidx1 PA1 pm1 pidx2 PA2 pm2 #d #p.
  (DuplicateDetected( B, bid, rst, idx1, A1, idx2, A2, m ) @ #d) ∧
  (DedupPassed( B, bid, rst, pidx1, PA1, pm1, pidx2, PA2, pm2 ) @ #p)"
*/
by sorry

lemma normal_distinct_batch_complete:
  exists-trace
  "∃ A1 A2 B m1 m2 sid1 sid2 k1 k2 tag1 tag2 bid idx1 idx2 rst #s1 #s2 #p
     #r1 #r2 #c.
    (((((((((((ConfirmedSend( A1, B, m1, sid1, k1, tag1 ) @ #s1) ∧
              (ConfirmedSend( A2, B, m2, sid2, k2, tag2 ) @ #s2)) ∧
             (DedupPassed( B, bid, rst, idx1, A1, m1, idx2, A2, m2 ) @ #p)) ∧
            (ConfirmedReceiverAccept( B, A1, bid, idx1, rst, m1, sid1, k1, tag1
             ) @ #r1)) ∧
           (ConfirmedReceiverAccept( B, A2, bid, idx2, rst, m2, sid2, k2, tag2
            ) @ #r2)) ∧
          (BatchComplete( B, bid, rst ) @ #c)) ∧
         (¬(m1 = m2))) ∧
        (#s1 < #p)) ∧
       (#s2 < #p)) ∧
      (#p < #r1)) ∧
     (#r1 < #r2)) ∧
    (#r2 < #c)"
/*
guarded formula characterizing all satisfying traces:
"∃ A1 A2 B m1 m2 sid1 sid2 k1 k2 tag1 tag2 bid idx1 idx2 rst #s1 #s2 #p
   #r1 #r2 #c.
  (ConfirmedSend( A1, B, m1, sid1, k1, tag1 ) @ #s1) ∧
  (ConfirmedSend( A2, B, m2, sid2, k2, tag2 ) @ #s2) ∧
  (DedupPassed( B, bid, rst, idx1, A1, m1, idx2, A2, m2 ) @ #p) ∧
  (ConfirmedReceiverAccept( B, A1, bid, idx1, rst, m1, sid1, k1, tag1
   ) @ #r1) ∧
  (ConfirmedReceiverAccept( B, A2, bid, idx2, rst, m2, sid2, k2, tag2
   ) @ #r2) ∧
  (BatchComplete( B, bid, rst ) @ #c)
 ∧
  (¬(m1 = m2)) ∧
  (#s1 < #p) ∧
  (#s2 < #p) ∧
  (#p < #r1) ∧
  (#r1 < #r2) ∧
  (#r2 < #c)"
*/
by sorry

