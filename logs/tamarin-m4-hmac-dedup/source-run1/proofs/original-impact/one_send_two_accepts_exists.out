theory Kwaay_Impact_Original

begin

// Function signature and definition of the equational theory E

functions: ct_k/4[private,constructor], ct_l/4[private,constructor],
           ct_s/5[private,constructor], fst/1, pair/2,
           receiver_pk/2[private,constructor],
           receiver_prekey/2[private,constructor], secret_k/4[private,constructor],
           secret_l/4[private,constructor], secret_s/5[private,constructor],
           sender_pk/2[private,constructor], sender_prekey/2[private,constructor],
           session_id/7[private,constructor], session_key/4[private,constructor],
           snd/1
equations: fst(<x.1, x.2>) = x.1, snd(<x.1, x.2>) = x.2

rule (modulo E) InitReceiverState:
   [ Fr( ~rst ) ]
  --[ ReceiverStateCreated( $B, ~rst ) ]->
   [
   ReceiverState( $B, ~rst ), !ReceiverPublicState( $B, ~rst ),
   ReceiverCompromiseToken( $B, ~rst )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) InitSenderState:
   [ Fr( ~sst ) ]
  --[ SenderStateCreated( $A, ~sst ) ]->
   [ !SenderState( $A, ~sst ), SenderCompromiseToken( $A, ~sst ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) SenderCreatesMessage:
   [
   !SenderState( $A, sst ), !ReceiverPublicState( $B, rst ), Fr( ~rl ),
   Fr( ~rk ), Fr( ~rs )
   ]
  --[
  SenderSession( $A, $B,
                 <ct_l($A, $B, rst, ~rl), ct_k($A, $B, rst, ~rk), 
                  ct_s($A, $B, sst, rst, ~rs)>,
                 session_id($A, $B, sender_pk($A, sst), receiver_pk($B, rst),
                            sender_prekey($A, sst), receiver_prekey($B, rst),
                            <ct_l($A, $B, rst, ~rl), ct_k($A, $B, rst, ~rk), 
                             ct_s($A, $B, sst, rst, ~rs)>),
                 session_key(secret_l($A, $B, rst, ~rl), secret_k($A, $B, rst, ~rk),
                             secret_s($A, $B, sst, rst, ~rs),
                             session_id($A, $B, sender_pk($A, sst), receiver_pk($B, rst),
                                        sender_prekey($A, sst), receiver_prekey($B, rst),
                                        <ct_l($A, $B, rst, ~rl), ct_k($A, $B, rst, ~rk), 
                                         ct_s($A, $B, sst, rst, ~rs)>))
  )
  ]->
   [
   Out( <$A, $B, ct_l($A, $B, rst, ~rl), ct_k($A, $B, rst, ~rk), 
         ct_s($A, $B, sst, rst, ~rs)>
   ),
   !HonestSession( $A, $B, rst,
                   <ct_l($A, $B, rst, ~rl), ct_k($A, $B, rst, ~rk), 
                    ct_s($A, $B, sst, rst, ~rs)>,
                   session_id($A, $B, sender_pk($A, sst), receiver_pk($B, rst),
                              sender_prekey($A, sst), receiver_prekey($B, rst),
                              <ct_l($A, $B, rst, ~rl), ct_k($A, $B, rst, ~rk), 
                               ct_s($A, $B, sst, rst, ~rs)>),
                   session_key(secret_l($A, $B, rst, ~rl), secret_k($A, $B, rst, ~rk),
                               secret_s($A, $B, sst, rst, ~rs),
                               session_id($A, $B, sender_pk($A, sst), receiver_pk($B, rst),
                                          sender_prekey($A, sst), receiver_prekey($B, rst),
                                          <ct_l($A, $B, rst, ~rl), ct_k($A, $B, rst, ~rk), 
                                           ct_s($A, $B, sst, rst, ~rs)>))
   )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) CreateBatch:
   [ ReceiverState( $B, rst ), Fr( ~bid ) ]
  --[ BatchCreated( $B, ~bid, rst ) ]->
   [
   OpenStage0( $B, ~bid, rst ), BatchEndToken( $B, ~bid, rst ),
   BatchCompromiseToken( $B, ~bid, rst )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) AddSlot1:
   [ OpenStage0( $B, bid, rst ), In( <$A, $B, m> ), Fr( ~idx ) ]
  --[
  SlotAdded( $B, bid, ~idx, $A, m ),
  Slot1Added( $B, bid, rst, ~idx, $A, m )
  ]->
   [ OpenStage1( $B, bid, rst ), AddedSlot1( $B, bid, rst, ~idx, $A, m ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) AddSlot2:
   [ OpenStage1( $B, bid, rst ), In( <$A, $B, m> ), Fr( ~idx ) ]
  --[
  SlotAdded( $B, bid, ~idx, $A, m ),
  Slot2Added( $B, bid, rst, ~idx, $A, m )
  ]->
   [ OpenStage2( $B, bid, rst ), AddedSlot2( $B, bid, rst, ~idx, $A, m ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) SealBatch:
   [ OpenStage2( $B, bid, rst ) ]
  --[ SealBatchEvent( $B, bid, rst ) ]->
   [ SealedStage0( $B, bid, rst ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) ProcessSlot1:
   [
   SealedStage0( $B, bid, rst ), AddedSlot1( $B, bid, rst, idx, $A, m ),
   !HonestSession( $A, $B, rst, m, sid, k ), Fr( ~aid )
   ]
  --[
  BatchSlot( $B, bid, idx, $A, m ),
  ReceiverAccept( $B, $A, bid, idx, rst, m, sid, k ),
  AcceptOutputCreated( ~aid, $B, $A, bid, idx, rst, m, sid, k ),
  SlotProcessed( $B, bid, idx, $A, m ), Slot1Done( $B, bid, rst )
  ]->
   [
   SealedStage1( $B, bid, rst ), Slot1DoneFact( $B, bid, rst ),
   AcceptedOutput( ~aid, $B, $A, bid, idx, rst, m, sid, k )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) ProcessSlot2:
   [
   SealedStage1( $B, bid, rst ), AddedSlot2( $B, bid, rst, idx, $A, m ),
   !HonestSession( $A, $B, rst, m, sid, k ), Fr( ~aid )
   ]
  --[
  BatchSlot( $B, bid, idx, $A, m ),
  ReceiverAccept( $B, $A, bid, idx, rst, m, sid, k ),
  AcceptOutputCreated( ~aid, $B, $A, bid, idx, rst, m, sid, k ),
  SlotProcessed( $B, bid, idx, $A, m ), Slot2Done( $B, bid, rst )
  ]->
   [
   SealedStage2( $B, bid, rst ), Slot2DoneFact( $B, bid, rst ),
   AcceptedOutput( ~aid, $B, $A, bid, idx, rst, m, sid, k )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) CompleteBatch:
   [
   SealedStage2( $B, bid, rst ), BatchEndToken( $B, bid, rst ),
   Slot1DoneFact( $B, bid, rst ), Slot2DoneFact( $B, bid, rst )
   ]
  --[
  UseBatchEndToken( $B, bid, rst ), BatchComplete( $B, bid, rst ),
  BatchClosed( $B, bid, rst ), ConsumeReceiverState( $B, rst )
  ]->
   [
   ClosedBatch( $B, bid, rst ), UsedReceiverState( $B, rst ),
   ConsumerStage0( $B, bid, rst )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) FailSlot1:
   [
   SealedStage0( $B, bid, rst ), BatchEndToken( $B, bid, rst ),
   AddedSlot1( $B, bid, rst, idx, $A, m )
   ]
  --[
  UseBatchEndToken( $B, bid, rst ),
  BatchSlotFail( $B, bid, idx, $A, rst, m ), BatchFail( $B, bid, rst ),
  BatchClosed( $B, bid, rst ), ConsumeReceiverState( $B, rst )
  ]->
   [ ClosedBatch( $B, bid, rst ), UsedReceiverState( $B, rst ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) FailSlot2:
   [
   SealedStage1( $B, bid, rst ), BatchEndToken( $B, bid, rst ),
   AddedSlot2( $B, bid, rst, idx, $A, m )
   ]
  --[
  UseBatchEndToken( $B, bid, rst ),
  BatchSlotFail( $B, bid, idx, $A, rst, m ), BatchFail( $B, bid, rst ),
  BatchClosed( $B, bid, rst ), ConsumeReceiverState( $B, rst )
  ]->
   [ ClosedBatch( $B, bid, rst ), UsedReceiverState( $B, rst ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) InstallAcceptedOutputFirst:
   [
   ConsumerStage0( $B, bid, rst ),
   AcceptedOutput( aid, $B, $A, bid, idx, rst, m, sid, k ), Fr( ~h )
   ]
  --[
  InstallFromAccept( aid, $B, ~h, $A, bid, idx, rst, m, sid, k ),
  InstallSession( $B, ~h, $A, sid, k )
  ]->
   [
   ConsumerStage1( $B, bid, rst, aid, ~h ),
   InstalledOutput( aid, $B, ~h, $A, bid, idx, rst, m, sid, k )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) InstallAcceptedOutputSecond:
   [
   ConsumerStage1( $B, bid, rst, aid1, h1 ),
   AcceptedOutput( aid2, $B, $A, bid, idx, rst, m, sid, k ), Fr( ~h2 )
   ]
  --[
  InstallFromAccept( aid2, $B, ~h2, $A, bid, idx, rst, m, sid, k ),
  InstallSession( $B, ~h2, $A, sid, k )
  ]->
   [
   ConsumerStage2( $B, bid, rst, aid1, h1, aid2, ~h2 ),
   InstalledOutput( aid2, $B, ~h2, $A, bid, idx, rst, m, sid, k )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) CompleteConsumer:
   [
   ConsumerStage2( $B, bid, rst, aid1, h1, aid2, h2 ),
   InstalledOutput( aid1, $B, h1, $A1, bid, idx1, rst, m1, sid1, k1 ),
   InstalledOutput( aid2, $B, h2, $A2, bid, idx2, rst, m2, sid2, k2 )
   ]
  --[ ConsumerComplete( $B, bid, rst ) ]->
   [ ClosedConsumer( $B, bid, rst ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) CompromiseReceiverState:
   [ ReceiverState( $B, rst ), ReceiverCompromiseToken( $B, rst ) ]
  --[ CompromiseReceiverState( $B, rst ) ]->
   [
   ReceiverState( $B, rst ), !CompromisedReceiverState( $B, rst ),
   Out( rst )
   ]

  // loop breaker: [0]
  /* has exactly the trivial AC variant */

rule (modulo E) CompromiseActiveReceiverState:
   [ BatchCompromiseToken( $B, bid, rst ) ]
  --[ CompromiseReceiverState( $B, rst ) ]->
   [ !CompromisedReceiverState( $B, rst ), Out( rst ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) CompromiseSenderState:
   [ !SenderState( $A, sst ), SenderCompromiseToken( $A, sst ) ]
  --[ CompromiseSenderState( $A, sst ) ]->
   [ !CompromisedSenderState( $A, sst ), Out( sst ) ]

  /* has exactly the trivial AC variant */

lemma accept_output_has_same_time_accept:
  all-traces
  "∀ aid B A bid idx rst m sid k #r.
    (AcceptOutputCreated( aid, B, A, bid, idx, rst, m, sid, k ) @ #r) ⇒
    (ReceiverAccept( B, A, bid, idx, rst, m, sid, k ) @ #r)"
/*
guarded formula characterizing all counter-examples:
"∃ aid B A bid idx rst m sid k #r.
  (AcceptOutputCreated( aid, B, A, bid, idx, rst, m, sid, k ) @ #r)
 ∧
  ¬(ReceiverAccept( B, A, bid, idx, rst, m, sid, k ) @ #r)"
*/
by sorry

lemma receiver_accept_has_output:
  all-traces
  "∀ B A bid idx rst m sid k #r.
    (ReceiverAccept( B, A, bid, idx, rst, m, sid, k ) @ #r) ⇒
    (∃ aid. AcceptOutputCreated( aid, B, A, bid, idx, rst, m, sid, k ) @ #r)"
/*
guarded formula characterizing all counter-examples:
"∃ B A bid idx rst m sid k #r.
  (ReceiverAccept( B, A, bid, idx, rst, m, sid, k ) @ #r)
 ∧
  ∀ aid.
   (AcceptOutputCreated( aid, B, A, bid, idx, rst, m, sid, k ) @ #r) ⇒ ⊥"
*/
by sorry

lemma receiver_accept_has_unique_output:
  all-traces
  "∀ aid1 aid2 B A bid idx rst m sid k #r.
    ((AcceptOutputCreated( aid1, B, A, bid, idx, rst, m, sid, k ) @ #r) ∧
     (AcceptOutputCreated( aid2, B, A, bid, idx, rst, m, sid, k ) @ #r)) ⇒
    (aid1 = aid2)"
/*
guarded formula characterizing all counter-examples:
"∃ aid1 aid2 B A bid idx rst m sid k #r.
  (AcceptOutputCreated( aid1, B, A, bid, idx, rst, m, sid, k ) @ #r) ∧
  (AcceptOutputCreated( aid2, B, A, bid, idx, rst, m, sid, k ) @ #r)
 ∧
  ¬(aid1 = aid2)"
*/
by sorry

lemma accept_id_unique:
  all-traces
  "∀ aid B1 A1 bid1 idx1 rst1 m1 sid1 k1 B2 A2 bid2 idx2 rst2 m2 sid2 k2
     #r1 #r2.
    ((AcceptOutputCreated( aid, B1, A1, bid1, idx1, rst1, m1, sid1, k1
      ) @ #r1) ∧
     (AcceptOutputCreated( aid, B2, A2, bid2, idx2, rst2, m2, sid2, k2
      ) @ #r2)) ⇒
    (((((((((#r1 = #r2) ∧ (B1 = B2)) ∧ (A1 = A2)) ∧ (bid1 = bid2)) ∧
         (idx1 = idx2)) ∧
        (rst1 = rst2)) ∧
       (m1 = m2)) ∧
      (sid1 = sid2)) ∧
     (k1 = k2))"
/*
guarded formula characterizing all counter-examples:
"∃ aid B1 A1 bid1 idx1 rst1 m1 sid1 k1 B2 A2 bid2 idx2 rst2 m2 sid2 k2
   #r1 #r2.
  (AcceptOutputCreated( aid, B1, A1, bid1, idx1, rst1, m1, sid1, k1
   ) @ #r1) ∧
  (AcceptOutputCreated( aid, B2, A2, bid2, idx2, rst2, m2, sid2, k2
   ) @ #r2)
 ∧
  ((¬(#r1 = #r2)) ∨
   (¬(B1 = B2)) ∨
   (¬(A1 = A2)) ∨
   (¬(bid1 = bid2)) ∨
   (¬(idx1 = idx2)) ∨
   (¬(rst1 = rst2)) ∨
   (¬(m1 = m2)) ∨
   (¬(sid1 = sid2)) ∨
   (¬(k1 = k2)))"
*/
by sorry

lemma install_has_prior_accept:
  all-traces
  "∀ aid B h A bid idx rst m sid k #i.
    (InstallFromAccept( aid, B, h, A, bid, idx, rst, m, sid, k ) @ #i) ⇒
    (∃ #r.
      ((AcceptOutputCreated( aid, B, A, bid, idx, rst, m, sid, k ) @ #r) ∧
       (ReceiverAccept( B, A, bid, idx, rst, m, sid, k ) @ #r)) ∧
      (#r < #i))"
/*
guarded formula characterizing all counter-examples:
"∃ aid B h A bid idx rst m sid k #i.
  (InstallFromAccept( aid, B, h, A, bid, idx, rst, m, sid, k ) @ #i)
 ∧
  ∀ #r.
   (AcceptOutputCreated( aid, B, A, bid, idx, rst, m, sid, k ) @ #r) ∧
   (ReceiverAccept( B, A, bid, idx, rst, m, sid, k ) @ #r)
  ⇒
   ¬(#r < #i)"
*/
by sorry

lemma install_session_has_interface_origin:
  all-traces
  "∀ B h A sid k #i.
    (InstallSession( B, h, A, sid, k ) @ #i) ⇒
    (∃ aid bid idx rst m.
      InstallFromAccept( aid, B, h, A, bid, idx, rst, m, sid, k ) @ #i)"
/*
guarded formula characterizing all counter-examples:
"∃ B h A sid k #i.
  (InstallSession( B, h, A, sid, k ) @ #i)
 ∧
  ∀ aid bid idx rst m.
   (InstallFromAccept( aid, B, h, A, bid, idx, rst, m, sid, k ) @ #i) ⇒ ⊥"
*/
by sorry

lemma install_from_accept_has_session:
  all-traces
  "∀ aid B h A bid idx rst m sid k #i.
    (InstallFromAccept( aid, B, h, A, bid, idx, rst, m, sid, k ) @ #i) ⇒
    (InstallSession( B, h, A, sid, k ) @ #i)"
/*
guarded formula characterizing all counter-examples:
"∃ aid B h A bid idx rst m sid k #i.
  (InstallFromAccept( aid, B, h, A, bid, idx, rst, m, sid, k ) @ #i)
 ∧
  ¬(InstallSession( B, h, A, sid, k ) @ #i)"
*/
by sorry

lemma install_event_has_single_source:
  all-traces
  "∀ aid1 aid2 B1 B2 h1 h2 A1 A2 bid1 bid2 idx1 idx2 rst1 rst2 m1 m2 sid1
     sid2 k1 k2 #i.
    ((InstallFromAccept( aid1, B1, h1, A1, bid1, idx1, rst1, m1, sid1, k1
      ) @ #i) ∧
     (InstallFromAccept( aid2, B2, h2, A2, bid2, idx2, rst2, m2, sid2, k2
      ) @ #i)) ⇒
    (aid1 = aid2)"
/*
guarded formula characterizing all counter-examples:
"∃ aid1 aid2 B1 B2 h1 h2 A1 A2 bid1 bid2 idx1 idx2 rst1 rst2 m1 m2 sid1
   sid2 k1 k2 #i.
  (InstallFromAccept( aid1, B1, h1, A1, bid1, idx1, rst1, m1, sid1, k1
   ) @ #i) ∧
  (InstallFromAccept( aid2, B2, h2, A2, bid2, idx2, rst2, m2, sid2, k2
   ) @ #i)
 ∧
  ¬(aid1 = aid2)"
*/
by sorry

lemma install_handle_unique:
  all-traces
  "∀ aid1 aid2 B1 B2 h A1 A2 bid1 bid2 idx1 idx2 rst1 rst2 m1 m2 sid1 sid2
     k1 k2 #i1 #i2.
    ((InstallFromAccept( aid1, B1, h, A1, bid1, idx1, rst1, m1, sid1, k1
      ) @ #i1) ∧
     (InstallFromAccept( aid2, B2, h, A2, bid2, idx2, rst2, m2, sid2, k2
      ) @ #i2)) ⇒
    (#i1 = #i2)"
/*
guarded formula characterizing all counter-examples:
"∃ aid1 aid2 B1 B2 h A1 A2 bid1 bid2 idx1 idx2 rst1 rst2 m1 m2 sid1 sid2
   k1 k2 #i1 #i2.
  (InstallFromAccept( aid1, B1, h, A1, bid1, idx1, rst1, m1, sid1, k1
   ) @ #i1) ∧
  (InstallFromAccept( aid2, B2, h, A2, bid2, idx2, rst2, m2, sid2, k2
   ) @ #i2)
 ∧
  ¬(#i1 = #i2)"
*/
by sorry

lemma accept_output_installed_at_most_once:
  all-traces
  "∀ aid B1 B2 h1 h2 A1 A2 bid1 bid2 idx1 idx2 rst1 rst2 m1 m2 sid1 sid2 k1
     k2 #i1 #i2.
    ((InstallFromAccept( aid, B1, h1, A1, bid1, idx1, rst1, m1, sid1, k1
      ) @ #i1) ∧
     (InstallFromAccept( aid, B2, h2, A2, bid2, idx2, rst2, m2, sid2, k2
      ) @ #i2)) ⇒
    (#i1 = #i2)"
/*
guarded formula characterizing all counter-examples:
"∃ aid B1 B2 h1 h2 A1 A2 bid1 bid2 idx1 idx2 rst1 rst2 m1 m2 sid1 sid2 k1
   k2 #i1 #i2.
  (InstallFromAccept( aid, B1, h1, A1, bid1, idx1, rst1, m1, sid1, k1
   ) @ #i1) ∧
  (InstallFromAccept( aid, B2, h2, A2, bid2, idx2, rst2, m2, sid2, k2
   ) @ #i2)
 ∧
  ¬(#i1 = #i2)"
*/
by sorry

lemma distinct_accept_sources_have_distinct_handles:
  all-traces
  "∀ aid1 aid2 B1 B2 h1 h2 A1 A2 bid1 bid2 idx1 idx2 rst1 rst2 m1 m2 sid1
     sid2 k1 k2 #i1 #i2.
    (((InstallFromAccept( aid1, B1, h1, A1, bid1, idx1, rst1, m1, sid1, k1
       ) @ #i1) ∧
      (InstallFromAccept( aid2, B2, h2, A2, bid2, idx2, rst2, m2, sid2, k2
       ) @ #i2)) ∧
     (¬(aid1 = aid2))) ⇒
    (¬(h1 = h2))"
/*
guarded formula characterizing all counter-examples:
"∃ aid1 aid2 B1 B2 h1 h2 A1 A2 bid1 bid2 idx1 idx2 rst1 rst2 m1 m2 sid1
   sid2 k1 k2 #i1 #i2.
  (InstallFromAccept( aid1, B1, h1, A1, bid1, idx1, rst1, m1, sid1, k1
   ) @ #i1) ∧
  (InstallFromAccept( aid2, B2, h2, A2, bid2, idx2, rst2, m2, sid2, k2
   ) @ #i2)
 ∧
  (¬(aid1 = aid2)) ∧ (h1 = h2)"
*/
by sorry

lemma install_requires_batch_complete:
  all-traces
  "∀ aid B h A bid idx rst m sid k #i.
    (InstallFromAccept( aid, B, h, A, bid, idx, rst, m, sid, k ) @ #i) ⇒
    (∃ #c. (BatchComplete( B, bid, rst ) @ #c) ∧ (#c < #i))"
/*
guarded formula characterizing all counter-examples:
"∃ aid B h A bid idx rst m sid k #i.
  (InstallFromAccept( aid, B, h, A, bid, idx, rst, m, sid, k ) @ #i)
 ∧
  ∀ #c. (BatchComplete( B, bid, rst ) @ #c) ⇒ ¬(#c < #i)"
*/
by sorry

lemma consumer_complete_requires_all_outputs_installed:
  all-traces
  "∀ aid B A bid idx rst m sid k #r #cc.
    ((AcceptOutputCreated( aid, B, A, bid, idx, rst, m, sid, k ) @ #r) ∧
     (ConsumerComplete( B, bid, rst ) @ #cc)) ⇒
    (∃ h #i.
      ((InstallFromAccept( aid, B, h, A, bid, idx, rst, m, sid, k ) @ #i) ∧
       (#r < #i)) ∧
      (#i < #cc))"
/*
guarded formula characterizing all counter-examples:
"∃ aid B A bid idx rst m sid k #r #cc.
  (AcceptOutputCreated( aid, B, A, bid, idx, rst, m, sid, k ) @ #r) ∧
  (ConsumerComplete( B, bid, rst ) @ #cc)
 ∧
  ∀ h #i.
   (InstallFromAccept( aid, B, h, A, bid, idx, rst, m, sid, k ) @ #i)
  ⇒
   ((¬(#r < #i)) ∨ (¬(#i < #cc)))"
*/
by sorry

lemma consumer_complete_single_use:
  all-traces
  "∀ B bid rst #c1 #c2.
    ((ConsumerComplete( B, bid, rst ) @ #c1) ∧
     (ConsumerComplete( B, bid, rst ) @ #c2)) ⇒
    (#c1 = #c2)"
/*
guarded formula characterizing all counter-examples:
"∃ B bid rst #c1 #c2.
  (ConsumerComplete( B, bid, rst ) @ #c1) ∧
  (ConsumerComplete( B, bid, rst ) @ #c2)
 ∧
  ¬(#c1 = #c2)"
*/
by sorry

lemma no_install_after_consumer_close:
  all-traces
  "∀ aid B h A bid idx rst m sid k #i #cc.
    ((InstallFromAccept( aid, B, h, A, bid, idx, rst, m, sid, k ) @ #i) ∧
     (ConsumerComplete( B, bid, rst ) @ #cc)) ⇒
    (#i < #cc)"
/*
guarded formula characterizing all counter-examples:
"∃ aid B h A bid idx rst m sid k #i #cc.
  (InstallFromAccept( aid, B, h, A, bid, idx, rst, m, sid, k ) @ #i) ∧
  (ConsumerComplete( B, bid, rst ) @ #cc)
 ∧
  ¬(#i < #cc)"
*/
by sorry

lemma normal_one_accept_one_install:
  exists-trace
  "∃ A B bid idx rst m sid k aid h #s #r #c #i #cc.
    (((((((((SenderSession( A, B, m, sid, k ) @ #s) ∧
            (ReceiverAccept( B, A, bid, idx, rst, m, sid, k ) @ #r)) ∧
           (AcceptOutputCreated( aid, B, A, bid, idx, rst, m, sid, k ) @ #r)) ∧
          (BatchComplete( B, bid, rst ) @ #c)) ∧
         (InstallFromAccept( aid, B, h, A, bid, idx, rst, m, sid, k ) @ #i)) ∧
        (ConsumerComplete( B, bid, rst ) @ #cc)) ∧
       (#s < #r)) ∧
      (#r < #c)) ∧
     (#c < #i)) ∧
    (#i < #cc)"
/*
guarded formula characterizing all satisfying traces:
"∃ A B bid idx rst m sid k aid h #s #r #c #i #cc.
  (SenderSession( A, B, m, sid, k ) @ #s) ∧
  (ReceiverAccept( B, A, bid, idx, rst, m, sid, k ) @ #r) ∧
  (AcceptOutputCreated( aid, B, A, bid, idx, rst, m, sid, k ) @ #r) ∧
  (BatchComplete( B, bid, rst ) @ #c) ∧
  (InstallFromAccept( aid, B, h, A, bid, idx, rst, m, sid, k ) @ #i) ∧
  (ConsumerComplete( B, bid, rst ) @ #cc)
 ∧
  (#s < #r) ∧ (#r < #c) ∧ (#c < #i) ∧ (#i < #cc)"
*/
by sorry

lemma normal_consumer_complete:
  exists-trace
  "∃ A B bid idx1 idx2 rst m sid k aid1 aid2 h1 h2 #s #r1 #r2 #c #i1 #i2
     #cc.
    (((((((((((((((((((SenderSession( A, B, m, sid, k ) @ #s) ∧
                      (ReceiverAccept( B, A, bid, idx1, rst, m, sid, k ) @ #r1)) ∧
                     (AcceptOutputCreated( aid1, B, A, bid, idx1, rst, m, sid, k ) @ #r1)) ∧
                    (ReceiverAccept( B, A, bid, idx2, rst, m, sid, k ) @ #r2)) ∧
                   (AcceptOutputCreated( aid2, B, A, bid, idx2, rst, m, sid, k ) @ #r2)) ∧
                  (BatchComplete( B, bid, rst ) @ #c)) ∧
                 (InstallFromAccept( aid1, B, h1, A, bid, idx1, rst, m, sid, k ) @ #i1)) ∧
                (InstallFromAccept( aid2, B, h2, A, bid, idx2, rst, m, sid, k ) @ #i2)) ∧
               (ConsumerComplete( B, bid, rst ) @ #cc)) ∧
              (¬(aid1 = aid2))) ∧
             (¬(h1 = h2))) ∧
            (¬(#i1 = #i2))) ∧
           (#s < #r1)) ∧
          (#s < #r2)) ∧
         (#r1 < #c)) ∧
        (#r2 < #c)) ∧
       (#c < #i1)) ∧
      (#c < #i2)) ∧
     (#i1 < #cc)) ∧
    (#i2 < #cc)"
/*
guarded formula characterizing all satisfying traces:
"∃ A B bid idx1 idx2 rst m sid k aid1 aid2 h1 h2 #s #r1 #r2 #c #i1 #i2
   #cc.
  (SenderSession( A, B, m, sid, k ) @ #s) ∧
  (ReceiverAccept( B, A, bid, idx1, rst, m, sid, k ) @ #r1) ∧
  (AcceptOutputCreated( aid1, B, A, bid, idx1, rst, m, sid, k ) @ #r1) ∧
  (ReceiverAccept( B, A, bid, idx2, rst, m, sid, k ) @ #r2) ∧
  (AcceptOutputCreated( aid2, B, A, bid, idx2, rst, m, sid, k ) @ #r2) ∧
  (BatchComplete( B, bid, rst ) @ #c) ∧
  (InstallFromAccept( aid1, B, h1, A, bid, idx1, rst, m, sid, k ) @ #i1) ∧
  (InstallFromAccept( aid2, B, h2, A, bid, idx2, rst, m, sid, k ) @ #i2) ∧
  (ConsumerComplete( B, bid, rst ) @ #cc)
 ∧
  (¬(aid1 = aid2)) ∧
  (¬(h1 = h2)) ∧
  (¬(#i1 = #i2)) ∧
  (#s < #r1) ∧
  (#s < #r2) ∧
  (#r1 < #c) ∧
  (#r2 < #c) ∧
  (#c < #i1) ∧
  (#c < #i2) ∧
  (#i1 < #cc) ∧
  (#i2 < #cc)"
*/
by sorry

lemma one_send_two_accepts_two_installs_exists:
  exists-trace
  "∃ A B m sid k bid idx1 idx2 rst aid1 aid2 h1 h2 #s #r1 #r2 #c #i1 #i2
     #cc.
    ((((((((((((((((((((((((((SenderSession( A, B, m, sid, k ) @ #s) ∧
                             (ReceiverAccept( B, A, bid, idx1, rst, m, sid, k ) @ #r1)) ∧
                            (AcceptOutputCreated( aid1, B, A, bid, idx1, rst, m, sid, k ) @ #r1)) ∧
                           (ReceiverAccept( B, A, bid, idx2, rst, m, sid, k ) @ #r2)) ∧
                          (AcceptOutputCreated( aid2, B, A, bid, idx2, rst, m, sid, k ) @ #r2)) ∧
                         (BatchComplete( B, bid, rst ) @ #c)) ∧
                        (InstallFromAccept( aid1, B, h1, A, bid, idx1, rst, m, sid, k ) @ #i1)) ∧
                       (InstallFromAccept( aid2, B, h2, A, bid, idx2, rst, m, sid, k ) @ #i2)) ∧
                      (InstallSession( B, h1, A, sid, k ) @ #i1)) ∧
                     (InstallSession( B, h2, A, sid, k ) @ #i2)) ∧
                    (ConsumerComplete( B, bid, rst ) @ #cc)) ∧
                   (¬(#r1 = #r2))) ∧
                  (¬(idx1 = idx2))) ∧
                 (¬(aid1 = aid2))) ∧
                (¬(#i1 = #i2))) ∧
               (¬(h1 = h2))) ∧
              (#s < #r1)) ∧
             (#s < #r2)) ∧
            (#r1 < #c)) ∧
           (#r2 < #c)) ∧
          (#c < #i1)) ∧
         (#c < #i2)) ∧
        (#i1 < #cc)) ∧
       (#i2 < #cc)) ∧
      (∀ #s2. (SenderSession( A, B, m, sid, k ) @ #s2) ⇒ (#s2 = #s))) ∧
     (¬(∃ X st #cr. CompromiseReceiverState( X, st ) @ #cr))) ∧
    (¬(∃ X st #cs. CompromiseSenderState( X, st ) @ #cs))"
/*
guarded formula characterizing all satisfying traces:
"∃ A B m sid k bid idx1 idx2 rst aid1 aid2 h1 h2 #s #r1 #r2 #c #i1 #i2
   #cc.
  (SenderSession( A, B, m, sid, k ) @ #s) ∧
  (ReceiverAccept( B, A, bid, idx1, rst, m, sid, k ) @ #r1) ∧
  (AcceptOutputCreated( aid1, B, A, bid, idx1, rst, m, sid, k ) @ #r1) ∧
  (ReceiverAccept( B, A, bid, idx2, rst, m, sid, k ) @ #r2) ∧
  (AcceptOutputCreated( aid2, B, A, bid, idx2, rst, m, sid, k ) @ #r2) ∧
  (BatchComplete( B, bid, rst ) @ #c) ∧
  (InstallFromAccept( aid1, B, h1, A, bid, idx1, rst, m, sid, k ) @ #i1) ∧
  (InstallFromAccept( aid2, B, h2, A, bid, idx2, rst, m, sid, k ) @ #i2) ∧
  (InstallSession( B, h1, A, sid, k ) @ #i1) ∧
  (InstallSession( B, h2, A, sid, k ) @ #i2) ∧
  (ConsumerComplete( B, bid, rst ) @ #cc)
 ∧
  (¬(#r1 = #r2)) ∧
  (¬(idx1 = idx2)) ∧
  (¬(aid1 = aid2)) ∧
  (¬(#i1 = #i2)) ∧
  (¬(h1 = h2)) ∧
  (#s < #r1) ∧
  (#s < #r2) ∧
  (#r1 < #c) ∧
  (#r2 < #c) ∧
  (#c < #i1) ∧
  (#c < #i2) ∧
  (#i1 < #cc) ∧
  (#i2 < #cc) ∧
  (∀ #s2. (SenderSession( A, B, m, sid, k ) @ #s2) ⇒ #s2 = #s) ∧
  (∀ X st #cr. (CompromiseReceiverState( X, st ) @ #cr) ⇒ ⊥) ∧
  (∀ X st #cs. (CompromiseSenderState( X, st ) @ #cs) ⇒ ⊥)"
*/
by sorry

lemma unique_install_within_completed_consumer:
  all-traces
  "∀ A B m sid k bid idx1 idx2 rst aid1 aid2 h1 h2 #s #r1 #r2 #c #i1 #i2
     #cc.
    ((((((((((((((((((((((SenderSession( A, B, m, sid, k ) @ #s) ∧
                         (ReceiverAccept( B, A, bid, idx1, rst, m, sid, k ) @ #r1)) ∧
                        (AcceptOutputCreated( aid1, B, A, bid, idx1, rst, m, sid, k ) @ #r1)) ∧
                       (ReceiverAccept( B, A, bid, idx2, rst, m, sid, k ) @ #r2)) ∧
                      (AcceptOutputCreated( aid2, B, A, bid, idx2, rst, m, sid, k ) @ #r2)) ∧
                     (BatchComplete( B, bid, rst ) @ #c)) ∧
                    (InstallFromAccept( aid1, B, h1, A, bid, idx1, rst, m, sid, k ) @ #i1)) ∧
                   (InstallFromAccept( aid2, B, h2, A, bid, idx2, rst, m, sid, k ) @ #i2)) ∧
                  (InstallSession( B, h1, A, sid, k ) @ #i1)) ∧
                 (InstallSession( B, h2, A, sid, k ) @ #i2)) ∧
                (ConsumerComplete( B, bid, rst ) @ #cc)) ∧
               (#s < #r1)) ∧
              (#s < #r2)) ∧
             (#r1 < #c)) ∧
            (#r2 < #c)) ∧
           (#c < #i1)) ∧
          (#c < #i2)) ∧
         (#i1 < #cc)) ∧
        (#i2 < #cc)) ∧
       (∀ #s2. (SenderSession( A, B, m, sid, k ) @ #s2) ⇒ (#s2 = #s))) ∧
      (¬(∃ X st #cr. CompromiseReceiverState( X, st ) @ #cr))) ∧
     (¬(∃ X st #cs. CompromiseSenderState( X, st ) @ #cs))) ⇒
    (((#i1 = #i2) ∧ (h1 = h2)) ∧ (aid1 = aid2))"
/*
guarded formula characterizing all counter-examples:
"∃ A B m sid k bid idx1 idx2 rst aid1 aid2 h1 h2 #s #r1 #r2 #c #i1 #i2
   #cc.
  (SenderSession( A, B, m, sid, k ) @ #s) ∧
  (ReceiverAccept( B, A, bid, idx1, rst, m, sid, k ) @ #r1) ∧
  (AcceptOutputCreated( aid1, B, A, bid, idx1, rst, m, sid, k ) @ #r1) ∧
  (ReceiverAccept( B, A, bid, idx2, rst, m, sid, k ) @ #r2) ∧
  (AcceptOutputCreated( aid2, B, A, bid, idx2, rst, m, sid, k ) @ #r2) ∧
  (BatchComplete( B, bid, rst ) @ #c) ∧
  (InstallFromAccept( aid1, B, h1, A, bid, idx1, rst, m, sid, k ) @ #i1) ∧
  (InstallFromAccept( aid2, B, h2, A, bid, idx2, rst, m, sid, k ) @ #i2) ∧
  (InstallSession( B, h1, A, sid, k ) @ #i1) ∧
  (InstallSession( B, h2, A, sid, k ) @ #i2) ∧
  (ConsumerComplete( B, bid, rst ) @ #cc)
 ∧
  (#s < #r1) ∧
  (#s < #r2) ∧
  (#r1 < #c) ∧
  (#r2 < #c) ∧
  (#c < #i1) ∧
  (#c < #i2) ∧
  (#i1 < #cc) ∧
  (#i2 < #cc) ∧
  (∀ #s2. (SenderSession( A, B, m, sid, k ) @ #s2) ⇒ #s2 = #s) ∧
  (∀ X st #cr. (CompromiseReceiverState( X, st ) @ #cr) ⇒ ⊥) ∧
  (∀ X st #cs. (CompromiseSenderState( X, st ) @ #cs) ⇒ ⊥) ∧
  (((¬(#i1 = #i2)) ∨ (¬(h1 = h2)) ∨ (¬(aid1 = aid2))))"
*/
by sorry

