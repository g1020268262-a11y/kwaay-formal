  "∀ B bid rst idx1 idx2 A1 A2 m1 m2 #i #j.
    ((Slot1Added( B, bid, rst, idx1, A1, m1 ) @ #i) ∧
     (Slot2Added( B, bid, rst, idx2, A2, m2 ) @ #j)) ⇒
    (¬(idx1 = idx2))"
