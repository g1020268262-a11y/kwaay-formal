lemma normal_distinct_batch_complete:
  exists-trace
  "∃ A1 A2 B m1 m2 sid1 sid2 k1 k2 tag1 tag2 bid idx1 idx2 rst #s1 #s2 #p
     #r1 #r2 #c.
    (((((((((((ConfirmedSend( A1, B, m1, sid1, k1, tag1 ) @ #s1) ∧
              (ConfirmedSend( A2, B, m2, sid2, k2, tag2 ) @ #s2)) ∧
             (DedupPassed( B, bid, rst, idx1, A1, m1, idx2, A2, m2 ) @ #p)) ∧
            (ConfirmedReceiverAccept( B, A1, bid, idx1, rst, m1, sid1, k1, tag1
             ) @ #r1)) ∧
           (ConfirmedReceiverAccept( B, A2, bid, idx2, rst, m2, sid2, k2, tag2
            ) @ #r2)) ∧
          (BatchComplete( B, bid, rst ) @ #c)) ∧
         (¬(m1 = m2))) ∧
        (#s1 < #p)) ∧
       (#s2 < #p)) ∧
      (#p < #r1)) ∧
     (#r1 < #r2)) ∧
    (#r2 < #c)"
/*
guarded formula characterizing all satisfying traces:
"∃ A1 A2 B m1 m2 sid1 sid2 k1 k2 tag1 tag2 bid idx1 idx2 rst #s1 #s2 #p
   #r1 #r2 #c.
  (ConfirmedSend( A1, B, m1, sid1, k1, tag1 ) @ #s1) ∧
  (ConfirmedSend( A2, B, m2, sid2, k2, tag2 ) @ #s2) ∧
  (DedupPassed( B, bid, rst, idx1, A1, m1, idx2, A2, m2 ) @ #p) ∧
  (ConfirmedReceiverAccept( B, A1, bid, idx1, rst, m1, sid1, k1, tag1
   ) @ #r1) ∧
  (ConfirmedReceiverAccept( B, A2, bid, idx2, rst, m2, sid2, k2, tag2
   ) @ #r2) ∧
  (BatchComplete( B, bid, rst ) @ #c)
 ∧
  (¬(m1 = m2)) ∧
  (#s1 < #p) ∧
  (#s2 < #p) ∧
  (#p < #r1) ∧
  (#r1 < #r2) ∧
  (#r2 < #c)"
*/
by sorry

