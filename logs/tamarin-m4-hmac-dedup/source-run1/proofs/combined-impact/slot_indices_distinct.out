lemma hmac_failure_slot2_after_prior_accept_exists:
  exists-trace
  "∃ A1 A2 B m1 m2 sid1 sid2 k1 k2 tag1 tag2 bad2 bid idx1 idx2 rst aid1
     #s1 #s2 #p #r1 #hf #bf.
    (((((((((((((((((((ConfirmedSend( A1, B, m1, sid1, k1, tag1 ) @ #s1) ∧
                      (ConfirmedSend( A2, B, m2, sid2, k2, tag2 ) @ #s2)) ∧
                     (DedupPassed( B, bid, rst, idx1, A1, m1, idx2, A2, m2 ) @ #p)) ∧
                    (HmacValidated( B, A1, bid, idx1, rst, m1, sid1, k1, tag1 ) @ #r1)) ∧
                   (ConfirmedReceiverAccept( B, A1, bid, idx1, rst, m1, sid1, k1, tag1
                    ) @ #r1)) ∧
                  (AcceptOutputCreated( aid1, B, A1, bid, idx1, rst, m1, sid1, k1
                   ) @ #r1)) ∧
                 (TagMismatch( bad2, tag2 ) @ #hf)) ∧
                (HmacValidationFailed( B, A2, bid, idx2, rst, m2, sid2, k2, bad2, tag2
                 ) @ #hf)) ∧
               (BatchFail( B, bid, rst ) @ #bf)) ∧
              (¬(m1 = m2))) ∧
             (#s1 < #p)) ∧
            (#s2 < #p)) ∧
           (#p < #r1)) ∧
          (#r1 < #hf)) ∧
         (#hf < #bf)) ∧
        (¬(∃ A3 m3 sid3 k3 tag3 #r2.
            ConfirmedReceiverAccept( B, A3, bid, idx2, rst, m3, sid3, k3, tag3
            ) @ #r2))) ∧
       (¬(∃ #c. BatchComplete( B, bid, rst ) @ #c))) ∧
      (¬(∃ #cs. ConsumerStarted( B, bid, rst ) @ #cs))) ∧
     (¬(∃ #cc. ConsumerComplete( B, bid, rst ) @ #cc))) ∧
    (¬(∃ aid h A3 idx3 m3 sid3 k3 #i.
        InstallFromAccept( aid, B, h, A3, bid, idx3, rst, m3, sid3, k3 ) @ #i))"
/*
guarded formula characterizing all satisfying traces:
"∃ A1 A2 B m1 m2 sid1 sid2 k1 k2 tag1 tag2 bad2 bid idx1 idx2 rst aid1
   #s1 #s2 #p #r1 #hf #bf.
  (ConfirmedSend( A1, B, m1, sid1, k1, tag1 ) @ #s1) ∧
