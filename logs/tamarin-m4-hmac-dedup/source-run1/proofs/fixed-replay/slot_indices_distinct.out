theory Kwaay_Replay_Fixed

begin

// Function signature and definition of the equational theory E

functions: ct_k/4[private,constructor], ct_l/4[private,constructor],
           ct_s/5[private,constructor], fst/1, pair/2,
           receiver_pk/2[private,constructor],
           receiver_prekey/2[private,constructor], secret_k/4[private,constructor],
           secret_l/4[private,constructor], secret_s/5[private,constructor],
           sender_pk/2[private,constructor], sender_prekey/2[private,constructor],
           session_id/7[private,constructor], session_key/4[private,constructor],
           snd/1
equations: fst(<x.1, x.2>) = x.1, snd(<x.1, x.2>) = x.2

restriction Inequality:
  "∀ x #i. (Neq( x, x ) @ #i) ⇒ (⊥)"
  // safety formula

  /*
  expanded formula:
  "∀ x #i. (Neq( x, x ) @ #i) ⇒ (⊥)"
  */

rule (modulo E) InitReceiverState:
   [ Fr( ~rst ) ]
  --[ ReceiverStateCreated( $B, ~rst ) ]->
   [
   ReceiverState( $B, ~rst ), !ReceiverPublicState( $B, ~rst ),
   ReceiverCompromiseToken( $B, ~rst )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) InitSenderState:
   [ Fr( ~sst ) ]
  --[ SenderStateCreated( $A, ~sst ) ]->
   [ !SenderState( $A, ~sst ), SenderCompromiseToken( $A, ~sst ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) SenderCreatesMessage:
   [
   !SenderState( $A, sst ), !ReceiverPublicState( $B, rst ), Fr( ~rl ),
   Fr( ~rk ), Fr( ~rs )
   ]
  --[
  SenderSession( $A, $B,
                 <ct_l($A, $B, rst, ~rl), ct_k($A, $B, rst, ~rk), 
                  ct_s($A, $B, sst, rst, ~rs)>,
                 session_id($A, $B, sender_pk($A, sst), receiver_pk($B, rst),
                            sender_prekey($A, sst), receiver_prekey($B, rst),
                            <ct_l($A, $B, rst, ~rl), ct_k($A, $B, rst, ~rk), 
                             ct_s($A, $B, sst, rst, ~rs)>),
                 session_key(secret_l($A, $B, rst, ~rl), secret_k($A, $B, rst, ~rk),
                             secret_s($A, $B, sst, rst, ~rs),
                             session_id($A, $B, sender_pk($A, sst), receiver_pk($B, rst),
                                        sender_prekey($A, sst), receiver_prekey($B, rst),
                                        <ct_l($A, $B, rst, ~rl), ct_k($A, $B, rst, ~rk), 
                                         ct_s($A, $B, sst, rst, ~rs)>))
  )
  ]->
   [
   Out( <$A, $B, ct_l($A, $B, rst, ~rl), ct_k($A, $B, rst, ~rk), 
         ct_s($A, $B, sst, rst, ~rs)>
   ),
   !HonestSession( $A, $B, rst,
                   <ct_l($A, $B, rst, ~rl), ct_k($A, $B, rst, ~rk), 
                    ct_s($A, $B, sst, rst, ~rs)>,
                   session_id($A, $B, sender_pk($A, sst), receiver_pk($B, rst),
                              sender_prekey($A, sst), receiver_prekey($B, rst),
                              <ct_l($A, $B, rst, ~rl), ct_k($A, $B, rst, ~rk), 
                               ct_s($A, $B, sst, rst, ~rs)>),
                   session_key(secret_l($A, $B, rst, ~rl), secret_k($A, $B, rst, ~rk),
                               secret_s($A, $B, sst, rst, ~rs),
                               session_id($A, $B, sender_pk($A, sst), receiver_pk($B, rst),
                                          sender_prekey($A, sst), receiver_prekey($B, rst),
                                          <ct_l($A, $B, rst, ~rl), ct_k($A, $B, rst, ~rk), 
                                           ct_s($A, $B, sst, rst, ~rs)>))
   )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) CreateBatch:
   [ ReceiverState( $B, rst ), Fr( ~bid ) ]
  --[ BatchCreated( $B, ~bid, rst ) ]->
   [
   OpenStage0( $B, ~bid, rst ), BatchEndToken( $B, ~bid, rst ),
   BatchCompromiseToken( $B, ~bid, rst )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) AddSlot1:
   [ OpenStage0( $B, bid, rst ), In( <$A, $B, m> ), Fr( ~idx ) ]
  --[
  SlotAdded( $B, bid, ~idx, $A, m ),
  Slot1Added( $B, bid, rst, ~idx, $A, m )
  ]->
   [ OpenStage1( $B, bid, rst ), AddedSlot1( $B, bid, rst, ~idx, $A, m ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) AddSlot2:
   [ OpenStage1( $B, bid, rst ), In( <$A, $B, m> ), Fr( ~idx ) ]
  --[
  SlotAdded( $B, bid, ~idx, $A, m ),
  Slot2Added( $B, bid, rst, ~idx, $A, m )
  ]->
   [ OpenStage2( $B, bid, rst ), AddedSlot2( $B, bid, rst, ~idx, $A, m ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) SealBatch:
   [
   OpenStage2( $B, bid, rst ), AddedSlot1( $B, bid, rst, idx1, $A1, m1 ),
   AddedSlot2( $B, bid, rst, idx2, $A2, m2 )
   ]
  --[ SealBatchEvent( $B, bid, rst ) ]->
   [
   DedupPending( $B, bid, rst, idx1, $A1, m1, idx2, $A2, m2 ),
   DedupDecisionToken( $B, bid, rst )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) RejectDuplicateBatch:
   [
   DedupPending( $B, bid, rst, idx1, $A1, m, idx2, $A2, m ),
   DedupDecisionToken( $B, bid, rst ), BatchEndToken( $B, bid, rst )
   ]
  --[
  DuplicateDetected( $B, bid, rst, idx1, $A1, idx2, $A2, m ),
  UseDedupDecisionToken( $B, bid, rst ), UseBatchEndToken( $B, bid, rst ),
  BatchFail( $B, bid, rst ), BatchClosed( $B, bid, rst ),
  ConsumeReceiverState( $B, rst )
  ]->
   [ ClosedBatch( $B, bid, rst ), UsedReceiverState( $B, rst ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) PassDistinctBatch:
   [
   DedupPending( $B, bid, rst, idx1, $A1, m1, idx2, $A2, m2 ),
   DedupDecisionToken( $B, bid, rst )
   ]
  --[
  Neq( m1, m2 ), DedupPassed( $B, bid, rst, idx1, $A1, m1, idx2, $A2, m2 ),
  UseDedupDecisionToken( $B, bid, rst )
  ]->
   [
   CheckedSlot1( $B, bid, rst, idx1, $A1, m1 ),
   CheckedSlot2( $B, bid, rst, idx2, $A2, m2 ), SealedStage0( $B, bid, rst )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) ProcessSlot1:
   [
   SealedStage0( $B, bid, rst ), CheckedSlot1( $B, bid, rst, idx, $A, m ),
   !HonestSession( $A, $B, rst, m, sid, k )
   ]
  --[
  BatchSlot( $B, bid, idx, $A, m ),
  ReceiverAccept( $B, $A, bid, idx, rst, m, sid, k ),
  SlotProcessed( $B, bid, idx, $A, m ), Slot1Done( $B, bid, rst )
  ]->
   [ SealedStage1( $B, bid, rst ), Slot1DoneFact( $B, bid, rst ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) ProcessSlot2:
   [
   SealedStage1( $B, bid, rst ), CheckedSlot2( $B, bid, rst, idx, $A, m ),
   !HonestSession( $A, $B, rst, m, sid, k )
   ]
  --[
  BatchSlot( $B, bid, idx, $A, m ),
  ReceiverAccept( $B, $A, bid, idx, rst, m, sid, k ),
  SlotProcessed( $B, bid, idx, $A, m ), Slot2Done( $B, bid, rst )
  ]->
   [ SealedStage2( $B, bid, rst ), Slot2DoneFact( $B, bid, rst ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) CompleteBatch:
   [
   SealedStage2( $B, bid, rst ), BatchEndToken( $B, bid, rst ),
   Slot1DoneFact( $B, bid, rst ), Slot2DoneFact( $B, bid, rst )
   ]
  --[
  UseBatchEndToken( $B, bid, rst ), BatchComplete( $B, bid, rst ),
  BatchClosed( $B, bid, rst ), ConsumeReceiverState( $B, rst )
  ]->
   [ ClosedBatch( $B, bid, rst ), UsedReceiverState( $B, rst ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) FailSlot1:
   [
   SealedStage0( $B, bid, rst ), BatchEndToken( $B, bid, rst ),
   CheckedSlot1( $B, bid, rst, idx, $A, m )
   ]
  --[
  UseBatchEndToken( $B, bid, rst ),
  BatchSlotFail( $B, bid, idx, $A, rst, m ), BatchFail( $B, bid, rst ),
  BatchClosed( $B, bid, rst ), ConsumeReceiverState( $B, rst )
  ]->
   [ ClosedBatch( $B, bid, rst ), UsedReceiverState( $B, rst ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) FailSlot2:
   [
   SealedStage1( $B, bid, rst ), BatchEndToken( $B, bid, rst ),
   CheckedSlot2( $B, bid, rst, idx, $A, m )
   ]
  --[
  UseBatchEndToken( $B, bid, rst ),
  BatchSlotFail( $B, bid, idx, $A, rst, m ), BatchFail( $B, bid, rst ),
  BatchClosed( $B, bid, rst ), ConsumeReceiverState( $B, rst )
  ]->
   [ ClosedBatch( $B, bid, rst ), UsedReceiverState( $B, rst ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) CompromiseReceiverState:
   [ ReceiverState( $B, rst ), ReceiverCompromiseToken( $B, rst ) ]
  --[ CompromiseReceiverState( $B, rst ) ]->
   [
   ReceiverState( $B, rst ), !CompromisedReceiverState( $B, rst ),
   Out( rst )
   ]

  // loop breaker: [0]
  /* has exactly the trivial AC variant */

rule (modulo E) CompromiseActiveReceiverState:
   [ BatchCompromiseToken( $B, bid, rst ) ]
  --[ CompromiseReceiverState( $B, rst ) ]->
   [ !CompromisedReceiverState( $B, rst ), Out( rst ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) CompromiseSenderState:
   [ !SenderState( $A, sst ), SenderCompromiseToken( $A, sst ) ]
  --[ CompromiseSenderState( $A, sst ) ]->
   [ !CompromisedSenderState( $A, sst ), Out( sst ) ]

  /* has exactly the trivial AC variant */

lemma normal_single_accept:
  exists-trace
  "∃ A B m sid k bid idx rst #s #r.
    ((SenderSession( A, B, m, sid, k ) @ #s) ∧
     (ReceiverAccept( B, A, bid, idx, rst, m, sid, k ) @ #r)) ∧
    (#s < #r)"
/*
guarded formula characterizing all satisfying traces:
"∃ A B m sid k bid idx rst #s #r.
  (SenderSession( A, B, m, sid, k ) @ #s) ∧
  (ReceiverAccept( B, A, bid, idx, rst, m, sid, k ) @ #r)
 ∧
  #s < #r"
*/
by sorry

lemma normal_batch_complete:
  exists-trace
  "∃ A B m sid k bid idx rst #s #r #c.
    ((((SenderSession( A, B, m, sid, k ) @ #s) ∧
       (ReceiverAccept( B, A, bid, idx, rst, m, sid, k ) @ #r)) ∧
      (BatchComplete( B, bid, rst ) @ #c)) ∧
     (#s < #r)) ∧
    (#r < #c)"
/*
guarded formula characterizing all satisfying traces:
"∃ A B m sid k bid idx rst #s #r #c.
  (SenderSession( A, B, m, sid, k ) @ #s) ∧
  (ReceiverAccept( B, A, bid, idx, rst, m, sid, k ) @ #r) ∧
  (BatchComplete( B, bid, rst ) @ #c)
 ∧
  (#s < #r) ∧ (#r < #c)"
*/
by sorry

lemma one_send_two_accepts_exists:
  exists-trace
  "∃ A B m sid k bid idx1 idx2 rst #s #r1 #r2 #c.
    (((((((((((SenderSession( A, B, m, sid, k ) @ #s) ∧
              (ReceiverAccept( B, A, bid, idx1, rst, m, sid, k ) @ #r1)) ∧
             (ReceiverAccept( B, A, bid, idx2, rst, m, sid, k ) @ #r2)) ∧
            (BatchComplete( B, bid, rst ) @ #c)) ∧
           (¬(idx1 = idx2))) ∧
          (#s < #r1)) ∧
         (#s < #r2)) ∧
        (#r1 < #c)) ∧
       (#r2 < #c)) ∧
      (∀ #s2. (SenderSession( A, B, m, sid, k ) @ #s2) ⇒ (#s2 = #s))) ∧
     (¬(∃ X st #cr. CompromiseReceiverState( X, st ) @ #cr))) ∧
    (¬(∃ X st #cs. CompromiseSenderState( X, st ) @ #cs))"
/*
guarded formula characterizing all satisfying traces:
"∃ A B m sid k bid idx1 idx2 rst #s #r1 #r2 #c.
  (SenderSession( A, B, m, sid, k ) @ #s) ∧
  (ReceiverAccept( B, A, bid, idx1, rst, m, sid, k ) @ #r1) ∧
  (ReceiverAccept( B, A, bid, idx2, rst, m, sid, k ) @ #r2) ∧
  (BatchComplete( B, bid, rst ) @ #c)
 ∧
  (¬(idx1 = idx2)) ∧
  (#s < #r1) ∧
  (#s < #r2) ∧
  (#r1 < #c) ∧
  (#r2 < #c) ∧
  (∀ #s2. (SenderSession( A, B, m, sid, k ) @ #s2) ⇒ #s2 = #s) ∧
  (∀ X st #cr. (CompromiseReceiverState( X, st ) @ #cr) ⇒ ⊥) ∧
  (∀ X st #cs. (CompromiseSenderState( X, st ) @ #cs) ⇒ ⊥)"
*/
by sorry

lemma same_message_accepted_at_most_once:
  all-traces
  "∀ A B m sid k bid idx1 idx2 rst #r1 #r2.
    ((ReceiverAccept( B, A, bid, idx1, rst, m, sid, k ) @ #r1) ∧
     (ReceiverAccept( B, A, bid, idx2, rst, m, sid, k ) @ #r2)) ⇒
    (idx1 = idx2)"
/*
guarded formula characterizing all counter-examples:
"∃ A B m sid k bid idx1 idx2 rst #r1 #r2.
  (ReceiverAccept( B, A, bid, idx1, rst, m, sid, k ) @ #r1) ∧
  (ReceiverAccept( B, A, bid, idx2, rst, m, sid, k ) @ #r2)
 ∧
  ¬(idx1 = idx2)"
*/
by sorry

lemma full_message_unique_send:
  all-traces
  "∀ A B m sid k #s1 #s2.
    ((SenderSession( A, B, m, sid, k ) @ #s1) ∧
     (SenderSession( A, B, m, sid, k ) @ #s2)) ⇒
    (#s1 = #s2)"
/*
guarded formula characterizing all counter-examples:
"∃ A B m sid k #s1 #s2.
  (SenderSession( A, B, m, sid, k ) @ #s1) ∧
  (SenderSession( A, B, m, sid, k ) @ #s2)
 ∧
  ¬(#s1 = #s2)"
*/
by sorry

lemma receiver_accept_has_sender:
  all-traces
  "∀ A B m sid k bid idx rst #r.
    (ReceiverAccept( B, A, bid, idx, rst, m, sid, k ) @ #r) ⇒
    (∃ #s. (SenderSession( A, B, m, sid, k ) @ #s) ∧ (#s < #r))"
/*
guarded formula characterizing all counter-examples:
"∃ A B m sid k bid idx rst #r.
  (ReceiverAccept( B, A, bid, idx, rst, m, sid, k ) @ #r)
 ∧
  ∀ #s. (SenderSession( A, B, m, sid, k ) @ #s) ⇒ ¬(#s < #r)"
*/
by sorry

lemma injective_receiver_accept:
  all-traces
  "∀ A B m sid k bid idx1 idx2 rst #s #r1 #r2.
    (((SenderSession( A, B, m, sid, k ) @ #s) ∧
      (ReceiverAccept( B, A, bid, idx1, rst, m, sid, k ) @ #r1)) ∧
     (ReceiverAccept( B, A, bid, idx2, rst, m, sid, k ) @ #r2)) ⇒
    (#r1 = #r2)"
/*
guarded formula characterizing all counter-examples:
"∃ A B m sid k bid idx1 idx2 rst #s #r1 #r2.
  (SenderSession( A, B, m, sid, k ) @ #s) ∧
  (ReceiverAccept( B, A, bid, idx1, rst, m, sid, k ) @ #r1) ∧
  (ReceiverAccept( B, A, bid, idx2, rst, m, sid, k ) @ #r2)
 ∧
  ¬(#r1 = #r2)"
*/
by sorry

lemma slot_indices_distinct:
  all-traces
  "∀ B bid rst idx1 idx2 A1 A2 m1 m2 #i #j.
    ((Slot1Added( B, bid, rst, idx1, A1, m1 ) @ #i) ∧
     (Slot2Added( B, bid, rst, idx2, A2, m2 ) @ #j)) ⇒
    (¬(idx1 = idx2))"
/*
guarded formula characterizing all counter-examples:
"∃ B bid rst idx1 idx2 A1 A2 m1 m2 #i #j.
  (Slot1Added( B, bid, rst, idx1, A1, m1 ) @ #i) ∧
  (Slot2Added( B, bid, rst, idx2, A2, m2 ) @ #j)
 ∧
  idx1 = idx2"
*/
by simplify

lemma process_requires_slot_added:
  all-traces
  "∀ B A bid idx rst m sid k #i.
    (ReceiverAccept( B, A, bid, idx, rst, m, sid, k ) @ #i) ⇒
    (∃ #j. (SlotAdded( B, bid, idx, A, m ) @ #j) ∧ (#j < #i))"
/*
guarded formula characterizing all counter-examples:
"∃ B A bid idx rst m sid k #i.
  (ReceiverAccept( B, A, bid, idx, rst, m, sid, k ) @ #i)
 ∧
  ∀ #j. (SlotAdded( B, bid, idx, A, m ) @ #j) ⇒ ¬(#j < #i)"
*/
by sorry

lemma process_requires_seal:
  all-traces
  "∀ B A bid idx rst m sid k #i.
    (ReceiverAccept( B, A, bid, idx, rst, m, sid, k ) @ #i) ⇒
    (∃ #j. (SealBatchEvent( B, bid, rst ) @ #j) ∧ (#j < #i))"
/*
guarded formula characterizing all counter-examples:
"∃ B A bid idx rst m sid k #i.
  (ReceiverAccept( B, A, bid, idx, rst, m, sid, k ) @ #i)
 ∧
  ∀ #j. (SealBatchEvent( B, bid, rst ) @ #j) ⇒ ¬(#j < #i)"
*/
by sorry

lemma complete_requires_all_slots_processed:
  all-traces
  "∀ B bid rst idx A m #i #j.
    ((BatchComplete( B, bid, rst ) @ #i) ∧
     (SlotAdded( B, bid, idx, A, m ) @ #j)) ⇒
    (∃ #p.
      ((SlotProcessed( B, bid, idx, A, m ) @ #p) ∧ (#j < #p)) ∧ (#p < #i))"
/*
guarded formula characterizing all counter-examples:
"∃ B bid rst idx A m #i #j.
  (BatchComplete( B, bid, rst ) @ #i) ∧
  (SlotAdded( B, bid, idx, A, m ) @ #j)
 ∧
  ∀ #p.
   (SlotProcessed( B, bid, idx, A, m ) @ #p)
  ⇒
   ((¬(#j < #p)) ∨ (¬(#p < #i)))"
*/
by sorry

lemma no_add_after_seal:
  all-traces
  "∀ B bid rst idx A m #i #j.
    ((SealBatchEvent( B, bid, rst ) @ #i) ∧
     (SlotAdded( B, bid, idx, A, m ) @ #j)) ⇒
    (#j < #i)"
/*
guarded formula characterizing all counter-examples:
"∃ B bid rst idx A m #i #j.
  (SealBatchEvent( B, bid, rst ) @ #i) ∧
  (SlotAdded( B, bid, idx, A, m ) @ #j)
 ∧
  ¬(#j < #i)"
*/
by sorry

lemma no_accept_after_close:
  all-traces
  "∀ B A bid idx rst m sid k #i #j.
    ((BatchClosed( B, bid, rst ) @ #i) ∧
     (ReceiverAccept( B, A, bid, idx, rst, m, sid, k ) @ #j)) ⇒
    (#j < #i)"
/*
guarded formula characterizing all counter-examples:
"∃ B A bid idx rst m sid k #i #j.
  (BatchClosed( B, bid, rst ) @ #i) ∧
  (ReceiverAccept( B, A, bid, idx, rst, m, sid, k ) @ #j)
 ∧
  ¬(#j < #i)"
*/
by sorry

lemma batch_complete_consumes_state:
  all-traces
  "∀ B bid rst #i.
    (BatchComplete( B, bid, rst ) @ #i) ⇒
    (ConsumeReceiverState( B, rst ) @ #i)"
/*
guarded formula characterizing all counter-examples:
"∃ B bid rst #i.
  (BatchComplete( B, bid, rst ) @ #i)
 ∧
  ¬(ConsumeReceiverState( B, rst ) @ #i)"
*/
by sorry

lemma batch_fail_consumes_state:
  all-traces
  "∀ B bid rst #i.
    (BatchFail( B, bid, rst ) @ #i) ⇒ (ConsumeReceiverState( B, rst ) @ #i)"
/*
guarded formula characterizing all counter-examples:
"∃ B bid rst #i.
  (BatchFail( B, bid, rst ) @ #i) ∧ ¬(ConsumeReceiverState( B, rst ) @ #i)"
*/
by sorry

lemma batch_end_token_single_use:
  all-traces
  "∀ B bid rst #i #j.
    ((UseBatchEndToken( B, bid, rst ) @ #i) ∧
     (UseBatchEndToken( B, bid, rst ) @ #j)) ⇒
    (#i = #j)"
/*
guarded formula characterizing all counter-examples:
"∃ B bid rst #i #j.
  (UseBatchEndToken( B, bid, rst ) @ #i) ∧
  (UseBatchEndToken( B, bid, rst ) @ #j)
 ∧
  ¬(#i = #j)"
*/
by sorry

lemma receiver_state_single_batch:
  all-traces
  "∀ B bid1 bid2 rst #i #j.
    ((BatchCreated( B, bid1, rst ) @ #i) ∧
     (BatchCreated( B, bid2, rst ) @ #j)) ⇒
    ((#i = #j) ∧ (bid1 = bid2))"
/*
guarded formula characterizing all counter-examples:
"∃ B bid1 bid2 rst #i #j.
  (BatchCreated( B, bid1, rst ) @ #i) ∧ (BatchCreated( B, bid2, rst ) @ #j)
 ∧
  ((¬(#i = #j)) ∨ (¬(bid1 = bid2)))"
*/
by sorry

lemma receiver_state_single_batch_end:
  all-traces
  "∀ B rst #i #j.
    ((ConsumeReceiverState( B, rst ) @ #i) ∧
     (ConsumeReceiverState( B, rst ) @ #j)) ⇒
    (#i = #j)"
/*
guarded formula characterizing all counter-examples:
"∃ B rst #i #j.
  (ConsumeReceiverState( B, rst ) @ #i) ∧
  (ConsumeReceiverState( B, rst ) @ #j)
 ∧
  ¬(#i = #j)"
*/
by sorry

lemma duplicate_batch_fail_exists:
  exists-trace
  "∃ A B m sid k bid idx1 idx2 rst #s #a1 #a2 #seal #d.
    ((((((((((((((((SenderSession( A, B, m, sid, k ) @ #s) ∧
                   (Slot1Added( B, bid, rst, idx1, A, m ) @ #a1)) ∧
                  (Slot2Added( B, bid, rst, idx2, A, m ) @ #a2)) ∧
                 (SealBatchEvent( B, bid, rst ) @ #seal)) ∧
                (DuplicateDetected( B, bid, rst, idx1, A, idx2, A, m ) @ #d)) ∧
               (UseDedupDecisionToken( B, bid, rst ) @ #d)) ∧
              (BatchFail( B, bid, rst ) @ #d)) ∧
             (BatchClosed( B, bid, rst ) @ #d)) ∧
            (ConsumeReceiverState( B, rst ) @ #d)) ∧
           (¬(idx1 = idx2))) ∧
