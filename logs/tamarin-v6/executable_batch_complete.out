theory Kwaay_SplitKem_Batch_Dynamic_V6

begin

// Function signature and definition of the equational theory E

functions: cts/4[private,constructor], fst/1, ks/4[private,constructor],
           pair/2, rkey/5[private,constructor], snd/1
equations: fst(<x.1, x.2>) = x.1, snd(<x.1, x.2>) = x.2

rule (modulo E) InitReceiverState:
   [ Fr( ~rst ) ]
  --[ ReceiverStateCreated( $B, ~rst ) ]->
   [
   ReceiverState( $B, ~rst ), !ReceiverPublicState( $B, ~rst ),
   ReceiverCompromiseToken( $B, ~rst )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) InitSenderState:
   [ Fr( ~sst ) ]
  --[ SenderStateCreated( $A, ~sst ) ]->
   [ !SenderState( $A, ~sst ), SenderCompromiseToken( $A, ~sst ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) SenderCreatesComponent:
   [ !SenderState( $A, sst ), !ReceiverPublicState( $B, rst ), Fr( ~r ) ]
  --[
  SenderComponent( $A, $B, rst, cts($A, $B, sst, ~r), ks($A, $B, sst, ~r) )
  ]->
   [
   Out( <$A, $B, cts($A, $B, sst, ~r)> ),
   !ComponentKey( $A, $B, rst, cts($A, $B, sst, ~r), ks($A, $B, sst, ~r) )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) CreateBatch:
   [ ReceiverState( $B, rst ), Fr( ~bid ) ]
  --[ BatchCreated( $B, ~bid, rst ) ]->
   [
   AddSlotToken( $B, ~bid, rst ), AddSlotToken( $B, ~bid, rst ),
   AddSlotToken( $B, ~bid, rst ), AddSlotToken( $B, ~bid, rst ),
   SealToken( $B, ~bid, rst ), BatchEndToken( $B, ~bid, rst ),
   BatchCompromiseToken( $B, ~bid, rst )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) AddSlot:
   [ AddSlotToken( $B, bid, rst ), In( <$A, $B, cts_in> ), Fr( ~idx ) ]
  --[ SlotAdded( $B, bid, ~idx, $A, cts_in ) ]->
   [ PendingSlot( $B, bid, ~idx, $A, cts_in ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) SealBatch:
   [ SealToken( $B, bid, rst ) ]
  --[ SealBatchEvent( $B, bid, rst ) ]->
   [ !BatchSealedFact( $B, bid, rst ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) ProcessPendingSlot:
   [
   !BatchSealedFact( $B, bid, rst ),
   PendingSlot( $B, bid, idx, $A, cts_in ),
   !ComponentKey( $A, $B, rst, cts_in, Ks )
   ]
  --[
  BatchSlot( $B, bid, idx, $A, cts_in ),
  BatchSlotAccept( $B, bid, idx, $A, rst, cts_in, Ks ),
  ReceiverAcceptsComponent( $B, $A, rst, cts_in, Ks ),
  ReceiverKey( $B, $A, bid, idx, rst, cts_in, Ks,
               rkey($B, $A, rst, cts_in, Ks)
  ),
  PartneredSlot( $A, $B, bid, idx, rst, cts_in, Ks ),
  SlotProcessed( $B, bid, idx, $A, cts_in ),
  DoneSlotEvent( $B, bid, idx, $A, cts_in )
  ]->
   [ DoneSlot( $B, bid, idx, $A, cts_in ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) CompromiseReceiverState:
   [ ReceiverState( $B, rst ), ReceiverCompromiseToken( $B, rst ) ]
  --[ CompromiseReceiverState( $B, rst ) ]->
   [
   ReceiverState( $B, rst ), !CompromisedReceiverState( $B, rst ),
   Out( rst )
   ]

  // loop breaker: [0]
  /* has exactly the trivial AC variant */

rule (modulo E) CompromiseActiveReceiverState:
   [ BatchCompromiseToken( $B, bid, rst ) ]
  --[ CompromiseReceiverState( $B, rst ) ]->
   [ !CompromisedReceiverState( $B, rst ), Out( rst ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) CompromiseSenderState:
   [ !SenderState( $A, sst ), SenderCompromiseToken( $A, sst ) ]
  --[ CompromiseSenderState( $A, sst ) ]->
   [ !CompromisedSenderState( $A, sst ), Out( sst ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) ForgedProcessAfterReceiverStateCompromise:
   [
   !BatchSealedFact( $B, bid, rst ),
   PendingSlot( $B, bid, idx, $A, cts_in ),
   !CompromisedReceiverState( $B, rst ), Fr( ~fake_Ks )
   ]
  --[
  BatchSlot( $B, bid, idx, $A, cts_in ),
  BatchSlotAccept( $B, bid, idx, $A, rst, cts_in, ~fake_Ks ),
  ForgedReceiverAccept( $B, $A, rst, cts_in, ~fake_Ks ),
  ReceiverAcceptsComponent( $B, $A, rst, cts_in, ~fake_Ks ),
  ReceiverKey( $B, $A, bid, idx, rst, cts_in, ~fake_Ks,
               rkey($B, $A, rst, cts_in, ~fake_Ks)
  ),
  AttackerKnowsKey( rkey($B, $A, rst, cts_in, ~fake_Ks) ),
  UnpartneredReceiverSlot( $B, $A, bid, idx, rst, cts_in, ~fake_Ks,
                           rkey($B, $A, rst, cts_in, ~fake_Ks)
  ),
  SlotProcessed( $B, bid, idx, $A, cts_in ),
  DoneSlotEvent( $B, bid, idx, $A, cts_in )
  ]->
   [
   DoneSlot( $B, bid, idx, $A, cts_in ),
   Out( rkey($B, $A, rst, cts_in, ~fake_Ks) )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) ForgedProcessAfterSenderStateCompromise:
   [
   !BatchSealedFact( $B, bid, rst ),
   PendingSlot( $B, bid, idx, $A, cts($A, $B, sst, r) ),
   !CompromisedSenderState( $A, sst ), In( r )
   ]
  --[
  BatchSlot( $B, bid, idx, $A, cts($A, $B, sst, r) ),
  BatchSlotAccept( $B, bid, idx, $A, rst, cts($A, $B, sst, r),
                   ks($A, $B, sst, r)
  ),
  ForgedReceiverAccept( $B, $A, rst, cts($A, $B, sst, r),
                        ks($A, $B, sst, r)
  ),
  ReceiverAcceptsComponent( $B, $A, rst, cts($A, $B, sst, r),
                            ks($A, $B, sst, r)
  ),
  ReceiverKey( $B, $A, bid, idx, rst, cts($A, $B, sst, r),
               ks($A, $B, sst, r),
               rkey($B, $A, rst, cts($A, $B, sst, r), ks($A, $B, sst, r))
  ),
  AttackerKnowsKey( rkey($B, $A, rst, cts($A, $B, sst, r),
                         ks($A, $B, sst, r))
  ),
  UnpartneredReceiverSlot( $B, $A, bid, idx, rst, cts($A, $B, sst, r),
                           ks($A, $B, sst, r),
                           rkey($B, $A, rst, cts($A, $B, sst, r), ks($A, $B, sst, r))
  ),
  SlotProcessed( $B, bid, idx, $A, cts($A, $B, sst, r) ),
  DoneSlotEvent( $B, bid, idx, $A, cts($A, $B, sst, r) )
  ]->
   [
   DoneSlot( $B, bid, idx, $A, cts($A, $B, sst, r) ),
   Out( rkey($B, $A, rst, cts($A, $B, sst, r), ks($A, $B, sst, r)) )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) CompleteSealedBatch:
   [ !BatchSealedFact( $B, bid, rst ), BatchEndToken( $B, bid, rst ) ]
  --[
  UseBatchEndToken( $B, bid, rst ), BatchComplete( $B, bid, rst ),
  ConsumeReceiverState( $B, rst )
  ]->
   [ ClosedBatch( $B, bid, rst ), UsedReceiverState( $B, rst ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) FailSealedBatch:
   [
   !BatchSealedFact( $B, bid, rst ), BatchEndToken( $B, bid, rst ),
   PendingSlot( $B, bid, idx, $A, cts_in )
   ]
  --[
  UseBatchEndToken( $B, bid, rst ), BatchSlot( $B, bid, idx, $A, cts_in ),
  BatchSlotFail( $B, bid, idx, $A, rst, cts_in ),
  BatchFail( $B, bid, rst ), ConsumeReceiverState( $B, rst )
  ]->
   [ ClosedBatch( $B, bid, rst ), UsedReceiverState( $B, rst ) ]

  /* has exactly the trivial AC variant */

restriction strict_batch_completion:
