lemma seal_requires_all_slots_added:
  all-traces
  "∀ B bid rst #i.
    (SealBatchEvent( B, bid, rst ) @ #i) ⇒
    ((((∃ idx A c #j.
         (Slot1Added( B, bid, rst, idx, A, c ) @ #j) ∧ (#j < #i)) ∧
       (∃ idx A c #j.
         (Slot2Added( B, bid, rst, idx, A, c ) @ #j) ∧ (#j < #i))) ∧
      (∃ idx A c #j.
        (Slot3Added( B, bid, rst, idx, A, c ) @ #j) ∧ (#j < #i))) ∧
     (∃ idx A c #j. (Slot4Added( B, bid, rst, idx, A, c ) @ #j) ∧ (#j < #i)))"
