lemma normal_distinct_batch_complete:
  exists-trace
  "∃ A B m1 m2 sid1 sid2 k1 k2 bid idx1 idx2 rst #s1 #s2 #p #r1 #r2 #c.
    ((((((((((((((((SenderSession( A, B, m1, sid1, k1 ) @ #s1) ∧
                   (SenderSession( A, B, m2, sid2, k2 ) @ #s2)) ∧
                  (DedupPassed( B, bid, rst, idx1, A, m1, idx2, A, m2 ) @ #p)) ∧
                 (ReceiverAccept( B, A, bid, idx1, rst, m1, sid1, k1 ) @ #r1)) ∧
                (ReceiverAccept( B, A, bid, idx2, rst, m2, sid2, k2 ) @ #r2)) ∧
               (BatchComplete( B, bid, rst ) @ #c)) ∧
              (¬(m1 = m2))) ∧
             (¬(idx1 = idx2))) ∧
            (¬(#r1 = #r2))) ∧
           (#s1 < #p)) ∧
          (#s2 < #p)) ∧
         (#p < #r1)) ∧
        (#p < #r2)) ∧
       (#r1 < #c)) ∧
      (#r2 < #c)) ∧
     (¬(∃ X st #cr. CompromiseReceiverState( X, st ) @ #cr))) ∧
    (¬(∃ X st #cs. CompromiseSenderState( X, st ) @ #cs))"
/*
guarded formula characterizing all satisfying traces:
"∃ A B m1 m2 sid1 sid2 k1 k2 bid idx1 idx2 rst #s1 #s2 #p #r1 #r2 #c.
  (SenderSession( A, B, m1, sid1, k1 ) @ #s1) ∧
  (SenderSession( A, B, m2, sid2, k2 ) @ #s2) ∧
  (DedupPassed( B, bid, rst, idx1, A, m1, idx2, A, m2 ) @ #p) ∧
  (ReceiverAccept( B, A, bid, idx1, rst, m1, sid1, k1 ) @ #r1) ∧
  (ReceiverAccept( B, A, bid, idx2, rst, m2, sid2, k2 ) @ #r2) ∧
  (BatchComplete( B, bid, rst ) @ #c)
 ∧
  (¬(m1 = m2)) ∧
  (¬(idx1 = idx2)) ∧
  (¬(#r1 = #r2)) ∧
  (#s1 < #p) ∧
  (#s2 < #p) ∧
  (#p < #r1) ∧
  (#p < #r2) ∧
  (#r1 < #c) ∧
  (#r2 < #c) ∧
  (∀ X st #cr. (CompromiseReceiverState( X, st ) @ #cr) ⇒ ⊥) ∧
  (∀ X st #cs. (CompromiseSenderState( X, st ) @ #cs) ⇒ ⊥)"
*/
by sorry

lemma normal_distinct_consumer_complete:
  exists-trace
  "∃ A B m1 m2 sid1 sid2 k1 k2 bid idx1 idx2 rst aid1 aid2 h1 h2 #s1 #s2 #p
     #r1 #r2 #c #i1 #i2 #cc.
    (((((((((((((((((((((((((((((((SenderSession( A, B, m1, sid1, k1
                                   ) @ #s1) ∧
                                  (SenderSession( A, B, m2, sid2, k2 ) @ #s2)) ∧
                                 (DedupPassed( B, bid, rst, idx1, A, m1, idx2, A, m2 ) @ #p)) ∧
                                (ReceiverAccept( B, A, bid, idx1, rst, m1, sid1, k1 ) @ #r1)) ∧
                               (AcceptOutputCreated( aid1, B, A, bid, idx1, rst, m1, sid1, k1
                                ) @ #r1)) ∧
                              (ReceiverAccept( B, A, bid, idx2, rst, m2, sid2, k2 ) @ #r2)) ∧
                             (AcceptOutputCreated( aid2, B, A, bid, idx2, rst, m2, sid2, k2
                              ) @ #r2)) ∧
                            (BatchComplete( B, bid, rst ) @ #c)) ∧
                           (ConsumerStarted( B, bid, rst ) @ #c)) ∧
                          (InstallFromAccept( aid1, B, h1, A, bid, idx1, rst, m1, sid1, k1
                           ) @ #i1)) ∧
                         (InstallSession( B, h1, A, sid1, k1 ) @ #i1)) ∧
                        (InstallFromAccept( aid2, B, h2, A, bid, idx2, rst, m2, sid2, k2
                         ) @ #i2)) ∧
                       (InstallSession( B, h2, A, sid2, k2 ) @ #i2)) ∧
                      (ConsumerComplete( B, bid, rst ) @ #cc)) ∧
                     (¬(m1 = m2))) ∧
                    (¬(idx1 = idx2))) ∧
                   (¬(#r1 = #r2))) ∧
                  (¬(aid1 = aid2))) ∧
                 (¬(#i1 = #i2))) ∧
                (¬(h1 = h2))) ∧
               (#s1 < #p)) ∧
              (#s2 < #p)) ∧
             (#p < #r1)) ∧
            (#p < #r2)) ∧
           (#r1 < #c)) ∧
          (#r2 < #c)) ∧
         (#c < #i1)) ∧
        (#c < #i2)) ∧
       (#i1 < #cc)) ∧
      (#i2 < #cc)) ∧
     (¬(∃ X st #cr. CompromiseReceiverState( X, st ) @ #cr))) ∧
    (¬(∃ X st #cs. CompromiseSenderState( X, st ) @ #cs))"
/*
guarded formula characterizing all satisfying traces:
"∃ A B m1 m2 sid1 sid2 k1 k2 bid idx1 idx2 rst aid1 aid2 h1 h2 #s1 #s2 #p
   #r1 #r2 #c #i1 #i2 #cc.
  (SenderSession( A, B, m1, sid1, k1 ) @ #s1) ∧
  (SenderSession( A, B, m2, sid2, k2 ) @ #s2) ∧
  (DedupPassed( B, bid, rst, idx1, A, m1, idx2, A, m2 ) @ #p) ∧
  (ReceiverAccept( B, A, bid, idx1, rst, m1, sid1, k1 ) @ #r1) ∧
  (AcceptOutputCreated( aid1, B, A, bid, idx1, rst, m1, sid1, k1 ) @ #r1) ∧
  (ReceiverAccept( B, A, bid, idx2, rst, m2, sid2, k2 ) @ #r2) ∧
  (AcceptOutputCreated( aid2, B, A, bid, idx2, rst, m2, sid2, k2 ) @ #r2) ∧
  (BatchComplete( B, bid, rst ) @ #c) ∧
  (ConsumerStarted( B, bid, rst ) @ #c) ∧
