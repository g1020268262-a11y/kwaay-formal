lemma install_requires_batch_complete:
  all-traces
  "∀ aid B h A bid idx rst m sid k #i.
    (InstallFromAccept( aid, B, h, A, bid, idx, rst, m, sid, k ) @ #i) ⇒
    (∃ #c. (BatchComplete( B, bid, rst ) @ #c) ∧ (#c < #i))"
/*
guarded formula characterizing all counter-examples:
"∃ aid B h A bid idx rst m sid k #i.
  (InstallFromAccept( aid, B, h, A, bid, idx, rst, m, sid, k ) @ #i)
 ∧
  ∀ #c. (BatchComplete( B, bid, rst ) @ #c) ⇒ ¬(#c < #i)"
*/
simplify
solve( InstallFromAccept( aid, B, h, A, bid, idx, rst, m, sid, k ) @ #i )
  case InstallAcceptedOutputFirst
  solve( ConsumerStage0( $B, bid, rst ) ▶₀ #i )
    case CompleteBatch_case_1
    by contradiction /* from formulas */
  next
    case CompleteBatch_case_2
    by contradiction /* from formulas */
  qed
next
  case InstallAcceptedOutputSecond
  solve( ConsumerStage1( $B, bid, rst, aid1, h1 ) ▶₀ #i )
    case InstallAcceptedOutputFirst_case_1
    by contradiction /* from formulas */
  next
    case InstallAcceptedOutputFirst_case_2
    by contradiction /* from formulas */
  next
    case InstallAcceptedOutputFirst_case_3
    by contradiction /* from formulas */
  next
    case InstallAcceptedOutputFirst_case_4
    by contradiction /* from formulas */
  qed
qed

lemma consumer_complete_requires_all_outputs_installed:
  all-traces
  "∀ aid B A bid idx rst m sid k #r #cc.
    ((AcceptOutputCreated( aid, B, A, bid, idx, rst, m, sid, k ) @ #r) ∧
     (ConsumerComplete( B, bid, rst ) @ #cc)) ⇒
    (∃ h #i.
      ((InstallFromAccept( aid, B, h, A, bid, idx, rst, m, sid, k ) @ #i) ∧
       (#r < #i)) ∧
      (#i < #cc))"
/*
guarded formula characterizing all counter-examples:
"∃ aid B A bid idx rst m sid k #r #cc.
  (AcceptOutputCreated( aid, B, A, bid, idx, rst, m, sid, k ) @ #r) ∧
  (ConsumerComplete( B, bid, rst ) @ #cc)
 ∧
