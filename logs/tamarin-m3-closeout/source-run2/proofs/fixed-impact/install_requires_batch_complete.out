  (¬(h1 = h2)) ∧
  (#s1 < #p) ∧
  (#s2 < #p) ∧
  (#p < #r1) ∧
  (#p < #r2) ∧
  (#r1 < #c) ∧
  (#r2 < #c) ∧
  (#c < #i1) ∧
  (#c < #i2) ∧
  (#i1 < #cc) ∧
  (#i2 < #cc) ∧
  (∀ X st #cr. (CompromiseReceiverState( X, st ) @ #cr) ⇒ ⊥) ∧
