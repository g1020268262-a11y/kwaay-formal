guarded formula characterizing all counter-examples:
"∃ B rst #i #j.
  (ConsumeReceiverState( B, rst ) @ #i) ∧
  (ConsumeReceiverState( B, rst ) @ #j)
 ∧
  ¬(#i = #j)"
*/
by sorry

lemma duplicate_batch_fail_exists:
  exists-trace
  "∃ A B m sid k bid idx1 idx2 rst #s #a1 #a2 #seal #d.
    ((((((((((((((((SenderSession( A, B, m, sid, k ) @ #s) ∧
                   (Slot1Added( B, bid, rst, idx1, A, m ) @ #a1)) ∧
                  (Slot2Added( B, bid, rst, idx2, A, m ) @ #a2)) ∧
                 (SealBatchEvent( B, bid, rst ) @ #seal)) ∧
                (DuplicateDetected( B, bid, rst, idx1, A, idx2, A, m ) @ #d)) ∧
               (UseDedupDecisionToken( B, bid, rst ) @ #d)) ∧
              (BatchFail( B, bid, rst ) @ #d)) ∧
             (BatchClosed( B, bid, rst ) @ #d)) ∧
            (ConsumeReceiverState( B, rst ) @ #d)) ∧
           (¬(idx1 = idx2))) ∧
          (#s < #a1)) ∧
         (#a1 < #a2)) ∧
        (#a2 < #seal)) ∧
       (#seal < #d)) ∧
      (∀ #s2. (SenderSession( A, B, m, sid, k ) @ #s2) ⇒ (#s2 = #s))) ∧
     (¬(∃ X st #cr. CompromiseReceiverState( X, st ) @ #cr))) ∧
    (¬(∃ X st #cs. CompromiseSenderState( X, st ) @ #cs))"
/*
guarded formula characterizing all satisfying traces:
"∃ A B m sid k bid idx1 idx2 rst #s #a1 #a2 #seal #d.
  (SenderSession( A, B, m, sid, k ) @ #s) ∧
  (Slot1Added( B, bid, rst, idx1, A, m ) @ #a1) ∧
  (Slot2Added( B, bid, rst, idx2, A, m ) @ #a2) ∧
  (SealBatchEvent( B, bid, rst ) @ #seal) ∧
  (DuplicateDetected( B, bid, rst, idx1, A, idx2, A, m ) @ #d) ∧
  (UseDedupDecisionToken( B, bid, rst ) @ #d) ∧
  (BatchFail( B, bid, rst ) @ #d) ∧
  (BatchClosed( B, bid, rst ) @ #d) ∧
  (ConsumeReceiverState( B, rst ) @ #d)
 ∧
  (¬(idx1 = idx2)) ∧
  (#s < #a1) ∧
  (#a1 < #a2) ∧
  (#a2 < #seal) ∧
  (#seal < #d) ∧
  (∀ #s2. (SenderSession( A, B, m, sid, k ) @ #s2) ⇒ #s2 = #s) ∧
  (∀ X st #cr. (CompromiseReceiverState( X, st ) @ #cr) ⇒ ⊥) ∧
  (∀ X st #cs. (CompromiseSenderState( X, st ) @ #cs) ⇒ ⊥)"
*/
by sorry

