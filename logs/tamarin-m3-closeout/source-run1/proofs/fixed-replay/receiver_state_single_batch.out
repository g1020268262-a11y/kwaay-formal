lemma process_requires_dedup_pass:
  all-traces
  "∀ B A bid idx rst m sid k #r.
    (ReceiverAccept( B, A, bid, idx, rst, m, sid, k ) @ #r) ⇒
    (∃ idx1 A1 m1 idx2 A2 m2 #p.
