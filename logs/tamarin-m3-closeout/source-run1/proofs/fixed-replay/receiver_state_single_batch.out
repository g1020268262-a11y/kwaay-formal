lemma complete_requires_all_slots_processed:
  all-traces
  "∀ B bid rst idx A m #i #j.
    ((BatchComplete( B, bid, rst ) @ #i) ∧
     (SlotAdded( B, bid, idx, A, m ) @ #j)) ⇒
    (∃ #p.
      ((SlotProcessed( B, bid, idx, A, m ) @ #p) ∧ (#j < #p)) ∧ (#p < #i))"
/*
guarded formula characterizing all counter-examples:
"∃ B bid rst idx A m #i #j.
  (BatchComplete( B, bid, rst ) @ #i) ∧
  (SlotAdded( B, bid, idx, A, m ) @ #j)
 ∧
  ∀ #p.
   (SlotProcessed( B, bid, idx, A, m ) @ #p)
  ⇒
   ((¬(#j < #p)) ∨ (¬(#p < #i)))"
*/
by sorry

