lemma receiver_state_single_batch:
  all-traces
  "∀ B bid1 bid2 rst #i #j.
    ((BatchCreated( B, bid1, rst ) @ #i) ∧
     (BatchCreated( B, bid2, rst ) @ #j)) ⇒
    ((#i = #j) ∧ (bid1 = bid2))"
/*
guarded formula characterizing all counter-examples:
"∃ B bid1 bid2 rst #i #j.
  (BatchCreated( B, bid1, rst ) @ #i) ∧ (BatchCreated( B, bid2, rst ) @ #j)
 ∧
  ((¬(#i = #j)) ∨ (¬(bid1 = bid2)))"
*/
simplify
solve( (¬(#i = #j))  ∥ (¬(~bid = ~bid.1)) )
  case case_1
  solve( (#i < #j)  ∥ (#j < #i) )
    case case_1
    solve( ReceiverState( $B, rst ) ▶₀ #i )
      case CompromiseReceiverState
      solve( ReceiverState( $B, ~rst ) ▶₀ #j )
        case CompromiseReceiverState
        by contradiction /* cyclic */
      next
        case InitReceiverState
        by solve( ReceiverState( $B, ~rst ) ▶₀ #vr )
      qed
    next
      case InitReceiverState
      solve( ReceiverState( $B, ~rst ) ▶₀ #j )
        case CompromiseReceiverState
        by solve( ReceiverState( $B, ~rst ) ▶₀ #vr.1 )
      next
        case InitReceiverState
        by contradiction /* cyclic */
      qed
    qed
  next
    case case_2
    solve( ReceiverState( $B, rst ) ▶₀ #i )
      case CompromiseReceiverState
      solve( ReceiverState( $B, ~rst ) ▶₀ #j )
        case CompromiseReceiverState
        by contradiction /* cyclic */
      next
        case InitReceiverState
        by solve( ReceiverState( $B, ~rst ) ▶₀ #vr )
      qed
    next
      case InitReceiverState
      solve( ReceiverState( $B, ~rst ) ▶₀ #j )
        case CompromiseReceiverState
        by solve( ReceiverState( $B, ~rst ) ▶₀ #vr.1 )
      next
        case InitReceiverState
        by contradiction /* cyclic */
      qed
    qed
  qed
next
  case case_2
  solve( ReceiverState( $B, rst ) ▶₀ #i )
    case CompromiseReceiverState
    solve( ReceiverState( $B, ~rst ) ▶₀ #j )
      case CompromiseReceiverState
      by contradiction /* from formulas */
    next
      case InitReceiverState
      by solve( ReceiverState( $B, ~rst ) ▶₀ #vr )
    qed
  next
    case InitReceiverState
    solve( ReceiverState( $B, ~rst ) ▶₀ #j )
      case CompromiseReceiverState
      by solve( ReceiverState( $B, ~rst ) ▶₀ #vr.1 )
    next
      case InitReceiverState
      by contradiction /* from formulas */
    qed
  qed
qed

lemma receiver_state_single_batch_end:
  all-traces
  "∀ B rst #i #j.
    ((ConsumeReceiverState( B, rst ) @ #i) ∧
     (ConsumeReceiverState( B, rst ) @ #j)) ⇒
    (#i = #j)"
/*
guarded formula characterizing all counter-examples:
"∃ B rst #i #j.
  (ConsumeReceiverState( B, rst ) @ #i) ∧
  (ConsumeReceiverState( B, rst ) @ #j)
 ∧
  ¬(#i = #j)"
*/
simplify
solve( (#i < #j)  ∥ (#j < #i) )
  case case_1
  solve( ConsumeReceiverState( B, rst ) @ #i )
    case CompleteBatch
    solve( SealedStage2( $B, bid, rst ) ▶₀ #i )
      case ProcessSlot2_case_1
      solve( BatchEndToken( $B, ~bid, ~rst ) ▶₁ #i )
        case CreateBatch
        solve( Slot1DoneFact( $B, ~bid, ~rst ) ▶₂ #i )
          case ProcessSlot1
          solve( Slot2DoneFact( $B, ~bid, ~rst ) ▶₃ #i )
            case ProcessSlot2
            solve( ConsumeReceiverState( $B, ~rst ) @ #j )
              case CompleteBatch
              solve( SealedStage2( $B, bid.1, ~rst ) ▶₀ #j )
                case ProcessSlot2_case_1
                by contradiction /* cyclic */
              next
                case ProcessSlot2_case_2
                solve( BatchEndToken( $B, ~bid.1, ~rst ) ▶₁ #j )
                  case CreateBatch
                  solve( Slot1DoneFact( $B, ~bid.1, ~rst ) ▶₂ #j )
                    case ProcessSlot1
                    solve( Slot2DoneFact( $B, ~bid.1, ~rst ) ▶₃ #j )
                      case ProcessSlot2
                      by solve( ReceiverState( $B, ~rst ) ▶₀ #vr.21 )
                    qed
                  qed
                qed
              qed
            next
              case FailSlot1
              solve( SealedStage0( $B, bid.1, ~rst ) ▶₀ #j )
                case SealBatch
                solve( BatchEndToken( $B, ~bid.1, ~rst ) ▶₁ #j )
                  case CreateBatch
                  solve( AddedSlot1( $B, ~bid.1, ~rst, idx, $A, m ) ▶₂ #j )
