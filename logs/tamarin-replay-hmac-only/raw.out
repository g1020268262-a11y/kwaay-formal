                                                                 receiver_pk($B, ~rst),
                                                                 sender_prekey($A, ~sst),
                                                                 receiver_prekey($B, ~rst),
                                                                 <ct_l($A, $B, ~rst, ~rl), 
                                                                  ct_k($A, $B, ~rst, ~rk), 
                                                                  ct_s($A, $B, ~sst, ~rst, ~rs)>)),
                                          hmac(confirm_key(session_key(secret_l($A, $B, ~rst, ~rl),
