lemma injective_confirmed_receiver_accept:
  all-traces
  "∀ A B m sid k tag bid idx1 idx2 rst #s #r1 #r2.
    (((((ConfirmedSend( A, B, m, sid, k, tag ) @ #s) ∧
        (ConfirmedReceiverAccept( B, A, bid, idx1, rst, m, sid, k, tag
         ) @ #r1)) ∧
       (ConfirmedReceiverAccept( B, A, bid, idx2, rst, m, sid, k, tag
        ) @ #r2)) ∧
      (#s < #r1)) ∧
     (#s < #r2)) ⇒
    (#r1 = #r2)"
/*
guarded formula characterizing all counter-examples:
"∃ A B m sid k tag bid idx1 idx2 rst #s #r1 #r2.
  (ConfirmedSend( A, B, m, sid, k, tag ) @ #s) ∧
  (ConfirmedReceiverAccept( B, A, bid, idx1, rst, m, sid, k, tag ) @ #r1) ∧
  (ConfirmedReceiverAccept( B, A, bid, idx2, rst, m, sid, k, tag ) @ #r2)
 ∧
  (#s < #r1) ∧ (#s < #r2) ∧ (¬(#r1 = #r2))"
*/
simplify
solve( (#r1 < #r2)  ∥ (#r2 < #r1) )
  case case_2
  solve( !SenderState( $A, sst ) ▶₀ #s )
    case InitSenderState
    solve( !ReceiverPublicState( $B, rst ) ▶₁ #s )
      case InitReceiverState
      solve( ConfirmedReceiverAccept( $B, $A, bid, idx1, rst.2,
                                      <ct_l($A, $B, ~rst, ~rl), ct_k($A, $B, ~rst, ~rk), 
                                       ct_s($A, $B, ~sst, ~rst, ~rs)>,
                                      session_id($A, $B, sender_pk($A, ~sst), receiver_pk($B, ~rst),
                                                 sender_prekey($A, ~sst), receiver_prekey($B, ~rst),
                                                 <ct_l($A, $B, ~rst, ~rl), ct_k($A, $B, ~rst, ~rk), 
                                                  ct_s($A, $B, ~sst, ~rst, ~rs)>),
                                      session_key(secret_l($A, $B, ~rst, ~rl), secret_k($A, $B, ~rst, ~rk),
                                                  secret_s($A, $B, ~sst, ~rst, ~rs),
                                                  session_id($A, $B, sender_pk($A, ~sst),
                                                             receiver_pk($B, ~rst), sender_prekey($A, ~sst),
                                                             receiver_prekey($B, ~rst),
                                                             <ct_l($A, $B, ~rst, ~rl), 
                                                              ct_k($A, $B, ~rst, ~rk), 
                                                              ct_s($A, $B, ~sst, ~rst, ~rs)>)),
                                      hmac(confirm_key(session_key(secret_l($A, $B, ~rst, ~rl),
                                                                   secret_k($A, $B, ~rst, ~rk),
                                                                   secret_s($A, $B, ~sst, ~rst, ~rs),
                                                                   session_id($A, $B, sender_pk($A, ~sst),
                                                                              receiver_pk($B, ~rst),
                                                                              sender_prekey($A, ~sst),
                                                                              receiver_prekey($B, ~rst),
                                                                              <ct_l($A, $B, ~rst, ~rl), 
                                                                               ct_k($A, $B, ~rst, ~rk), 
                                                                               ct_s($A, $B, ~sst, ~rst, ~rs)
                                                                              >))),
                                           session_id($A, $B, sender_pk($A, ~sst), receiver_pk($B, ~rst),
                                                      sender_prekey($A, ~sst), receiver_prekey($B, ~rst),
                                                      <ct_l($A, $B, ~rst, ~rl), ct_k($A, $B, ~rst, ~rk), 
                                                       ct_s($A, $B, ~sst, ~rst, ~rs)>))
             ) @ #r1 )
        case ProcessSlot2
        solve( SealedStage1( $B, bid, rst ) ▶₀ #r1 )
          case ProcessSlot1_case_1
          solve( AddedSlot2( $B, ~bid, ~rst, idx1, $A,
                             <
                              <ct_l($A, $B, ~rst.1, ~rl), ct_k($A, $B, ~rst.1, ~rk), 
                               ct_s($A, $B, ~sst, ~rst.1, ~rs)>, 
                              hmac(confirm_key(session_key(secret_l($A, $B, ~rst.1, ~rl),
                                                           secret_k($A, $B, ~rst.1, ~rk),
                                                           secret_s($A, $B, ~sst, ~rst.1, ~rs),
                                                           session_id($A, $B, sender_pk($A, ~sst),
                                                                      receiver_pk($B, ~rst.1),
                                                                      sender_prekey($A, ~sst),
                                                                      receiver_prekey($B, ~rst.1),
                                                                      <ct_l($A, $B, ~rst.1, ~rl), 
                                                                       ct_k($A, $B, ~rst.1, ~rk), 
                                                                       ct_s($A, $B, ~sst, ~rst.1, ~rs)>))),
                                   session_id($A, $B, sender_pk($A, ~sst), receiver_pk($B, ~rst.1),
                                              sender_prekey($A, ~sst), receiver_prekey($B, ~rst.1),
                                              <ct_l($A, $B, ~rst.1, ~rl), ct_k($A, $B, ~rst.1, ~rk), 
                                               ct_s($A, $B, ~sst, ~rst.1, ~rs)>))
                             >
                 ) ▶₁ #r1 )
            case AddSlot2
            solve( !HonestSession( $A, $B, ~rst,
                                   <ct_l($A, $B, ~rst.1, ~rl), ct_k($A, $B, ~rst.1, ~rk), 
                                    ct_s($A, $B, ~sst, ~rst.1, ~rs)>,
                                   session_id($A, $B, sender_pk($A, ~sst), receiver_pk($B, ~rst.1),
                                              sender_prekey($A, ~sst), receiver_prekey($B, ~rst.1),
                                              <ct_l($A, $B, ~rst.1, ~rl), ct_k($A, $B, ~rst.1, ~rk), 
                                               ct_s($A, $B, ~sst, ~rst.1, ~rs)>),
                                   session_key(secret_l($A, $B, ~rst.1, ~rl), secret_k($A, $B, ~rst.1, ~rk),
                                               secret_s($A, $B, ~sst, ~rst.1, ~rs),
                                               session_id($A, $B, sender_pk($A, ~sst),
                                                          receiver_pk($B, ~rst.1), sender_prekey($A, ~sst),
                                                          receiver_prekey($B, ~rst.1),
                                                          <ct_l($A, $B, ~rst.1, ~rl), 
                                                           ct_k($A, $B, ~rst.1, ~rk), 
                                                           ct_s($A, $B, ~sst, ~rst.1, ~rs)>))
                   ) ▶₂ #r1 )
              case SenderCreatesConfirmedMessage
              solve( ConfirmedReceiverAccept( $B, $A, ~bid, idx2, ~rst,
                                              <ct_l($A, $B, ~rst, ~rl), ct_k($A, $B, ~rst, ~rk), 
                                               ct_s($A, $B, ~sst, ~rst, ~rs)>,
                                              session_id($A, $B, sender_pk($A, ~sst), receiver_pk($B, ~rst),
                                                         sender_prekey($A, ~sst), receiver_prekey($B, ~rst),
                                                         <ct_l($A, $B, ~rst, ~rl), ct_k($A, $B, ~rst, ~rk), 
                                                          ct_s($A, $B, ~sst, ~rst, ~rs)>),
                                              session_key(secret_l($A, $B, ~rst, ~rl),
                                                          secret_k($A, $B, ~rst, ~rk),
                                                          secret_s($A, $B, ~sst, ~rst, ~rs),
                                                          session_id($A, $B, sender_pk($A, ~sst),
                                                                     receiver_pk($B, ~rst),
                                                                     sender_prekey($A, ~sst),
                                                                     receiver_prekey($B, ~rst),
                                                                     <ct_l($A, $B, ~rst, ~rl), 
                                                                      ct_k($A, $B, ~rst, ~rk), 
                                                                      ct_s($A, $B, ~sst, ~rst, ~rs)>)),
                                              hmac(confirm_key(session_key(secret_l($A, $B, ~rst, ~rl),
                                                                           secret_k($A, $B, ~rst, ~rk),
                                                                           secret_s($A, $B, ~sst, ~rst, ~rs),
                                                                           session_id($A, $B,
                                                                                      sender_pk($A, ~sst),
                                                                                      receiver_pk($B, ~rst),
                                                                                      sender_prekey($A, ~sst),
                                                                                      receiver_prekey($B,
                                                                                                      ~rst),
                                                                                      <
                                                                                       ct_l($A, $B, ~rst,
                                                                                            ~rl), 
                                                                                       ct_k($A, $B, ~rst,
                                                                                            ~rk), 
                                                                                       ct_s($A, $B, ~sst,
                                                                                            ~rst, ~rs)
                                                                                      >))),
                                                   session_id($A, $B, sender_pk($A, ~sst),
                                                              receiver_pk($B, ~rst), sender_prekey($A, ~sst),
                                                              receiver_prekey($B, ~rst),
                                                              <ct_l($A, $B, ~rst, ~rl), 
                                                               ct_k($A, $B, ~rst, ~rk), 
                                                               ct_s($A, $B, ~sst, ~rst, ~rs)>))
                     ) @ #r2 )
                case ProcessSlot1
                solve( SealedStage0( $B, ~bid, ~rst ) ▶₀ #r2 )
                  case SealBatch
                  solve( !KU( ct_l($A, $B, ~rst, ~rl) ) @ #vk.7 )
                    case SenderCreatesConfirmedMessage
                    solve( !KU( ct_k($A, $B, ~rst, ~rk) ) @ #vk.9 )
                      case SenderCreatesConfirmedMessage
                      solve( !KU( ct_s($A, $B, ~sst, ~rst, ~rs) ) @ #vk.10 )
                        case SenderCreatesConfirmedMessage
                        solve( !KU( hmac(confirm_key(session_key(secret_l($A, $B, ~rst, ~rl),
                                                                 secret_k($A, $B, ~rst, ~rk),
                                                                 secret_s($A, $B, ~sst, ~rst, ~rs),
                                                                 session_id($A, $B, sender_pk($A, ~sst),
                                                                            receiver_pk($B, ~rst),
                                                                            sender_prekey($A, ~sst),
                                                                            receiver_prekey($B, ~rst),
                                                                            <ct_l($A, $B, ~rst, ~rl), 
                                                                             ct_k($A, $B, ~rst, ~rk), 
                                                                             ct_s($A, $B, ~sst, ~rst, ~rs)
                                                                            >))),
                                         session_id($A, $B, sender_pk($A, ~sst), receiver_pk($B, ~rst),
                                                    sender_prekey($A, ~sst), receiver_prekey($B, ~rst),
                                                    <ct_l($A, $B, ~rst, ~rl), ct_k($A, $B, ~rst, ~rk), 
                                                     ct_s($A, $B, ~sst, ~rst, ~rs)>))
                               ) @ #vk.10 )
                          case SenderCreatesConfirmedMessage
                          SOLVED // trace found
                        qed
                      qed
                    qed
                  qed
                qed
              qed
            qed
          qed
        qed
      qed
    qed
  qed
qed

lemma slot_indices_distinct:
  all-traces
  "∀ B bid rst idx1 idx2 A1 A2 cm1 cm2 #i #j.
    ((Slot1Added( B, bid, rst, idx1, A1, cm1 ) @ #i) ∧
     (Slot2Added( B, bid, rst, idx2, A2, cm2 ) @ #j)) ⇒
    (¬(idx1 = idx2))"
/*
guarded formula characterizing all counter-examples:
"∃ B bid rst idx1 idx2 A1 A2 cm1 cm2 #i #j.
  (Slot1Added( B, bid, rst, idx1, A1, cm1 ) @ #i) ∧
  (Slot2Added( B, bid, rst, idx2, A2, cm2 ) @ #j)
 ∧
  idx1 = idx2"
*/
by simplify

lemma process_requires_slot_added:
  all-traces
  "∀ B A bid idx rst m sid k tag #i.
    (ConfirmedReceiverAccept( B, A, bid, idx, rst, m, sid, k, tag ) @ #i) ⇒
    (∃ #j. (SlotAdded( B, bid, idx, A, <m, tag> ) @ #j) ∧ (#j < #i))"
/*
guarded formula characterizing all counter-examples:
"∃ B A bid idx rst m sid k tag #i.
  (ConfirmedReceiverAccept( B, A, bid, idx, rst, m, sid, k, tag ) @ #i)
 ∧
  ∀ #j. (SlotAdded( B, bid, idx, A, <m, tag> ) @ #j) ⇒ ¬(#j < #i)"
*/
simplify
solve( ConfirmedReceiverAccept( B, A, bid, idx, rst, m, sid, k, tag
       ) @ #i )
  case ProcessSlot1
  solve( SealedStage0( $B, bid, rst ) ▶₀ #i )
    case SealBatch_case_1
    solve( AddedSlot1( $B, ~bid, ~rst, idx, $A,
                       <m, hmac(confirm_key(k), sid)>
           ) ▶₁ #i )
      case AddSlot1
      by contradiction /* from formulas */
    qed
  next
    case SealBatch_case_2
    solve( AddedSlot1( $B, ~bid, ~rst, idx, $A,
                       <m, hmac(confirm_key(k), sid)>
           ) ▶₁ #i )
      case AddSlot1
      by contradiction /* from formulas */
    qed
  qed
next
  case ProcessSlot2
  solve( SealedStage1( $B, bid, rst ) ▶₀ #i )
    case ProcessSlot1_case_1
    solve( AddedSlot2( $B, ~bid, ~rst, idx, $A,
                       <m, hmac(confirm_key(k), sid)>
           ) ▶₁ #i )
      case AddSlot2
      by contradiction /* from formulas */
    qed
  next
    case ProcessSlot1_case_2
    solve( AddedSlot2( $B, ~bid, ~rst, idx, $A,
                       <m, hmac(confirm_key(k), sid)>
           ) ▶₁ #i )
      case AddSlot2
      by contradiction /* from formulas */
    qed
  qed
qed

lemma process_requires_seal:
  all-traces
  "∀ B A bid idx rst m sid k tag #i.
    (ConfirmedReceiverAccept( B, A, bid, idx, rst, m, sid, k, tag ) @ #i) ⇒
    (∃ #j. (SealBatchEvent( B, bid, rst ) @ #j) ∧ (#j < #i))"
/*
guarded formula characterizing all counter-examples:
"∃ B A bid idx rst m sid k tag #i.
  (ConfirmedReceiverAccept( B, A, bid, idx, rst, m, sid, k, tag ) @ #i)
 ∧
  ∀ #j. (SealBatchEvent( B, bid, rst ) @ #j) ⇒ ¬(#j < #i)"
*/
simplify
solve( ConfirmedReceiverAccept( B, A, bid, idx, rst, m, sid, k, tag
       ) @ #i )
  case ProcessSlot1
  solve( SealedStage0( $B, bid, rst ) ▶₀ #i )
    case SealBatch_case_1
    by contradiction /* from formulas */
  next
    case SealBatch_case_2
    by contradiction /* from formulas */
  qed
next
  case ProcessSlot2
  solve( SealedStage1( $B, bid, rst ) ▶₀ #i )
    case ProcessSlot1_case_1
    by contradiction /* from formulas */
  next
    case ProcessSlot1_case_2
    by contradiction /* from formulas */
  qed
qed

lemma complete_requires_all_slots_processed:
  all-traces
  "∀ B bid rst idx A cm #i #j.
    ((BatchComplete( B, bid, rst ) @ #i) ∧
     (SlotAdded( B, bid, idx, A, cm ) @ #j)) ⇒
    (∃ #p.
      ((SlotProcessed( B, bid, idx, A, cm ) @ #p) ∧ (#j < #p)) ∧ (#p < #i))"
/*
guarded formula characterizing all counter-examples:
"∃ B bid rst idx A cm #i #j.
  (BatchComplete( B, bid, rst ) @ #i) ∧
  (SlotAdded( B, bid, idx, A, cm ) @ #j)
 ∧
  ∀ #p.
   (SlotProcessed( B, bid, idx, A, cm ) @ #p)
  ⇒
   ((¬(#j < #p)) ∨ (¬(#p < #i)))"
*/
simplify
solve( SealedStage2( $B, bid, rst ) ▶₀ #i )
  case ProcessSlot2_case_1
  solve( BatchEndToken( $B, ~bid, ~rst ) ▶₁ #i )
    case CreateBatch
    solve( Slot1DoneFact( $B, ~bid, ~rst ) ▶₂ #i )
      case ProcessSlot1
      solve( Slot2DoneFact( $B, ~bid, ~rst ) ▶₃ #i )
        case ProcessSlot2
        solve( SlotAdded( $B, ~bid, idx.4, A.4, cm ) @ #j )
          case AddSlot1
          solve( OpenStage0( $B, ~bid, rst.1 ) ▶₀ #j )
            case CreateBatch
            by contradiction /* from formulas */
          qed
        next
          case AddSlot2
          solve( OpenStage1( $B, ~bid, rst.1 ) ▶₀ #j )
            case AddSlot1
            by contradiction /* from formulas */
          qed
        qed
      qed
    qed
  qed
next
  case ProcessSlot2_case_2
  solve( BatchEndToken( $B, ~bid, ~rst ) ▶₁ #i )
    case CreateBatch
    solve( Slot1DoneFact( $B, ~bid, ~rst ) ▶₂ #i )
      case ProcessSlot1
      solve( Slot2DoneFact( $B, ~bid, ~rst ) ▶₃ #i )
        case ProcessSlot2
        solve( SlotAdded( $B, ~bid, idx.4, A.4, cm ) @ #j )
          case AddSlot1
          solve( OpenStage0( $B, ~bid, rst.1 ) ▶₀ #j )
            case CreateBatch
            by contradiction /* from formulas */
          qed
        next
          case AddSlot2
          solve( OpenStage1( $B, ~bid, rst.1 ) ▶₀ #j )
            case AddSlot1
            by contradiction /* from formulas */
          qed
        qed
      qed
    qed
  qed
qed

lemma no_add_after_seal:
  all-traces
  "∀ B bid rst idx A cm #i #j.
    ((SealBatchEvent( B, bid, rst ) @ #i) ∧
     (SlotAdded( B, bid, idx, A, cm ) @ #j)) ⇒
    (#j < #i)"
/*
guarded formula characterizing all counter-examples:
"∃ B bid rst idx A cm #i #j.
  (SealBatchEvent( B, bid, rst ) @ #i) ∧
  (SlotAdded( B, bid, idx, A, cm ) @ #j)
 ∧
  ¬(#j < #i)"
*/
simplify
solve( (#j = #i)  ∥ (#i < #j) )
  case case_1
  solve( OpenStage2( $B, bid, rst ) ▶₀ #i )
    case AddSlot2_case_1
    by solve( SlotAdded( $B, ~bid, idx.2, A.2, cm.2 ) @ #i )
  next
    case AddSlot2_case_2
    by solve( SlotAdded( $B, ~bid, idx.2, A.2, cm.2 ) @ #i )
  qed
next
  case case_2
  solve( OpenStage2( $B, bid, rst ) ▶₀ #i )
    case AddSlot2_case_1
    solve( SlotAdded( $B, ~bid, idx.2, A.2, cm.2 ) @ #j )
      case AddSlot1
      solve( OpenStage0( $B, ~bid, rst.1 ) ▶₀ #j )
        case CreateBatch
        by contradiction /* cyclic */
      qed
    next
      case AddSlot2
      solve( OpenStage1( $B, ~bid, rst.1 ) ▶₀ #j )
        case AddSlot1
        by contradiction /* cyclic */
      qed
    qed
  next
    case AddSlot2_case_2
    solve( SlotAdded( $B, ~bid, idx.2, A.2, cm.2 ) @ #j )
      case AddSlot1
      solve( OpenStage0( $B, ~bid, rst.1 ) ▶₀ #j )
        case CreateBatch
        by contradiction /* cyclic */
      qed
    next
      case AddSlot2
      solve( OpenStage1( $B, ~bid, rst.1 ) ▶₀ #j )
        case AddSlot1
        by contradiction /* cyclic */
      qed
    qed
  qed
qed

lemma no_accept_after_close:
  all-traces
  "∀ B A bid idx rst m sid k tag #i #j.
    ((BatchClosed( B, bid, rst ) @ #i) ∧
     (ConfirmedReceiverAccept( B, A, bid, idx, rst, m, sid, k, tag ) @ #j)) ⇒
    (#j < #i)"
/*
guarded formula characterizing all counter-examples:
"∃ B A bid idx rst m sid k tag #i #j.
  (BatchClosed( B, bid, rst ) @ #i) ∧
  (ConfirmedReceiverAccept( B, A, bid, idx, rst, m, sid, k, tag ) @ #j)
 ∧
  ¬(#j < #i)"
*/
simplify
solve( (#j = #i)  ∥ (#i < #j) )
  case case_1
  solve( BatchClosed( B, bid, rst ) @ #i )
    case CompleteBatch
    solve( SealedStage2( $B, bid, rst ) ▶₀ #i )
      case ProcessSlot2_case_1
      solve( BatchEndToken( $B, ~bid, ~rst ) ▶₁ #i )
        case CreateBatch
        solve( Slot1DoneFact( $B, ~bid, ~rst ) ▶₂ #i )
          case ProcessSlot1
          solve( Slot2DoneFact( $B, ~bid, ~rst ) ▶₃ #i )
            case ProcessSlot2
            by solve( ConfirmedReceiverAccept( $B, A.4, ~bid, idx.4, ~rst, m, sid, k,
                                               tag
                      ) @ #i )
          qed
        qed
      qed
    next
      case ProcessSlot2_case_2
      solve( BatchEndToken( $B, ~bid, ~rst ) ▶₁ #i )
        case CreateBatch
        solve( Slot1DoneFact( $B, ~bid, ~rst ) ▶₂ #i )
          case ProcessSlot1
          solve( Slot2DoneFact( $B, ~bid, ~rst ) ▶₃ #i )
            case ProcessSlot2
            by solve( ConfirmedReceiverAccept( $B, A.4, ~bid, idx.4, ~rst, m, sid, k,
                                               tag
                      ) @ #i )
          qed
        qed
      qed
    qed
  next
    case FailSlot1
    solve( SealedStage0( $B, bid, rst ) ▶₀ #i )
      case SealBatch_case_1
      solve( BatchEndToken( $B, ~bid, ~rst ) ▶₁ #i )
        case CreateBatch
        solve( AddedSlot1( $B, ~bid, ~rst, idx, $A, cm ) ▶₂ #i )
          case AddSlot1
          by solve( ConfirmedReceiverAccept( $B, A.3, ~bid, idx.4, ~rst, m, sid, k,
                                             tag
                    ) @ #i )
        qed
      qed
    next
      case SealBatch_case_2
      solve( BatchEndToken( $B, ~bid, ~rst ) ▶₁ #i )
        case CreateBatch
        solve( AddedSlot1( $B, ~bid, ~rst, idx, $A, cm ) ▶₂ #i )
          case AddSlot1
          by solve( ConfirmedReceiverAccept( $B, A.3, ~bid, idx.4, ~rst, m, sid, k,
                                             tag
                    ) @ #i )
        qed
      qed
    qed
  next
    case FailSlot2
    solve( SealedStage1( $B, bid, rst ) ▶₀ #i )
      case ProcessSlot1_case_1
      solve( BatchEndToken( $B, ~bid, ~rst ) ▶₁ #i )
        case CreateBatch
        solve( AddedSlot2( $B, ~bid, ~rst, idx, $A, cm ) ▶₂ #i )
          case AddSlot2
          by solve( ConfirmedReceiverAccept( $B, A.4, ~bid, idx.5, ~rst, m, sid, k,
                                             tag
                    ) @ #i )
        qed
      qed
    next
      case ProcessSlot1_case_2
      solve( BatchEndToken( $B, ~bid, ~rst ) ▶₁ #i )
        case CreateBatch
        solve( AddedSlot2( $B, ~bid, ~rst, idx, $A, cm ) ▶₂ #i )
          case AddSlot2
          by solve( ConfirmedReceiverAccept( $B, A.4, ~bid, idx.5, ~rst, m, sid, k,
                                             tag
                    ) @ #i )
        qed
      qed
    qed
  qed
next
  case case_2
  solve( BatchClosed( B, bid, rst ) @ #i )
    case CompleteBatch
    solve( SealedStage2( $B, bid, rst ) ▶₀ #i )
      case ProcessSlot2_case_1
      solve( BatchEndToken( $B, ~bid, ~rst ) ▶₁ #i )
        case CreateBatch
        solve( Slot1DoneFact( $B, ~bid, ~rst ) ▶₂ #i )
          case ProcessSlot1
          solve( Slot2DoneFact( $B, ~bid, ~rst ) ▶₃ #i )
            case ProcessSlot2
            solve( ConfirmedReceiverAccept( $B, A.4, ~bid, idx.4, ~rst, m, sid, k,
                                            tag
                   ) @ #j )
              case ProcessSlot1
              solve( SealedStage0( $B, ~bid, ~rst ) ▶₀ #j )
                case SealBatch
                by contradiction /* cyclic */
              qed
            next
              case ProcessSlot2
              solve( SealedStage1( $B, ~bid, ~rst ) ▶₀ #j )
                case ProcessSlot1
                by contradiction /* cyclic */
              qed
            qed
          qed
