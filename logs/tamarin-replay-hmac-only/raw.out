                                                                                <ct_l($A.1, $B, ~rst, ~rl.1), 
                                                                                 ct_k($A.1, $B, ~rst, ~rk.1), 
                                                                                 ct_s($A.1, $B, ~sst.1, ~rst,
                                                                                      ~rs.1)
                                                                                >))),
                                             session_id($A.1, $B, sender_pk($A.1, ~sst.1),
                                                        receiver_pk($B, ~rst), sender_prekey($A.1, ~sst.1),
                                                        receiver_prekey($B, ~rst),
                                                        <ct_l($A.1, $B, ~rst, ~rl.1), 
                                                         ct_k($A.1, $B, ~rst, ~rk.1), 
                                                         ct_s($A.1, $B, ~sst.1, ~rst, ~rs.1)>))
                                   ) @ #vk.18 )
                              case SenderCreatesConfirmedMessage
                              solve( !KU( hmac(confirm_key(session_key(secret_l($A, $B, ~rst, ~rl),
                                                                       secret_k($A, $B, ~rst, ~rk),
                                                                       secret_s($A, $B, ~sst, ~rst, ~rs),
                                                                       session_id($A, $B, sender_pk($A, ~sst),
                                                                                  receiver_pk($B, ~rst),
                                                                                  sender_prekey($A, ~sst),
                                                                                  receiver_prekey($B, ~rst),
                                                                                  <ct_l($A, $B, ~rst, ~rl), 
                                                                                   ct_k($A, $B, ~rst, ~rk), 
                                                                                   ct_s($A, $B, ~sst, ~rst,
                                                                                        ~rs)
                                                                                  >))),
                                               session_id($A, $B, sender_pk($A, ~sst), receiver_pk($B, ~rst),
                                                          sender_prekey($A, ~sst), receiver_prekey($B, ~rst),
                                                          <ct_l($A, $B, ~rst, ~rl), ct_k($A, $B, ~rst, ~rk), 
                                                           ct_s($A, $B, ~sst, ~rst, ~rs)>))
                                     ) @ #vk.20 )
                                case SenderCreatesConfirmedMessage
                                SOLVED // trace found
                              qed
                            qed
                          qed
                        qed
                      qed
                    qed
                  qed
                qed
              qed
            qed
          qed
        qed
      qed
    qed
  qed
qed

lemma confirmed_receiver_accept_has_sender:
  all-traces
  "∀ A B m sid k tag bid idx rst #r.
    (ConfirmedReceiverAccept( B, A, bid, idx, rst, m, sid, k, tag ) @ #r) ⇒
    (∃ #s. (ConfirmedSend( A, B, m, sid, k, tag ) @ #s) ∧ (#s < #r))"
/*
guarded formula characterizing all counter-examples:
"∃ A B m sid k tag bid idx rst #r.
  (ConfirmedReceiverAccept( B, A, bid, idx, rst, m, sid, k, tag ) @ #r)
 ∧
  ∀ #s. (ConfirmedSend( A, B, m, sid, k, tag ) @ #s) ⇒ ¬(#s < #r)"
*/
simplify
solve( ConfirmedReceiverAccept( B, A, bid, idx, rst, m, sid, k, tag
       ) @ #r )
  case ProcessSlot1
  solve( SealedStage0( $B, bid, rst ) ▶₀ #r )
    case SealBatch_case_1
    solve( AddedSlot1( $B, ~bid, ~rst, idx, $A,
                       <m, hmac(confirm_key(k), sid)>
           ) ▶₁ #r )
      case AddSlot1
      solve( !HonestSession( $A, $B, ~rst, m, sid, k ) ▶₂ #r )
        case SenderCreatesConfirmedMessage
        by contradiction /* from formulas */
      qed
    qed
  next
    case SealBatch_case_2
    solve( AddedSlot1( $B, ~bid, ~rst, idx, $A,
                       <m, hmac(confirm_key(k), sid)>
           ) ▶₁ #r )
      case AddSlot1
      solve( !HonestSession( $A, $B, ~rst, m, sid, k ) ▶₂ #r )
        case SenderCreatesConfirmedMessage
        by contradiction /* from formulas */
      qed
    qed
  qed
next
  case ProcessSlot2
  solve( SealedStage1( $B, bid, rst ) ▶₀ #r )
    case ProcessSlot1_case_1
    solve( AddedSlot2( $B, ~bid, ~rst, idx, $A,
                       <m, hmac(confirm_key(k), sid)>
           ) ▶₁ #r )
      case AddSlot2
      solve( !HonestSession( $A, $B, ~rst, m, sid, k ) ▶₂ #r )
        case SenderCreatesConfirmedMessage
        by contradiction /* from formulas */
      qed
    qed
  next
    case ProcessSlot1_case_2
    solve( AddedSlot2( $B, ~bid, ~rst, idx, $A,
                       <m, hmac(confirm_key(k), sid)>
           ) ▶₁ #r )
      case AddSlot2
      solve( !HonestSession( $A, $B, ~rst, m, sid, k ) ▶₂ #r )
        case SenderCreatesConfirmedMessage
        by contradiction /* from formulas */
      qed
    qed
  qed
qed

lemma confirmed_message_unique_send:
  all-traces
  "∀ A B m sid k tag #s1 #s2.
    ((ConfirmedSend( A, B, m, sid, k, tag ) @ #s1) ∧
     (ConfirmedSend( A, B, m, sid, k, tag ) @ #s2)) ⇒
    (#s1 = #s2)"
/*
guarded formula characterizing all counter-examples:
"∃ A B m sid k tag #s1 #s2.
  (ConfirmedSend( A, B, m, sid, k, tag ) @ #s1) ∧
  (ConfirmedSend( A, B, m, sid, k, tag ) @ #s2)
 ∧
  ¬(#s1 = #s2)"
*/
simplify
by contradiction /* from formulas */

lemma one_confirmed_send_two_accepts_exists:
  exists-trace
  "∃ A B m sid k tag bid idx1 idx2 rst #s #r1 #r2 #c.
    ((((((((((((ConfirmedSend( A, B, m, sid, k, tag ) @ #s) ∧
               (ConfirmedReceiverAccept( B, A, bid, idx1, rst, m, sid, k, tag
                ) @ #r1)) ∧
              (ConfirmedReceiverAccept( B, A, bid, idx2, rst, m, sid, k, tag
               ) @ #r2)) ∧
             (BatchComplete( B, bid, rst ) @ #c)) ∧
            (¬(idx1 = idx2))) ∧
           (¬(#r1 = #r2))) ∧
          (#s < #r1)) ∧
         (#s < #r2)) ∧
        (#r1 < #c)) ∧
       (#r2 < #c)) ∧
      (∀ #s2. (ConfirmedSend( A, B, m, sid, k, tag ) @ #s2) ⇒ (#s2 = #s))) ∧
     (¬(∃ X st #cr. CompromiseReceiverState( X, st ) @ #cr))) ∧
    (¬(∃ X st #cs. CompromiseSenderState( X, st ) @ #cs))"
/*
guarded formula characterizing all satisfying traces:
"∃ A B m sid k tag bid idx1 idx2 rst #s #r1 #r2 #c.
  (ConfirmedSend( A, B, m, sid, k, tag ) @ #s) ∧
  (ConfirmedReceiverAccept( B, A, bid, idx1, rst, m, sid, k, tag ) @ #r1) ∧
  (ConfirmedReceiverAccept( B, A, bid, idx2, rst, m, sid, k, tag ) @ #r2) ∧
  (BatchComplete( B, bid, rst ) @ #c)
 ∧
  (¬(idx1 = idx2)) ∧
  (¬(#r1 = #r2)) ∧
  (#s < #r1) ∧
  (#s < #r2) ∧
  (#r1 < #c) ∧
  (#r2 < #c) ∧
  (∀ #s2. (ConfirmedSend( A, B, m, sid, k, tag ) @ #s2) ⇒ #s2 = #s) ∧
  (∀ X st #cr. (CompromiseReceiverState( X, st ) @ #cr) ⇒ ⊥) ∧
  (∀ X st #cs. (CompromiseSenderState( X, st ) @ #cs) ⇒ ⊥)"
*/
simplify
solve( (#r1 < #r2)  ∥ (#r2 < #r1) )
  case case_1
  solve( !SenderState( $A, sst ) ▶₀ #s )
    case InitSenderState
    solve( !ReceiverPublicState( $B, rst.1 ) ▶₁ #s )
      case InitReceiverState
      solve( SealedStage2( $B, bid, rst ) ▶₀ #c )
        case ProcessSlot2_case_1
        solve( BatchEndToken( $B, ~bid, ~rst ) ▶₁ #c )
          case CreateBatch
          solve( Slot1DoneFact( $B, ~bid, ~rst ) ▶₂ #c )
            case ProcessSlot1
            solve( Slot2DoneFact( $B, ~bid, ~rst ) ▶₃ #c )
              case ProcessSlot2
              solve( ConfirmedReceiverAccept( $B, $A, ~bid, idx1, ~rst,
                                              <ct_l($A, $B, ~rst.1, ~rl), ct_k($A, $B, ~rst.1, ~rk), 
                                               ct_s($A, $B, ~sst, ~rst.1, ~rs)>,
                                              session_id($A, $B, sender_pk($A, ~sst), receiver_pk($B, ~rst.1),
                                                         sender_prekey($A, ~sst), receiver_prekey($B, ~rst.1),
                                                         <ct_l($A, $B, ~rst.1, ~rl), 
                                                          ct_k($A, $B, ~rst.1, ~rk), 
                                                          ct_s($A, $B, ~sst, ~rst.1, ~rs)>),
                                              session_key(secret_l($A, $B, ~rst.1, ~rl),
                                                          secret_k($A, $B, ~rst.1, ~rk),
                                                          secret_s($A, $B, ~sst, ~rst.1, ~rs),
                                                          session_id($A, $B, sender_pk($A, ~sst),
                                                                     receiver_pk($B, ~rst.1),
                                                                     sender_prekey($A, ~sst),
                                                                     receiver_prekey($B, ~rst.1),
                                                                     <ct_l($A, $B, ~rst.1, ~rl), 
                                                                      ct_k($A, $B, ~rst.1, ~rk), 
                                                                      ct_s($A, $B, ~sst, ~rst.1, ~rs)>)),
                                              hmac(confirm_key(session_key(secret_l($A, $B, ~rst.1, ~rl),
                                                                           secret_k($A, $B, ~rst.1, ~rk),
                                                                           secret_s($A, $B, ~sst, ~rst.1,
                                                                                    ~rs),
                                                                           session_id($A, $B,
                                                                                      sender_pk($A, ~sst),
                                                                                      receiver_pk($B, ~rst.1),
                                                                                      sender_prekey($A, ~sst),
                                                                                      receiver_prekey($B,
                                                                                                      ~rst.1),
                                                                                      <
                                                                                       ct_l($A, $B, ~rst.1,
                                                                                            ~rl), 
                                                                                       ct_k($A, $B, ~rst.1,
                                                                                            ~rk), 
                                                                                       ct_s($A, $B, ~sst,
                                                                                            ~rst.1, ~rs)
                                                                                      >))),
                                                   session_id($A, $B, sender_pk($A, ~sst),
                                                              receiver_pk($B, ~rst.1),
                                                              sender_prekey($A, ~sst),
                                                              receiver_prekey($B, ~rst.1),
                                                              <ct_l($A, $B, ~rst.1, ~rl), 
                                                               ct_k($A, $B, ~rst.1, ~rk), 
                                                               ct_s($A, $B, ~sst, ~rst.1, ~rs)>))
                     ) @ #r1 )
                case ProcessSlot1
                solve( SealedStage0( $B, ~bid, ~rst ) ▶₀ #r1 )
                  case SealBatch
                  solve( ConfirmedReceiverAccept( $B, $A, ~bid, idx2, ~rst,
                                                  <ct_l($A, $B, ~rst, ~rl), ct_k($A, $B, ~rst, ~rk), 
                                                   ct_s($A, $B, ~sst, ~rst, ~rs)>,
                                                  session_id($A, $B, sender_pk($A, ~sst),
                                                             receiver_pk($B, ~rst), sender_prekey($A, ~sst),
                                                             receiver_prekey($B, ~rst),
                                                             <ct_l($A, $B, ~rst, ~rl), 
                                                              ct_k($A, $B, ~rst, ~rk), 
                                                              ct_s($A, $B, ~sst, ~rst, ~rs)>),
                                                  session_key(secret_l($A, $B, ~rst, ~rl),
                                                              secret_k($A, $B, ~rst, ~rk),
                                                              secret_s($A, $B, ~sst, ~rst, ~rs),
                                                              session_id($A, $B, sender_pk($A, ~sst),
                                                                         receiver_pk($B, ~rst),
                                                                         sender_prekey($A, ~sst),
                                                                         receiver_prekey($B, ~rst),
                                                                         <ct_l($A, $B, ~rst, ~rl), 
                                                                          ct_k($A, $B, ~rst, ~rk), 
                                                                          ct_s($A, $B, ~sst, ~rst, ~rs)>)),
                                                  hmac(confirm_key(session_key(secret_l($A, $B, ~rst, ~rl),
                                                                               secret_k($A, $B, ~rst, ~rk),
                                                                               secret_s($A, $B, ~sst, ~rst,
                                                                                        ~rs),
                                                                               session_id($A, $B,
                                                                                          sender_pk($A, ~sst),
                                                                                          receiver_pk($B,
                                                                                                      ~rst),
                                                                                          sender_prekey($A,
                                                                                                        ~sst),
                                                                                          receiver_prekey($B,
                                                                                                          ~rst),
                                                                                          <
                                                                                           ct_l($A, $B, ~rst,
                                                                                                ~rl), 
                                                                                           ct_k($A, $B, ~rst,
                                                                                                ~rk), 
                                                                                           ct_s($A, $B, ~sst,
                                                                                                ~rst, ~rs)
                                                                                          >))),
                                                       session_id($A, $B, sender_pk($A, ~sst),
                                                                  receiver_pk($B, ~rst),
                                                                  sender_prekey($A, ~sst),
                                                                  receiver_prekey($B, ~rst),
                                                                  <ct_l($A, $B, ~rst, ~rl), 
                                                                   ct_k($A, $B, ~rst, ~rk), 
                                                                   ct_s($A, $B, ~sst, ~rst, ~rs)>))
                         ) @ #r2 )
                    case ProcessSlot2
                    solve( SealedStage1( $B, ~bid, ~rst ) ▶₀ #r2 )
                      case ProcessSlot1
                      solve( !KU( ct_l($A, $B, ~rst, ~rl) ) @ #vk.7 )
                        case SenderCreatesConfirmedMessage
                        solve( !KU( ct_k($A, $B, ~rst, ~rk) ) @ #vk.9 )
                          case SenderCreatesConfirmedMessage
                          solve( !KU( ct_s($A, $B, ~sst, ~rst, ~rs) ) @ #vk.10 )
                            case SenderCreatesConfirmedMessage
                            solve( !KU( hmac(confirm_key(session_key(secret_l($A, $B, ~rst, ~rl),
                                                                     secret_k($A, $B, ~rst, ~rk),
                                                                     secret_s($A, $B, ~sst, ~rst, ~rs),
                                                                     session_id($A, $B, sender_pk($A, ~sst),
                                                                                receiver_pk($B, ~rst),
                                                                                sender_prekey($A, ~sst),
                                                                                receiver_prekey($B, ~rst),
                                                                                <ct_l($A, $B, ~rst, ~rl), 
                                                                                 ct_k($A, $B, ~rst, ~rk), 
                                                                                 ct_s($A, $B, ~sst, ~rst, ~rs)
                                                                                >))),
                                             session_id($A, $B, sender_pk($A, ~sst), receiver_pk($B, ~rst),
                                                        sender_prekey($A, ~sst), receiver_prekey($B, ~rst),
                                                        <ct_l($A, $B, ~rst, ~rl), ct_k($A, $B, ~rst, ~rk), 
                                                         ct_s($A, $B, ~sst, ~rst, ~rs)>))
                                   ) @ #vk.10 )
                              case SenderCreatesConfirmedMessage
                              SOLVED // trace found
                            qed
                          qed
                        qed
                      qed
                    qed
                  qed
                qed
              qed
            qed
          qed
        qed
      qed
    qed
  qed
qed

