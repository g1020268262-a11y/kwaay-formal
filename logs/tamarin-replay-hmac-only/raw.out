lemma receiver_state_single_batch:
  all-traces
  "∀ B bid1 bid2 rst #i #j.
    ((BatchCreated( B, bid1, rst ) @ #i) ∧
     (BatchCreated( B, bid2, rst ) @ #j)) ⇒
    ((#i = #j) ∧ (bid1 = bid2))"
/*
guarded formula characterizing all counter-examples:
"∃ B bid1 bid2 rst #i #j.
  (BatchCreated( B, bid1, rst ) @ #i) ∧ (BatchCreated( B, bid2, rst ) @ #j)
 ∧
  ((¬(#i = #j)) ∨ (¬(bid1 = bid2)))"
*/
simplify
solve( (¬(#i = #j))  ∥ (¬(~bid = ~bid.1)) )
  case case_1
  solve( (#i < #j)  ∥ (#j < #i) )
    case case_1
    solve( ReceiverState( $B, rst ) ▶₀ #i )
      case CompromiseReceiverState
      solve( ReceiverState( $B, ~rst ) ▶₀ #j )
        case CompromiseReceiverState
        by contradiction /* cyclic */
      next
        case InitReceiverState
        by solve( ReceiverState( $B, ~rst ) ▶₀ #vr )
      qed
    next
      case InitReceiverState
      solve( ReceiverState( $B, ~rst ) ▶₀ #j )
        case CompromiseReceiverState
        by solve( ReceiverState( $B, ~rst ) ▶₀ #vr.1 )
      next
        case InitReceiverState
        by contradiction /* cyclic */
      qed
    qed
  next
    case case_2
    solve( ReceiverState( $B, rst ) ▶₀ #i )
      case CompromiseReceiverState
      solve( ReceiverState( $B, ~rst ) ▶₀ #j )
        case CompromiseReceiverState
        by contradiction /* cyclic */
      next
        case InitReceiverState
        by solve( ReceiverState( $B, ~rst ) ▶₀ #vr )
      qed
    next
      case InitReceiverState
      solve( ReceiverState( $B, ~rst ) ▶₀ #j )
        case CompromiseReceiverState
        by solve( ReceiverState( $B, ~rst ) ▶₀ #vr.1 )
      next
        case InitReceiverState
        by contradiction /* cyclic */
      qed
    qed
  qed
next
  case case_2
  solve( ReceiverState( $B, rst ) ▶₀ #i )
    case CompromiseReceiverState
    solve( ReceiverState( $B, ~rst ) ▶₀ #j )
      case CompromiseReceiverState
      by contradiction /* from formulas */
    next
      case InitReceiverState
      by solve( ReceiverState( $B, ~rst ) ▶₀ #vr )
    qed
  next
    case InitReceiverState
    solve( ReceiverState( $B, ~rst ) ▶₀ #j )
      case CompromiseReceiverState
      by solve( ReceiverState( $B, ~rst ) ▶₀ #vr.1 )
    next
      case InitReceiverState
      by contradiction /* from formulas */
    qed
  qed
qed

