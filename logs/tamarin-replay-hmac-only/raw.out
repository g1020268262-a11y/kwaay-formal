                                                                       session_id($A, $B, sender_pk($A, ~sst),
                                                                                  receiver_pk($B, ~rst),
                                                                                  sender_prekey($A, ~sst),
                                                                                  receiver_prekey($B, ~rst),
                                                                                  <ct_l($A, $B, ~rst, ~rl), 
                                                                                   ct_k($A, $B, ~rst, ~rk), 
                                                                                   ct_s($A, $B, ~sst, ~rst,
                                                                                        ~rs)
                                                                                  >))),
                                               session_id($A, $B, sender_pk($A, ~sst), receiver_pk($B, ~rst),
                                                          sender_prekey($A, ~sst), receiver_prekey($B, ~rst),
                                                          <ct_l($A, $B, ~rst, ~rl), ct_k($A, $B, ~rst, ~rk), 
                                                           ct_s($A, $B, ~sst, ~rst, ~rs)>))
                 ) @ #r2 )
            case ProcessSlot2
            solve( SealedStage1( $B, ~bid, ~rst ) ▶₀ #r2 )
              case ProcessSlot1
              solve( AddedSlot2( $B, ~bid, ~rst, idx2, $A,
                                 <
                                  <ct_l($A, $B, ~rst, ~rl), ct_k($A, $B, ~rst, ~rk), 
                                   ct_s($A, $B, ~sst, ~rst, ~rs)>, 
                                  hmac(confirm_key(session_key(secret_l($A, $B, ~rst, ~rl),
                                                               secret_k($A, $B, ~rst, ~rk),
