simplify
solve( !HonestSender( $A, pkA, senderPrekeyA ) ▶₀ #i )
  case RegisterHonestSender
  solve( !MaliciousReceiver( $B, pkB, kemPkB, receiverEpkB, rpre ) ▶₁ #i )
    case RegisterMaliciousReceiverWithPoK
    solve( !ExtractedReceiverSk( $B,
