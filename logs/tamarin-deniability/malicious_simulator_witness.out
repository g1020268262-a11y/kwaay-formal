rule (modulo E) RegisterHonestSender:
   [ Fr( ~sigSkA ), Fr( ~kemSkA ), Fr( ~senderSkA ) ]
  --[
  HonestSenderRegistered( $A, pk(spk(~sigSkA), kpk(~kemSkA)),
                          sender_prekey(skem_spk(~senderSkA),
                                        sign(~sigSkA, sender_payload(skem_spk(~senderSkA))))
  )
  ]->
   [
   !HonestSender( $A, pk(spk(~sigSkA), kpk(~kemSkA)),
                  sender_prekey(skem_spk(~senderSkA),
                                sign(~sigSkA, sender_payload(skem_spk(~senderSkA))))
   ),
   Out( pk(spk(~sigSkA), kpk(~kemSkA)) ),
   Out( sender_prekey(skem_spk(~senderSkA),
                      sign(~sigSkA, sender_payload(skem_spk(~senderSkA))))
   )
   ]

rule (modulo E) RegisterMaliciousReceiverWithPoK:
   [
   Fr( ~sigSkB ), Fr( ~kemSkB ), Fr( ~receiverEskB ),
   In( <$B, receiverSkB, pok(receiverSkB)> )
   ]
  --[
  MaliciousReceiverRegistered( $B, pk(spk(~sigSkB), kpk(~kemSkB)),
                               receiver_prekey(skem_rpk(receiverSkB), ekpk(~receiverEskB),
                                               sign(~sigSkB,
                                                    receiver_payload(skem_rpk(receiverSkB),
                                                                     ekpk(~receiverEskB))))
  ),
  ExtractedWitness( $B,
                    receiver_prekey(skem_rpk(receiverSkB), ekpk(~receiverEskB),
                                    sign(~sigSkB,
                                         receiver_payload(skem_rpk(receiverSkB), ekpk(~receiverEskB)))),
                    receiverSkB
  )
  ]->
   [
   !MaliciousReceiver( $B, pk(spk(~sigSkB), kpk(~kemSkB)), kpk(~kemSkB),
                       ekpk(~receiverEskB),
                       receiver_prekey(skem_rpk(receiverSkB), ekpk(~receiverEskB),
                                       sign(~sigSkB,
                                            receiver_payload(skem_rpk(receiverSkB), ekpk(~receiverEskB))))
   ),
   !ExtractedReceiverSk( $B,
                         receiver_prekey(skem_rpk(receiverSkB), ekpk(~receiverEskB),
                                         sign(~sigSkB,
                                              receiver_payload(skem_rpk(receiverSkB), ekpk(~receiverEskB)))),
                         receiverSkB
   ),
   Out( pk(spk(~sigSkB), kpk(~kemSkB)) ),
   Out( receiver_prekey(skem_rpk(receiverSkB), ekpk(~receiverEskB),
                        sign(~sigSkB,
                             receiver_payload(skem_rpk(receiverSkB), ekpk(~receiverEskB))))
   )
   ]

