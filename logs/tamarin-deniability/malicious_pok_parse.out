lemma registered_malicious_receiver_has_extracted_witness [right]:
  all-traces
  "∀ B pkB rpre #i.
    (MaliciousReceiverRegistered( B, pkB, rpre ) @ #i) ⇒
    (∃ receiverSk #j.
      (ExtractedWitness( B, rpre, receiverSk ) @ #j) ∧ (#j = #i))"
