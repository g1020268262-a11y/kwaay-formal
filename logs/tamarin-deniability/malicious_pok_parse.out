[Theory Kwaay_Deniability_Malicious_PoK_Diff] Theory loaded
theory Kwaay_Deniability_Malicious_PoK_Diff

begin

// Function signature and definition of the equational theory E

functions: ekem_ct/2, ekpk/1, fst/1, h/1, kpk/1, lkem_ct/2, pair/2, pk/2,
           pok/1, receiver_payload/2, receiver_prekey/3, sender_payload/1,
           sender_prekey/2, sid_of/7, sign/2, skem_component/3, skem_rpk/1,
           skem_spk/1, snd/1, spk/1
equations: fst(<x.1, x.2>) = x.1, snd(<x.1, x.2>) = x.2

rule (modulo E) RegisterHonestSender:
   [ Fr( ~sigSkA ), Fr( ~kemSkA ), Fr( ~senderSkA ) ]
  --[
  HonestSenderRegistered( $A, pk(spk(~sigSkA), kpk(~kemSkA)),
                          sender_prekey(skem_spk(~senderSkA),
                                        sign(~sigSkA, sender_payload(skem_spk(~senderSkA))))
  )
  ]->
   [
   !HonestSender( $A, pk(spk(~sigSkA), kpk(~kemSkA)),
                  sender_prekey(skem_spk(~senderSkA),
                                sign(~sigSkA, sender_payload(skem_spk(~senderSkA))))
   ),
   Out( pk(spk(~sigSkA), kpk(~kemSkA)) ),
   Out( sender_prekey(skem_spk(~senderSkA),
                      sign(~sigSkA, sender_payload(skem_spk(~senderSkA))))
   )
   ]

rule (modulo E) RegisterMaliciousReceiverWithPoK:
   [
   Fr( ~sigSkB ), Fr( ~kemSkB ), Fr( ~receiverEskB ),
   In( <$B, receiverSkB, pok(receiverSkB)> )
   ]
  --[
  MaliciousReceiverRegistered( $B, pk(spk(~sigSkB), kpk(~kemSkB)),
                               receiver_prekey(skem_rpk(receiverSkB), ekpk(~receiverEskB),
                                               sign(~sigSkB,
                                                    receiver_payload(skem_rpk(receiverSkB),
                                                                     ekpk(~receiverEskB))))
  ),
  ExtractedWitness( $B,
                    receiver_prekey(skem_rpk(receiverSkB), ekpk(~receiverEskB),
                                    sign(~sigSkB,
                                         receiver_payload(skem_rpk(receiverSkB), ekpk(~receiverEskB)))),
                    receiverSkB
  )
  ]->
   [
   !MaliciousReceiver( $B, pk(spk(~sigSkB), kpk(~kemSkB)), kpk(~kemSkB),
                       ekpk(~receiverEskB),
                       receiver_prekey(skem_rpk(receiverSkB), ekpk(~receiverEskB),
                                       sign(~sigSkB,
                                            receiver_payload(skem_rpk(receiverSkB), ekpk(~receiverEskB))))
   ),
   !ExtractedReceiverSk( $B,
                         receiver_prekey(skem_rpk(receiverSkB), ekpk(~receiverEskB),
                                         sign(~sigSkB,
                                              receiver_payload(skem_rpk(receiverSkB), ekpk(~receiverEskB)))),
                         receiverSkB
   ),
   Out( pk(spk(~sigSkB), kpk(~kemSkB)) ),
   Out( receiver_prekey(skem_rpk(receiverSkB), ekpk(~receiverEskB),
                        sign(~sigSkB,
                             receiver_payload(skem_rpk(receiverSkB), ekpk(~receiverEskB))))
   )
   ]

rule (modulo E) MaliciousPoKTranscript_Diff:
   [
   !HonestSender( $A, pkA, senderPrekeyA ),
   !MaliciousReceiver( $B, pkB, kemPkB, receiverEpkB, receiverPrekeyB ),
   !ExtractedReceiverSk( $B, receiverPrekeyB, receiverSkB ), Fr( ~rhoL ),
   Fr( ~rhoK ), Fr( ~rhoS )
   ]
  --[
  MaliciousPoKRealTranscript( $A, $B,
                              <$A, $B, pkA, pkB, senderPrekeyA, receiverPrekeyB, 
                               <lkem_ct(kemPkB, ~rhoL), ekem_ct(receiverEpkB, ~rhoK), 
                                skem_component(senderPrekeyA, receiverPrekeyB, ~rhoS)>, 
                               sid_of($A, $B, pkA, pkB, senderPrekeyA, receiverPrekeyB,
                                      <lkem_ct(kemPkB, ~rhoL), ekem_ct(receiverEpkB, ~rhoK), 
                                       skem_component(senderPrekeyA, receiverPrekeyB, ~rhoS)>)
                              >,
                              sid_of($A, $B, pkA, pkB, senderPrekeyA, receiverPrekeyB,
                                     <lkem_ct(kemPkB, ~rhoL), ekem_ct(receiverEpkB, ~rhoK), 
                                      skem_component(senderPrekeyA, receiverPrekeyB, ~rhoS)>)
  ),
  MaliciousPoKSimulatedTranscript( $A, $B,
                                   <$A, $B, pkA, pkB, senderPrekeyA, receiverPrekeyB, 
                                    <lkem_ct(kemPkB, ~rhoL), ekem_ct(receiverEpkB, ~rhoK), 
                                     skem_component(senderPrekeyA, receiverPrekeyB, ~rhoS)>, 
                                    sid_of($A, $B, pkA, pkB, senderPrekeyA, receiverPrekeyB,
                                           <lkem_ct(kemPkB, ~rhoL), ekem_ct(receiverEpkB, ~rhoK), 
                                            skem_component(senderPrekeyA, receiverPrekeyB, ~rhoS)>)
                                   >,
                                   sid_of($A, $B, pkA, pkB, senderPrekeyA, receiverPrekeyB,
                                          <lkem_ct(kemPkB, ~rhoL), ekem_ct(receiverEpkB, ~rhoK), 
                                           skem_component(senderPrekeyA, receiverPrekeyB, ~rhoS)>)
  ),
  SimulatorUsesExtractedWitness( $B, receiverPrekeyB, receiverSkB ),
  JudgeViewReceiverOpen( $A, $B )
  ]->
   [
   Out( diff(<$A, $B, pkA, pkB, senderPrekeyA, receiverPrekeyB, 
              <lkem_ct(kemPkB, ~rhoL), ekem_ct(receiverEpkB, ~rhoK), 
               skem_component(senderPrekeyA, receiverPrekeyB, ~rhoS)>, 
              sid_of($A, $B, pkA, pkB, senderPrekeyA, receiverPrekeyB,
                     <lkem_ct(kemPkB, ~rhoL), ekem_ct(receiverEpkB, ~rhoK), 
                      skem_component(senderPrekeyA, receiverPrekeyB, ~rhoS)>)
             >, <$A, $B, pkA, pkB, senderPrekeyA, receiverPrekeyB, 
                 <lkem_ct(kemPkB, ~rhoL), ekem_ct(receiverEpkB, ~rhoK), 
                  skem_component(senderPrekeyA, receiverPrekeyB, ~rhoS)>, 
                 sid_of($A, $B, pkA, pkB, senderPrekeyA, receiverPrekeyB,
                        <lkem_ct(kemPkB, ~rhoL), ekem_ct(receiverEpkB, ~rhoK), 
                         skem_component(senderPrekeyA, receiverPrekeyB, ~rhoS)>)
                >)
   ),
   Out( diff(sid_of($A, $B, pkA, pkB, senderPrekeyA, receiverPrekeyB,
                    <lkem_ct(kemPkB, ~rhoL), ekem_ct(receiverEpkB, ~rhoK), 
                     skem_component(senderPrekeyA, receiverPrekeyB, ~rhoS)>), sid_of($A, $B,
                                                                                     pkA, pkB, senderPrekeyA,
                                                                                     receiverPrekeyB,
                                                                                     <lkem_ct(kemPkB, ~rhoL), 
                                                                                      ekem_ct(receiverEpkB,
                                                                                              ~rhoK), 
                                                                                      skem_component(senderPrekeyA,
                                                                                                     receiverPrekeyB,
                                                                                                     ~rhoS)
                                                                                     >))
   )
   ]

