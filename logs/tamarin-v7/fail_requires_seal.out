  PartneredSlot( $A, $B, bid, idx, rst, cts_in, Ks ),
  SlotProcessed( $B, bid, idx, $A, cts_in ), Slot2Done( $B, bid, rst )
  ]->
   [ SealedStage2( $B, bid, rst ), Slot2DoneFact( $B, bid, rst ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) ProcessSlot3:
   [
   SealedStage2( $B, bid, rst ),
   AddedSlot3( $B, bid, rst, idx, $A, cts_in ),
   !ComponentKey( $A, $B, rst, cts_in, Ks )
