theory Kwaay_SplitKem_Batch_Dynamic_V7

begin

// Function signature and definition of the equational theory E

functions: cts/4[private,constructor], fst/1, ks/4[private,constructor],
           pair/2, rkey/5[private,constructor], snd/1
equations: fst(<x.1, x.2>) = x.1, snd(<x.1, x.2>) = x.2

rule (modulo E) InitReceiverState:
   [ Fr( ~rst ) ]
  --[ ReceiverStateCreated( $B, ~rst ) ]->
   [
   ReceiverState( $B, ~rst ), !ReceiverPublicState( $B, ~rst ),
   ReceiverCompromiseToken( $B, ~rst )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) InitSenderState:
   [ Fr( ~sst ) ]
  --[ SenderStateCreated( $A, ~sst ) ]->
   [ !SenderState( $A, ~sst ), SenderCompromiseToken( $A, ~sst ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) SenderCreatesComponent:
   [ !SenderState( $A, sst ), !ReceiverPublicState( $B, rst ), Fr( ~r ) ]
  --[
  SenderComponent( $A, $B, rst, cts($A, $B, sst, ~r), ks($A, $B, sst, ~r) )
  ]->
   [
   Out( <$A, $B, cts($A, $B, sst, ~r)> ),
   !ComponentKey( $A, $B, rst, cts($A, $B, sst, ~r), ks($A, $B, sst, ~r) )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) CreateBatch:
   [ ReceiverState( $B, rst ), Fr( ~bid ) ]
  --[ BatchCreated( $B, ~bid, rst ) ]->
   [
   OpenStage0( $B, ~bid, rst ), BatchEndToken( $B, ~bid, rst ),
   BatchCompromiseToken( $B, ~bid, rst )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) AddSlot1:
   [ OpenStage0( $B, bid, rst ), In( <$A, $B, cts_in> ), Fr( ~idx ) ]
  --[
  SlotAdded( $B, bid, ~idx, $A, cts_in ),
  Slot1Added( $B, bid, rst, ~idx, $A, cts_in )
  ]->
   [
   OpenStage1( $B, bid, rst ), AddedSlot1( $B, bid, rst, ~idx, $A, cts_in )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) AddSlot2:
   [ OpenStage1( $B, bid, rst ), In( <$A, $B, cts_in> ), Fr( ~idx ) ]
  --[
  SlotAdded( $B, bid, ~idx, $A, cts_in ),
  Slot2Added( $B, bid, rst, ~idx, $A, cts_in )
  ]->
   [
   OpenStage2( $B, bid, rst ), AddedSlot2( $B, bid, rst, ~idx, $A, cts_in )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) AddSlot3:
   [ OpenStage2( $B, bid, rst ), In( <$A, $B, cts_in> ), Fr( ~idx ) ]
  --[
  SlotAdded( $B, bid, ~idx, $A, cts_in ),
  Slot3Added( $B, bid, rst, ~idx, $A, cts_in )
  ]->
   [
   OpenStage3( $B, bid, rst ), AddedSlot3( $B, bid, rst, ~idx, $A, cts_in )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) AddSlot4:
   [ OpenStage3( $B, bid, rst ), In( <$A, $B, cts_in> ), Fr( ~idx ) ]
  --[
  SlotAdded( $B, bid, ~idx, $A, cts_in ),
  Slot4Added( $B, bid, rst, ~idx, $A, cts_in )
  ]->
   [
   OpenStage4( $B, bid, rst ), AddedSlot4( $B, bid, rst, ~idx, $A, cts_in )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) SealBatch:
   [ OpenStage4( $B, bid, rst ) ]
  --[ SealBatchEvent( $B, bid, rst ) ]->
   [ SealedStage0( $B, bid, rst ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) ProcessSlot1:
   [
   SealedStage0( $B, bid, rst ),
   AddedSlot1( $B, bid, rst, idx, $A, cts_in ),
   !ComponentKey( $A, $B, rst, cts_in, Ks )
   ]
  --[
  BatchSlot( $B, bid, idx, $A, cts_in ),
  BatchSlotAccept( $B, bid, idx, $A, rst, cts_in, Ks ),
  ReceiverAcceptsComponent( $B, $A, rst, cts_in, Ks ),
  ReceiverKey( $B, $A, bid, idx, rst, cts_in, Ks,
               rkey($B, $A, rst, cts_in, Ks)
  ),
  PartneredSlot( $A, $B, bid, idx, rst, cts_in, Ks ),
  SlotProcessed( $B, bid, idx, $A, cts_in ), Slot1Done( $B, bid, rst )
  ]->
   [ SealedStage1( $B, bid, rst ), Slot1DoneFact( $B, bid, rst ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) ProcessSlot2:
   [
   SealedStage1( $B, bid, rst ),
   AddedSlot2( $B, bid, rst, idx, $A, cts_in ),
   !ComponentKey( $A, $B, rst, cts_in, Ks )
